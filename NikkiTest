export class DmsTestCheckInformationComponent extends BaseComponent implements OnInit {
  @Input() testCheckInformation: PreApprovalTestCheckInformation | undefined | null;
  @Input() designeeTypeId: number | undefined | null = 0;
  @Input() form: FormGroup | AbstractControl | undefined | null;
  @Input() formSubmitted = false;
