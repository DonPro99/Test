@if (afsPostActivityGroup2 != null && form != null) {
  <div id="dpeSaePostActivity" [formGroup]="$any(form)">
    @if (showRetestQuestion && isVersionComparision === false) {
      <dms-radio-button identity="id_grp2postact_pradio_isAdditionalInstructionsProvided"
        formControlName="isAdditionalInstructionsProvided"
        label="Was additional instruction provided for a retest?"
        [radioValues]="[{ label: 'Yes', value: true }, { label: 'No', value: false }]">
      </dms-radio-button>
    }
    @if (showRetestQuestion && isVersionComparision === true) {
      <dms-radio-button
        identity="id_grp2postact_radio_isVersionComparision" label="Was additional instruction provided for a retest?"
        [disabled]="true" [radioValues]="[{ label: 'Yes', value: true }, { label: 'No', value: false }]"
      [value]="afsPostActivityGroup2.isAdditionalInstructionsProvided"></dms-radio-button>
    }
    @if (form.get('isAdditionalInstructionsProvided')?.value === true && isSae && !isAdministrativePreapproval && showRetestQuestion) {
      <dms-input-textbox type="text" identity="id_grp2postact_input_airManName"
        label="Name of airman that provided the additional instructions" formControlName="airManName" />
    }
    @if (form.get('isAdditionalInstructionsProvided')?.value === true && isSae && !isAdministrativePreapproval && showRetestQuestion) {
      <dms-input-textbox identity="id_grp2postact_input_certificateNumber" type="text"
        label="Certificate number of the airman that provided the additional instruction"
        formControlName="certificateNumber" />
    }
    @if (form.get('isAdditionalInstructionsProvided')?.value === true && isDpe && !isAdministrativePreapproval && showRetestQuestion) {
      <dms-input-textbox identity="id_grp2postact_input_flightInstructorName" type="text"
        label="Flight Instructor Name" formControlName="flightInstructorName" />
    }
    @if (form.get('isAdditionalInstructionsProvided')?.value === true && isDpe && !isAdministrativePreapproval && showRetestQuestion) {
      <dms-input-textbox type="text" identity="id_grp2postact_input_flightInstructorcertificateNumber"
        formControlName="flightInstructorcertificateNumber" label="Flight Instructor Certificate number" />
    }
    @if ((isDpe || isSae) && !isSmtfSelected && !isAdministrativePreapproval) {
      <dms-dropdown id="id_grp2postact_testchkinfo_pdd_practicalOralTestId"
        identity="id_g2p_testchkinfo_ipdd_practicalOralTestId" [options]="practicalTypes"
        formControlName="practicalOralTestId"
        placeholder="Select a Type of Test" label="Type of Practical Test or Check"
        [doSpotLight]="(!isExternal && markAsModified(modifiedTestInfoControls, 'practicalOralTestId').borderRed)">
      </dms-dropdown>
    }
    @if ((isDpe || isSae) && isProficiencyCheck && !isAdministrativePreapproval) {
      <dms-dropdown identity="id_grp2postact_pdd_proficiencyCheck"
        label="Result of the Proficiency Check"
      [options]="resultsOfProfCheck" formControlName="proficiencyCheck" placeholder="Select a Type"></dms-dropdown>
    }
    @if ((isDpe || isSae) && !isProficiencyCheck && !isAdministrativePreapproval) {
      <dms-dropdown identity="id_grp2postact_pdd_practicalTest"
        [options]="resultsOfPracticalTest" formControlName="practicalTest" label="Result of the Practical Test"
      placeholder="Select a Type"></dms-dropdown>
    }
    @if (showGradeOfCertificate()) {
      <dms-dropdown identity="id_grp2postact_pdd_gradeOfCertificate"
        label="Grade of Certificate"  [options]="gradesOfCertificate"
      formControlName="gradeOfCertificate" placeholder="Select Certificate"></dms-dropdown>
    }
    @if (showAircraftCategory() && aircraftCategories != null) {
      <dms-dropdown identity="id_grp2postact_pdd_airCraftCatergory"
        label="Aircraft Category"
        [options]="aircraftCategories" formControlName="airCraftCatergory" placeholder="Select an aircraft category"
      (changeEvent)="clearAirCraftClass()"></dms-dropdown>
    }
    @if (showAircraftClass() && aircraftClasses != null) {
      <dms-dropdown identity="id_grp2postact_pdd_airCraftClass" label="Aircraft Class"
        [options]="aircraftClasses"
      formControlName="airCraftClass" placeholder="Select an aircraft class"></dms-dropdown>
    }
    @if (isAdministrativePreapproval) {
      <dms-check-box-binary identity="id_grp2postact_pdd_isAirManCertificateNotIssue"
        [hideValidationPlaceHolder]="true" formControlName="isAirManCertificateNotIssue" [value]=true
        label="No Airman Certificate issued" [hideLabelContainer]="true" controlSize="large" layout="grid"
        class="md:col-offset-3">
      </dms-check-box-binary>
    }
    @if (isAdministrativePreapproval === true && form.get('isAirManCertificateNotIssue')?.value === true) {
      <dms-input-text-area formControlName="airmanCertificateNotissuedReason"
        identity="id_grp2postact_textarea_airmanCertificateNotissuedReason"
        [rows]="5" [cols]="30" label="Reason why Airman Certificate was not issued">
      </dms-input-text-area>
    }
    @if ((isSae || isDpe) && isNoticeOfDisapproval && !isProficiencyCheck && !isAdministrativePreapproval) {
      <dms-input-text-area
        formControlName="areasOfOpertion" identity="id_grp2postact_textarea_areasOfOpertion"
        label="Areas of operation and tasks found to be Unsatisfactory"
      [rows]="5" [cols]="30"></dms-input-text-area>
    }
    @if ((isSae || isDpe) && isLetterOfDiscon && !isProficiencyCheck && !isAdministrativePreapproval) {
      <dms-input-text-area
        formControlName="reasonForDiscontinue" identity="id_grp2postact_textarea_reasonForDiscontinue" [rows]="5"
      [cols]="30" label="Reason(s) for discontinuance"></dms-input-text-area>
    }
    @if ((isSae || isDpe) && !isAdministrativePreapproval) {
      <dms-input-textbox identity="id_grp2postact_input_airCraftRegistrationNumber" type="text"
        formControlName="airCraftRegistrationNumber"
        label="Aircraft registration number used for the test or check"
        />
    }
    @if ((isSae || isDpe) && !isAdministrativePreapproval) {
      <dms-input-textbox identity="id_grp2postact_input_simulatorFaaId" type="text"
        label="Simulator FAA ID used for the test or check" formControlName="simulatorFaaId" />
    }
    <dms-calendar identity="id_grp2postact_pcal_actualStartDate" label="Actual Start Date of Activity"
      id="id_grp2postact_cal_actualStartDate" [showIcon]="true" [showOtherMonths]="false" [showTime]="false"
      controlSize="large"  formControlName="actualStartDate"
      [maxDate]="todayDate" dataType="string" [doSpotLight]="(!isExternal && isActulDateDifference)">
    </dms-calendar>
    @if ((isDpe || isSae) && !isAdministrativePreapproval) {
      <dms-calendar identity="id_grp2postact_pcal_proposedStartDate" [showIcon]="true" controlSize="large"
        [showOtherMonths]="false" [showTime]="false"
        label="Proposed Start Date of Activity" formControlName="proposedStartDate"
        [maxDate]="todayDate" dataType="string">
      </dms-calendar>
    }
    @if ((isDpe || isSae) && !isAdministrativePreapproval) {
      <dms-calendar identity="id_grp2postact_pcal_actualEndDate"
        [showIcon]="true" [showOtherMonths]="false" [showTime]="false" formControlName="actualEndDate"
        label="Actual End Date of the Activity" [validationMessages]="invalidActualEndDate" [maxDate]="todayDate"
        dataType="string" controlSize="large" [doSpotLight]="(!isExternal && isActulDateDifference)">
      </dms-calendar>
    }
    @if (form.hasError('endDateEarlierThanStartDate')) {
      <div class="grid pt-0" >
        <div class="col-12 c-label md:col-4 lg:col-4 xl:col-3 pt-0 pb-0"></div>
        <div class="col-12 c-control md:col-8 lg:col-8 xl:col-9 pt-0 pb-0">
          <span class="message-error-sm">
            Actual End Date cannot be before Actual Start Date.
          </span>
        </div>
      </div>
    }
    @if ((isDpe || isSae) && !isAdministrativePreapproval) {
      <dms-input-textbox
        identity="id_grp2postact_input_groundPortionTestDuration" type="text"
        ariaLabel="Duration of the Ground Portion of the Test or Check"
        label="Duration of the Ground Portion of the Test or Check" formControlName="durationOfGroundPortion"
        inputmode="numeric" digitOnly [validationMessages]="invalidPattern"
        (blurEvent)="onDurationBlur($event,'durationOfGroundPortion')" />
    }
    @if ((isDpe || isSae) && !isAdministrativePreapproval) {
      <dms-input-textbox
        identity="id_grp2postact_input_flightPortionestDuration" type="text"
        ariaLabel="Duration of the Flight Portion of the Test or Check"
        label="Duration of the Flight Portion of the Test or Check" formControlName="durationOfFlightPortion"
        inputmode="numeric" digitOnly [validationMessages]="invalidPattern"
        (blurEvent)="onDurationBlur($event,'durationOfFlightPortion')" />
    }
    @if ((isDpe || isSae) && !isAdministrativePreapproval) {
      <dms-input-textbox
        identity="id_grp2postact_input_fstdSimulatorPortion" type="text"
        ariaLabel="Duration of the FSTD/Simulator Portion of the Test or Check"
        label="Duration of the FSTD/Simulator Portion of the Test or Check"
        formControlName="durationOfFstdSimulatorPortion" inputmode="numeric" digitOnly
        [validationMessages]="invalidPattern" (blurEvent)="onDurationBlur($event,'durationOfFstdSimulatorPortion')" />
    }
    <div class="col-12">
      <hr>
        @if (isMultipleApplicants) {
          <span>You can enter upto 125 Applicants</span>
        }
      </div>
      @if (isMultipleApplicants) {
        <div class="col-12">
          <h2><span class="c-label-required">*</span>Applicants</h2>
          @if (applicantFormGroups != null) {
            <p-table role="presentation"  id="tblApplicants"
              [value]="applicantFormGroups.controls">
              <ng-template pTemplate="header" let-columns>
                <tr role="row">
                  <th role="columnheader" id="id_grp2_applcnt_th_name"> Applicant Name </th>
                  <th role="columnheader" id="id_grp2_applcnt_th_appcert"> Applicant Certificate # </th>
                  <th role="columnheader" id="id_grp2_applcnt_th_addapp">
                    <span>
                      @if (applicantFormGroups.controls!= null && applicantFormGroups.controls.length < 125 && !isDisabled) {
                        <dms-button identity="btn_grp2postact_cmp_header_add_1" type="button"
                          (clickEvent)="addApplicant()" title="Add applicant" ariaLabel="Add applicant"
                          icon="fa fa-plus-square" [throttleTime]="500"
                        ></dms-button>
                      }
                    </span>
                  </th>
                </tr>
              </ng-template>
              <ng-template pTemplate="body" let-rowData let-rowIndex="rowIndex">
                <tr role="row" id="id_grp2_applcnt_th_tr_{{rowIndex}}" [formGroup]="rowData" class="font-bold-mobile">
                  <td role="cell">
                    <dms-input-textbox identity="id_g2postact_text_applicantName" formControlName="applicantName"
                    type="text" label="Applicant Name" ariaLabel="Applicant Name"></dms-input-textbox>
                  </td>
                  <td role="cell">
                    <dms-input-textbox identity="id_g2postact_text_certificateNumber"
                      formControlName="certificateNumber" type="text" ariaLabel="Applicant Certificate #"
                    label="Applicant Certificate #"></dms-input-textbox>
                  </td>
                  <td role="cell">
                    <span class="p-column-title" role="columnheader">Add Applicant</span>
                    <span>
                      @if (!isDisabled) {
                        <dms-button type="button" identity="btn_grp2postact_cmp_header_rem_1"
                          (clickEvent)="removeApplicant(rowIndex)" title="Remove applicant"
                        ariaLabel="Remove applicant" icon="fa fa-trash"></dms-button>
                      }
                    </span>
                  </td>
                </tr>
              </ng-template>
            </p-table>
          }
        </div>
      }
      @if (isMultipleApplicants && (applicantFormGroups.controls === null || applicantFormGroups.controls.length === 0) && (applicantFormGroups.touched)) {
        <div class="col-12"
          >
          <span class="message-error-sm">Please enter at least one Applicant</span>
        </div>
      }
      @if (!isMultipleApplicants) {
        <div class="col-12">
          <span class="text-bold-600">Applicant Address</span>
        </div>
      }
      @if (!isMultipleApplicants) {
        <div class="col-12">
          <dms-address [addressGroup]="$any(form.get('addressFormGroup'))" [hidePhone]="true" [hideType]="true"
            [hideName]="true" [formSubmitted]="formSubmitted" [readOnlyAddress]="isDisabled"
            [triggerFieldChangeEvent]=false>
          </dms-address>
        </div>
      }
      <hr>
        @if (!isMultipleApplicants) {
          <dms-input-textbox identity="id_grp2postact_input_name" type="text"
            label="Name of the Applicant" formControlName="nameOfApplicant" placeholder="Name" />
        }
        @if (!isMultipleApplicants) {
          <dms-input-textbox type="text" identity="id_grp2postact_input_phoneNumber"
            label="Phone number of applicant" formControlName="phoneNumber" placeholder="Phone" />
        }
        @if (!isMultipleApplicants) {
          <dms-input-textbox identity="id_grp2postact_input_email" type="email"
            label="Email Address of applicant" formControlName="email" placeholder="Email" />
        }
        @if (!isMultipleApplicants) {
          <dms-input-textbox identity="id_grp2postact_input_certificateNumberOfApplicant"
            type="text" label="Certificate # of Applicant" formControlName="certificateNumberOfApplicant" />
        }
        @if (!isMultipleApplicants) {
          <dms-dropdown identity="id_grp2postact_pdd_countryOfApplicant" [options]="countries"
            formControlName="countryOfApplicant" label="Nationality of Applicant"
          placeholder="Select an country"></dms-dropdown>
        }
        @if (!isAdministrativePreapproval) {
          <dms-auto-complete identity="id_grp2postact_pautocomp_airportOfTraining"
            formControlName="airportOfTraining" (completeMethod)="filterAirports($event)"
            label="Airport of primary training or nearest airport to primary training"
            [suggestions]="airports" field="name" [virtualScrollItemSize]="100"
          [minLength]="3" ariaLabel="Search with airport name" [forceSelection]="true"></dms-auto-complete>
        }
        @if (showIacra) {
          <dms-radio-button identity="id_grp2postact_pradio_enteredInIacra" label="Entered in IACRA"
            [radioValues]="[{ label: 'Yes', value: 1 }, { label: 'No', value: 2 }]"
            formControlName="iacraStatusType{{groupIndex}}">
          </dms-radio-button>
        }
        @if ((form.get('iacraStatusType'+groupIndex)?.value != null && !isProficiencyCheck && !isLetterOfDiscon && form.get('iacraStatusType'+groupIndex)?.value !==1) || ((isDpe || isSae) && isSmtfSelected)) {
          <dms-calendar
            identity="id_grp2postact_input_datePaperWorkSent" [showIcon]="true" controlSize="large"
            label="Date the paperwork was sent or delivered to managing office"
            [showOtherMonths]="false" formControlName="datePaperWorkSent"
            [maxDate]="maxDate" dateFormat="mm/dd/yy" dataType="string">
          </dms-calendar>
        }
        @if (((isSae || isDpe) && (isLetterOfDiscon || isNoticeOfDisapproval))) {
          <div class="col-12">
            <h3>Please attach the Letter of Discontinuance or the Notice of Disapproval from the previous test</h3>
          </div>
        }
      </div>
    }
