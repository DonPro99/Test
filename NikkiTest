import { Component, OnInit, ViewChild, ViewEncapsulation } from '@angular/core';
import { ActivatedRoute, Router } from '@angular/router';
import {
  ActionButton, ActivityRequestStatusEnum,
  AdminpeIndexComponent as AdminPePoIndexComponent,
  AfsGroupsPostActivityViewModel, BaseComponent,
  ButtonActionsEnum,
  DartPoIndexComponent,
  DesigneeTypeEnum,
  DmePoIndexComponent,
  DpeIndexComponent as DpePoIndexComponent,
  DprePoIndexComponent,
  LookupService,
  PreApprovalRequestService,
  PreApprovalRequestStatusEnum,
  SaeIndexComponent as SaePoIndexComponent,
  UtilityService,
} from 'dms-web-shared';
import { ConfirmationService, MessageService as ToastService} from 'primeng/api';

import { FormArray, FormGroup } from '@angular/forms';
import { Observable } from 'rxjs';
import { takeUntil } from 'rxjs/operators';
import { HttpStatusCode } from '@angular/common/http';

@Component({
    selector: 'po-afs-index',
    templateUrl: './index.component.html',
    styleUrls: ['./index.component.scss'],
    encapsulation: ViewEncapsulation.None,
    standalone: false
})
export class PoIndexComponent extends BaseComponent implements OnInit {
  actionButtons: ActionButton[] = [];
  isEditPostActivity: boolean = false;
  isDisabled = false;
  showEdit = false;
  postActivityCantSubmit = true;

  constructor(private readonly lookupService: LookupService,
              private readonly service: PreApprovalRequestService,
              private readonly route: ActivatedRoute,
              private readonly router: Router,
              private readonly util: UtilityService,
              private readonly confirmationService: ConfirmationService,
              public utilityService: UtilityService,
              private readonly toastService: ToastService) {
                super();
    this.props = {
      title: 'Post Activity',
      tabCount: 0,
      buttons: [],
      acceptLabel: 'Yes',
      acceptVisible: true,
      rejectLabel: 'No',
      rejectVisible: true,
    };
  }
  designeeTypeId: number = 0;
  categoryId?: number = 0;
  data: AfsGroupsPostActivityViewModel | undefined | null;
  activeIndex: number = 0;
  props: any;
  isAdmin: boolean = false;
  preApprovalRequestId: number = 0;
  postActivityId = 0;
  preApprovalRequestFormGroup: FormGroup | undefined | null;
  designeeTypeEnum: typeof DesigneeTypeEnum = DesigneeTypeEnum;

  @ViewChild('active') index: DartPoIndexComponent | DmePoIndexComponent | DprePoIndexComponent | DpePoIndexComponent | SaePoIndexComponent | AdminPePoIndexComponent | undefined | null;


  get getIsDisabled() {
    return this.data!.requestInfo?.activityStatus?.id === ActivityRequestStatusEnum.Completed ||
      this.data!.requestInfo?.activityStatus?.id === ActivityRequestStatusEnum.Canceled;
  }

  get isCancel() {
    return this.data!.statusId === PreApprovalRequestStatusEnum.Cancelled;
  }

   ngOnInit() {
    if (!this.lookupService.hasLookupDataCached) {
        this.lookupService.populateLookupData();
    }
    this.designeeTypeId = +this.route.snapshot.data['designeeTypeId'];
    this.isAdmin = this.util.toBoolean(this.route.snapshot.params['isAdmin']);
    this.showEdit = (this.route.snapshot.queryParams['isVersion'] !== 'true');
    const postActivity$ = this.route.snapshot.data['postActivity'];
    
    postActivity$.pipe(takeUntil(this.destroying$)).subscribe((data: any) => {
      this.data = data;
      this.isDisabled = this.getIsDisabled;
      if (this.showEdit && this.isDisabled && this.data!.completedDate
        && this.data!.statusId === PreApprovalRequestStatusEnum.Completed
        && this.data!.isLatestVersion
        && new Date(this.data!.completedDate)
        >= new Date(new Date().getTime() - (30 * 24 * 60 * 60 * 1000))) {
        this.showEdit = true;
      } else {
        this.showEdit = false;
      }
      this.getActionButtions();
    });
  }

  private getActionButtions() {
    this.actionButtons = this.lookupService.getActionButtons();
    this.actionButtons.splice(
      2,
      0,
      new ActionButton('Print', 'Print', 'printPage', true, false, 5, 'fa fa-print')
    );
    this.actionButtons.splice(
      3,
      0,
      new ActionButton('Edit', 'Edit', 'edit', true, false, 2, 'fa fa-pencil')
    );
      
    this.actionButtons.forEach((a) => {
      switch (a.eventKey) {
        case ButtonActionsEnum.Back:
          a.displayOrder = 1;
          break;
        case ButtonActionsEnum.Cancel:
          a.displayOrder = 6;
          break;
        case ButtonActionsEnum.Save:
          a.displayOrder = 3;
          a.isDisplay = !this.isDisabled && !this.isEditPostActivity;
          break;
        case 'edit':
          a.isDisplay = this.isDisabled && this.showEdit;
          break;
        case ButtonActionsEnum.Submit:
          a.displayOrder = 4;
          a.isDisplay = !this.isDisabled || this.isEditPostActivity;
          break;
      }
    });
  }


  actionButtonClick(eventKey: string) {
    switch (eventKey) {
      case ButtonActionsEnum.Back:
        this.goToActionsPage();
        break;
      case ButtonActionsEnum.Save:
        this.onSubmit(false);
        break;
      case 'printPage':
        this.printPage();
        break;
      case 'edit':
        this.enableEdit();
        break;
      case ButtonActionsEnum.Submit:
        this.onSubmit(true);
        break;
      case ButtonActionsEnum.Cancel:
        this.goToHomePage();
        break;
    }
  }
  onSubmit(isSubmit: boolean) {
    const data: AfsGroupsPostActivityViewModel  = this.index!.getModel()!;
    data.isSubmit = isSubmit;
    if (isSubmit === true) {
      this.index!.form?.markAllAsTouched();
      if (this.index!.form?.invalid) {
        return;
      }
      if (data.statusId === PreApprovalRequestStatusEnum.Completed) {
        this.confirmationService.confirm({
          header: 'Confirm new version',
          message: 'Are you sure you want to create a new version of Post Activity?',
          key: 'dms',
          icon: undefined,
          acceptLabel: this.props?.acceptLabel,
          acceptVisible: this.props?.acceptVisible,
          rejectLabel: this.props?.rejectLabel,
          rejectVisible: this.props?.rejectVisible,
          rejectIcon: 'fa fa-times',
          acceptIcon: 'fa fa-check',
          accept: () => {
            this.saveRequest(data).pipe(takeUntil(this.destroying$)).subscribe();
          },
          reject: () => { }
        });
      } else {
        this.validateDate(data);
      }
    } else {
      this.saveRequest(data).pipe(takeUntil(this.destroying$)).subscribe();
    }
  }

  private validateDate(data: any)  {
    if (this.data!.preApprovalRequest?.testInformation?.proposeStartDate) {
      const proposeStartDate = new Date(this.data!.preApprovalRequest.testInformation.proposeStartDate);
      this.postActivityCantSubmit = proposeStartDate <= new Date();
      if (this.postActivityCantSubmit) {
        this.saveRequest(data).pipe(takeUntil(this.destroying$)).subscribe();
      }
  }
  }

  private saveRequest(saveData: AfsGroupsPostActivityViewModel): Observable<any> {
    const saveMessage = 'Post-Activity has been saved successfully.';
    const updateMessage = 'Post-Activity has been updated successfully.';
    if (saveData.id === 0) {
      return new Observable(observer => {
        this.service.savePostActivity(saveData).pipe(takeUntil(this.destroying$)).subscribe({
          next: (result) => {
            this.data!.id = result.id;
            this.data!.documentReference!.referenceId = result.id;
            this.data!.documentReference!.secondaryReferenceId = 0;
            this.uploadDocuments(saveMessage, saveData);          
            observer.next();
            observer.complete();
          }, 
          error: (err) => {
            this.toastService.add({ key: 'dms', severity: 'error', summary: 'Error Message', detail: 'Request failed.' });
            this.handleBadRequest(err);
          }
        });
      });
    }
    return new Observable(observer => {
      this.service.savePostActivity(saveData).pipe(takeUntil(this.destroying$)).subscribe({
        next: (result) => {
        this.data!.documentReference!.referenceId = result.id;
        this.data!.documentReference!.secondaryReferenceId = 0;
        this.uploadDocuments(updateMessage, saveData);   
        observer.next();
        observer.complete();
        }, 
        error: (err) => {
        this.toastService.add({ key: 'dms', severity: 'error', summary: 'Error Message', detail: 'Request failed.' });
        this.handleBadRequest(err);
      }});
    });
  }

  private handleBadRequest(err: any) {
    if (err?.status === HttpStatusCode.BadRequest &&
      (err?.error?.id && err?.error.id != this.data?.id) ||
      (err?.error?.statusId && err?.error.statusId != this.data?.statusId)) {
        this.confirmationService.confirm({
          header: 'Confirm new version',
          message: 'An updated version of Post Activity is already submitted. Please accept to load new version of Post Activity.',
          key: 'dms',
          acceptLabel: this.props?.acceptLabel,
          acceptVisible: this.props?.acceptVisible,
          rejectLabel: this.props?.rejectLabel,
          rejectVisible: this.props?.rejectVisible,
          rejectIcon: 'fa fa-times',
          acceptIcon: 'fa fa-check',
          accept: () => {
            this.data!.id = err?.error.id;
            this.router.navigate([`postactivity/afsgroups/version/${this.data?.id}`]); 
          },
          reject: () => { }
        });
    }
  }

  private uploadDocuments(message: string, saveData: AfsGroupsPostActivityViewModel) {
    this.index!.uploadControl?.fileUpload(this.data!.documentReference!.referenceId!)
      .pipe(takeUntil(this.destroying$))
      .subscribe({
        next: () => {
          this.toastService.add({ key: 'dms', severity: 'success', summary: 'Success Message', detail: message });
          if (saveData.isSubmit) {
            this.goToHomePage();
          }
        },
        error: () => {
          this.toastService.add({
            key: 'dms',
            severity: 'error',
            summary: 'Error Message',
            detail: 'Upload Document failed.'
          });
        }
      });
  }

  closeDialog() {
    this.postActivityCantSubmit = true;
  }
  enableEdit() {
    this.isEditPostActivity = true;
    this.index!.form!.get('uploadId')?.enable();
    this.isDisabled = !this.isEditPostActivity;
    this.getActionButtions();

    this.index!.form!.get('generalComments')?.enable();
    if (this.index!.form!.contains('dart196FormGroup')) {
      this.index!.form!.get('dart196FormGroup')?.enable();
    }
    if (this.index!.form!.contains('dart176FormGroup')) {
      this.index!.form!.get('dart176FormGroup')?.enable();      
      const postActivityCertificatesGroup = this.index!.form!.get('dart176FormGroup')?.get('certificatesGroup') as FormArray;
      postActivityCertificatesGroup['controls']
        ?.forEach((certificate:any) => {
          if(!certificate.get('isSelected')?.value)
          {
            certificate.get('certificateCategoryId').disable();                        
            certificate.get('issuanceTypeId').disable(); 
            certificate.get('issuanceDate').disable(); 
          }
        
      })
      
    }
  }

  goToActionsPage() {
    const url = 'preapprovalrequest';
    this.router.navigate([url]);
  }

  goToHomePage() {
    this.router.navigate(['/home']);
  }

  printPage() {
    window.print();
  }
}
