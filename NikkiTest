           {files_string}


           Thanks,
           RAA IT Team

             Note: This is autogenerated email. please reach out saisrinivasareddy.vustela@elevancehealth.com"""
            status_code="SUCCESS."
            send_email(sender_email, recipient_email, smtp_server, smtp_port, loaded_files, step, today_date, body_email,status_code)
            logger.info(f"Processing and loading completed for {step} with batch ID {batch_id}: SUCCESS")
        except Exception as e:
             status_code="Failed."
             files_string = '\n'.join(loaded_files)
             body_email = f"""
            Hello,

            The following files for {step} failed to snowflake on {today_date}



