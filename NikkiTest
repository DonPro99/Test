def get_pdf_details(logger, session, vendor_name, database):
    try:
        # --- MODIFIED (RRR): session is passed in instead of being built here
        # from Secrets Manager credentials ---
        print(f"printing <<<<<<{vendor_name}>>>>>> missing pdf details..")

        pdf_missing_df = session.sql("""
            SELECT 
            zip.LOB_CD AS LOB,
            zip.VENDOR_NAME AS VENDOR,
            zip.ZIPFILE_NM AS Charts_Zip_Name,
            zip.PDFFile_Nm AS PDF_File_Name,
            'PDF is missing between PDFBYZIP and CHARTVW_S3' AS Reject_Reason,
            'RAA IT Support team need to investigate missing charts' AS Remediation,
            zip.FILE_REC_DATETIME AS File_Received_Date,
            zip.EDL_LOAD_DTM AS Load_Date
            FROM 
                {0}.RAA_RAWZ.CHART_PDFNM_BYZIP AS zip
            LEFT JOIN 
                {0}.RAA_RAWZ.RAA_CHARTVIEW_S3 AS s3
            ON 
                UPPER(s3.PDF_FILE_NAME) = UPPER(zip.PDFFILE_NM) 
            WHERE 
                TO_DATE(zip.EDL_LOAD_DTM) > '2024-11-12' AND
                s3.PDF_FILE_NAME IS NULL AND
                zip.ZIP_VALID_CD = TRUE AND
                UPPER(zip.VENDOR_NAME) = UPPER('{1}') AND
                NOT upper(zip.ZIPFILE_NM) RLIKE '.*(CROSSWALK_TRANSACT|CROSSWALK).*'
        """.format(database.upper(), vendor_name))
        pdf_missing_df.show()
        return pdf_missing_df.to_pandas()

    except Exception as e:
        logger.info(f"Error Info: {e}")
        logger.error(e)


def export_csv(df):
    with pd.io.common.StringIO() as buffer:
        df.to_csv(buffer, index=False)
        return buffer.getvalue()


def send_email(logger, from_address, to_addresses, subject, body, attachments):
    msg = MIMEMultipart()
    msg['From'] = from_address
    msg['To'] = to_addresses
    msg['Subject'] = subject
    msg.attach(MIMEText(body, 'html'))

    for filename, data in attachments.items():
        part = MIMEApplication(data)
        part['Content-Disposition'] = f'attachment; filename="{filename}"'
        msg.attach(part)

    with smtplib.SMTP('smtp.wellpoint.com', 25) as smtp:
        smtp.sendmail(from_address, to_addresses, msg.as_string())
    logger.info("Email sent successfully")


