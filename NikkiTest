        }

        private void ArrangeActvities(int designeeGroupId, int roleId, ref ActivityHistoryViewModel[] list, IList<ActivityTypeViewModel> oversightActivities)
        {
            list = list.Where(a => (a.IsPostActivityCompleted.GetValueOrDefault(true))).Select(a =>
            {
                switch (a.ModuleId)
                {
                    case (int)ProcessTypeEnum.SelectAndAppoint:
                        a.Name = ((ActivityTypeEnum)(a.ActivityTypeId.Value)).ToDescription();
                        a.FormData = string.IsNullOrWhiteSpace(a.FormData) ? string.Empty : JsonConvert.DeserializeObject<string>(a.FormData);
                        if (designeeGroupId == (int)DesigneeGroupEnum.Engineering)
                        {

                            a.Url = $"/selection/derappointmentreview/{a.FormData}/6/1";
                        }
                        break;
                    case (int)ProcessTypeEnum.Oversight:
                        var formData = JsonConvert.DeserializeObject<OverSightActivityInformation>(a.FormData);
                        a.Name = string.IsNullOrWhiteSpace(a.FormData) ? string.Empty : oversightActivities.First(o => o.Id == formData.OversightActivityTypeId).Name;
                        break;
                    case (int)ProcessTypeEnum.Expansion:
                        if (designeeGroupId != (int)DesigneeGroupEnum.AME)
                        {
                            a.Name = "Request Additional Authorizations";
                            if (a.DesigneeTypeId == (int)DesigneeTypeEnum.DERT || a.DesigneeTypeId == (int)DesigneeTypeEnum.DERY)
                            {
                                a.Url = $"Expand/der-decision/{a.Id}/9999";
                            }
                            else if ((a.ActivityTypeId == (int)ActivityTypeEnum.EvaluationPanelResult) &&
                                (a.DesigneeTypeId == (int)DesigneeTypeEnum.DME ||
                                a.DesigneeTypeId == (int)DesigneeTypeEnum.DPE ||
                                a.DesigneeTypeId == (int)DesigneeTypeEnum.SAE ||
                                a.DesigneeTypeId == (int)DesigneeTypeEnum.DPRE ||
                                a.DesigneeTypeId == (int)DesigneeTypeEnum.DART))
                            {
                                a.Name = "Evaluation Panel Results";
                                a.Url = $"expand/evaluationpanelresults/{a.FormData}/{a.DesigneeTypeId}";
                            }
                        }

                        break;
                    case (int)ProcessTypeEnum.AnnualProfileUpdate:
                        a.CloaId = a.NewCloaId ?? a.CloaId;
                        break;
                    case (int)ProcessTypeEnum.DeploymentWorkflow:
                        var data = string.IsNullOrWhiteSpace(a.FormData) ? null : JsonConvert.DeserializeObject<List<DerExpansionViewModel>>(a.FormData).OrderByDescending(d => d.VersionNumber).FirstOrDefault();
                        a.Url = $"reduce/decision/der/versions/:activityId/{data?.VersionNumber}";
                        break;
                }

                switch (a.StatusId)
                {
                    case (int)ActivityStatusEnum.Submitted:
                    case (int)ActivityStatusEnum.Pending:
                    case (int)ActivityStatusEnum.Initiated:
                        a.Status = ActivityStatusEnum.Pending.ToDescription();
                        break;
                    case (int)ActivityStatusEnum.Completed:
                        a.Status = ActivityStatusEnum.Completed.ToDescription();
                        break;
                    case (int)ActivityStatusEnum.Denied:
                        a.Status = ActivityStatusEnum.Denied.ToDescription();
                        break;
                }

                GeneralAndReportUserNavigationSettings(roleId, a);

                return a;
            }).ToArray();
        }

        private static void GeneralAndReportUserNavigationSettings(int roleId, ActivityHistoryViewModel a)
        {
            var trainingRoles = new List<int> {(int)RoleEnum.AfsTrainingAdministrator, (int)RoleEnum.AamTrainingAdministrator, (int)RoleEnum.AirTrainingAdministrator, (int)RoleEnum.AvsTrainingAdministrator, (int)RoleEnum.AovTrainingAdministrator};
            
            var odaRoleIds= new int[]{(int)RoleEnum.OMTM,(int)RoleEnum.ODAAO,(int)RoleEnum.OMTL,(int)RoleEnum.ODAAS };
            if ((roleId == (int)RoleEnum.FaaGeneralUser || roleId == (int)RoleEnum.Reporting || odaRoleIds.Contains(roleId)) &&
                                a.StatusId != (int)ActivityStatusEnum.Completed &&
                                a.StatusId != (int)ActivityStatusEnum.Cancelled &&
                                a.StatusId != (int)ActivityStatusEnum.Denied)
            {
                a.HasNavigation = false;
            }
            if ((roleId == (int)RoleEnum.FaaGeneralUser || roleId == (int)RoleEnum.Reporting || odaRoleIds.Contains(roleId) || trainingRoles.Contains(roleId)) &&
               a.ModuleId == (int)ProcessTypeEnum.RecordFeedback)
            {
                a.HasNavigation = true;
            }
        }

        private static void BuildActivityFilters(int designeeGroupId, int roleId, out Expression<Func<ActivityEntity.Activity, bool>> filter, out Expression<Func<ActivityEntity.Activity, bool>> asiFilter)
        {
            filter = (def => true);
            asiFilter = (def => true);
            switch (designeeGroupId)
            {
                case (int)DesigneeGroupEnum.AFS:
                    filter = (a => a.ModuleId != (int)ProcessTypeEnum.EquipmentCertification &&
                                    a.ModuleId != (int)ProcessTypeEnum.ManageDesignee &&
                                  !(a.ModuleId == (int)ProcessTypeEnum.Oversight
                                    && (a.StatusId != (int)ActivityStatusEnum.Completed && a.StatusId != (int)ActivityStatusEnum.Cancelled)));
                    if (roleId == (int)RoleEnum.AviationSafetyInspector)
                    {
                        asiFilter = (a => (a.StatusId == (int)ActivityStatusEnum.Pending
                                        || a.StatusId == (int)ActivityStatusEnum.Completed
                                        || (a.ModuleId == (int)ProcessTypeEnum.RecordFeedback && a.StatusId == (int)ActivityStatusEnum.Saved)
                                        || (a.ModuleId == (int)ProcessTypeEnum.Counseling && a.StatusId == (int)ActivityStatusEnum.Saved)
                                        || (a.ModuleId == (int)ProcessTypeEnum.InvestigationRecord && a.StatusId == (int)ActivityStatusEnum.Saved)
                                        || (a.ModuleId == (int)ProcessTypeEnum.Oversight && a.StatusId == (int)ActivityStatusEnum.Cancelled)));
                    }

                    break;
                case (int)DesigneeGroupEnum.Manufacturing:
                    filter = (a => a.ModuleId != (int)ProcessTypeEnum.EquipmentCertification &&
                                    a.ModuleId != (int)ProcessTypeEnum.ManageDesignee &&
                                    !((a.ModuleId == (int)ProcessTypeEnum.Witnessing || a.ModuleId == (int)ProcessTypeEnum.Oversight)
                                        && a.StatusId != (int)ActivityStatusEnum.Completed && a.StatusId != (int)ActivityStatusEnum.Cancelled)
                                     && !(a.ModuleId == (int)ProcessTypeEnum.SiteEvaluationForm &&
                                         a.StatusId == (int)ActivityStatusEnum.Cancelled &&
                                         a.ModifiedBy == (int)ActivityUserEnum.SystemAdmin)
                                        );
                    break;
                case (int)DesigneeGroupEnum.AME:
                    filter = (a => a.ModuleId != (int)ProcessTypeEnum.EquipmentCertification &&
                                    a.ModuleId != (int)ProcessTypeEnum.ManageDesignee &&
                                    !((a.ModuleId == (int)ProcessTypeEnum.Witnessing || a.ModuleId == (int)ProcessTypeEnum.Oversight)
                                        && a.StatusId != (int)ActivityStatusEnum.Completed && a.StatusId != (int)ActivityStatusEnum.Cancelled)
                                     && !(a.ModuleId == (int)ProcessTypeEnum.SiteEvaluationForm &&
                                         a.StatusId == (int)ActivityStatusEnum.Cancelled &&
                                         a.ModifiedBy == (int)ActivityUserEnum.SystemAdmin)
                                        );
                    break;
                case (int)DesigneeGroupEnum.Engineering:
                    filter = (a => a.ModuleId != (int)ProcessTypeEnum.EquipmentCertification &&
                                   a.ModuleId != (int)ProcessTypeEnum.ManageDesignee &&
                                   !(a.ModuleId == (int)ProcessTypeEnum.DeploymentWorkflow && a.StatusId != (int)ActivityStatusEnum.Completed) &&
                                 !(a.ModuleId == (int)ProcessTypeEnum.Oversight && a.StatusId != (int)ActivityStatusEnum.Completed));
                    if (roleId == (int)RoleEnum.AviationSafetyInspector)
                    {
                        asiFilter = (a => (a.StatusId == (int)ActivityStatusEnum.Pending || a.StatusId == (int)ActivityStatusEnum.Completed || (a.ModuleId == (int)ProcessTypeEnum.RecordFeedback && a.StatusId == (int)ActivityStatusEnum.Saved) || (a.ModuleId == (int)ProcessTypeEnum.Counseling && a.StatusId == (int)ActivityStatusEnum.Saved)));
                    }
                    if (roleId == (int)RoleEnum.AviationSafetyEngineer)
                    {
                        asiFilter = (a => (a.StatusId == (int)ActivityStatusEnum.Pending || a.StatusId == (int)ActivityStatusEnum.Completed || (a.ModuleId == (int)ProcessTypeEnum.RecordFeedback && a.StatusId == (int)ActivityStatusEnum.Saved)));
                    }

                    break;
            }
        }

