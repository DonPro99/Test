                            .Select(a => new
                            {
                                DesigneeUserId = a.Cloa.Application.UserId,
                                DesigneeNameWithCloa = a.Cloa.ProfileVersion.ToFullName(),
                                Activity = new ActivityHistoryViewModel
                                {
