F=snowpark/patient-encounter-etl/src/main/scala/com/anthem/hca/chaselist/automation/PatientDecryptloader.scala
git fetch origin
for b in develop sit uat preprod; do
  git diff --quiet origin/$b origin/master -- $F && echo "master SAME as $b" || echo "master DIFFERENT from $b"
done
git log --no-merges --format='%h | %an | %ad | %s' --date=short -5 origin/master -- $F
