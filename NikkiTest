        public DesigneeInfoViewModel DesigneeInfomation(int applicationId)
        {
            var cloaId = _context.Applications
                            .Where(a => a.Id == applicationId)
                            .Select(a => a.Cloas.Any(c => c.CloaStatusId == (int)CloaStatusEnum.Active || c.CloaStatusId == (int)CloaStatusEnum.Terminated)
                                    ? a.Cloas
                                        .Where(c => c.CloaStatusId == (int)CloaStatusEnum.Active || c.CloaStatusId == (int)CloaStatusEnum.Terminated)
                                        .OrderByDescending(c => c.Id)
                                        .Select(c => c.Id)
                                        .FirstOrDefault()
                                    : a.Cloas
                                        .OrderByDescending(c => c.Id)
                                        .Select(c => c.Id)
                                        .FirstOrDefault()).First();

            DesigneeInfoViewModel model = BuildInformation(cloaId);

            if (model.Type.Id == (int)DesigneeTypeEnum.DERT || model.Type.Id == (int)DesigneeTypeEnum.DERY)
            {
                model.ProjectTeamMemberIds = _context.ProjectTeamManagers
                .Where(t => t.Project.ApplicationId == applicationId)
                .Select(s => s.UserOfficeRole.UserId).Distinct().ToArray();

                var officeId = _context.Applications.Where(app => app.Id == applicationId).First().OfficeId;
                model.ProjectTeamMembers = _context.ProjectTeamManagers
                    .Where(p => p.UserOfficeRole.OfficeRole.OfficeId == officeId && p.UserOfficeRole.UserId == _tokenService.GetUserId())
                    .Where(p => p.Project.ProjectStatusId == 1 || (p.Project.ProjectStatusId == 2 && p.Project.ModifiedDate <= DateTime.Today.AddMonths(6)))
                    .Select(p => new
                    {
                        Id = p.Project.Application.Id,
                        Name = p.CreatedUser.ToFullName(),
                        DesigneeType = p.Project.Application.DesigneeType.Code,
                        Code = p.Project.Application.Cloas.OrderByDescending(c => c.Id).First().DisciplineType.Name
                    }).AsEnumerable().OrderBy(a => a.Name).Distinct()
                    .Select(p => new BaseLookupViewModel
                    {
                        Id = p.Id,
                        Name = p.Name + ", " + p.DesigneeType,
                        Code = p.Code
                    }).ToList();
            }
            return model;
        }

        [SuppressMessage("SonarQube", "S3776:Cognitive Complexity of methods should not be too high", 
