<menu-bar></menu-bar>
<pagetitle [title]="props?.title" iconClass="fa-pencil-square-o" [designeeTypeId]="designeeTypeId" [userGuideCompTypeCode]="props?.userguideComponent" >
</pagetitle>

@if (data) {
  @switch (designeeTypeId) {
    @case (22) {
      <dms-pr-dme-index #active
        [pr]="data"
        [userId]="userId"
        [isDisabled] ="isDisabled"
        [activeIndex]="activeIndex"
        (tabChange)="setActiveIndex($event)"
        (emitChange)="onPreApprovalChange()"
        [copyPreApprovalRequestId] = copyPreApprovalRequestId
        (getConfig)="setConfig($event)">
      </dms-pr-dme-index>
    }
    @case (23) {
      <dms-pr-dpre-index #active
        [pr]="data"
        [userId]="userId"
        [isDisabled] ="isDisabled"
        [activeIndex]="activeIndex"
        (tabChange)="setActiveIndex($event)"
        [copyPreApprovalRequestId] = copyPreApprovalRequestId
        (emitChange)="onPreApprovalChange()"
        (getConfig)="setConfig($event)">
      </dms-pr-dpre-index>
    }
    @case (21) {
      <dms-pr-dart-index #active
        [pr]="data"
        [categoryId]="categoryId"
        [userId]="userId"
        [isDisabled] ="isDisabled"
        [activeIndex]="activeIndex"
        (tabChange)="setActiveIndex($event)"
        [copyPreApprovalRequestId] = copyPreApprovalRequestId
        (emitChange)="onPreApprovalChange()"
        (getConfig)="setConfig($event)">
      </dms-pr-dart-index>
    }
    @case (24) {
      <dms-pr-dpe-index #active
        [pr]="data"
        [userId]="userId"
        [isDisabled] ="isDisabled"
        [categoryId] = "categoryId"
        [activeIndex]="activeIndex"
        (tabChange)="setActiveIndex($event)"
        [copyPreApprovalRequestId] = copyPreApprovalRequestId
        (emitChange)="onPreApprovalChange()"
        (getConfig)="setConfig($event)">
      </dms-pr-dpe-index>
    }
    @case (25) {
      <dms-pr-sae-index #active
        [pr]="data"
        [userId]="userId"
        [isDisabled] ="isDisabled"
        [categoryId] = "categoryId"
        [activeIndex]="activeIndex"
        (tabChange)="setActiveIndex($event)"
        [copyPreApprovalRequestId] = copyPreApprovalRequestId
        (emitChange)="onPreApprovalChange()"
        (getConfig)="setConfig($event)">
      </dms-pr-sae-index>
    }
    @case (26) {
      <dms-pr-adminpe-index #active [pr]="data" [userId]="userId" [isDisabled]="isDisabled"
        [activeIndex]="activeIndex"
        [copyPreApprovalRequestId] = copyPreApprovalRequestId
        (tabChange)="setActiveIndex($event)" (emitChange)="onPreApprovalChange()" (getConfig)="setConfig($event)">
      </dms-pr-adminpe-index>
    }
    @case (31) {
      <dms-pr-adminpe-index #active [pr]="data" [userId]="userId" [isDisabled]="isDisabled"
        [activeIndex]="activeIndex"
        [copyPreApprovalRequestId] = copyPreApprovalRequestId
        (tabChange)="setActiveIndex($event)" (emitChange)="onPreApprovalChange()" (getConfig)="setConfig($event)">
      </dms-pr-adminpe-index>
    }
  }
}

@if (props?.buttons.length > 0) {
  <actionbutton
    [buttons]="props?.buttons"
    formName="preApproval"
    [displayBusy]=false
    (actionButtonClickEvent)=(buttonClick($event))>
  </actionbutton>
}
