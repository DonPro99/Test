describe('AdminpeIndexComponent', () => {
  let component: AdminpeIndexComponent;
  let fixture: ComponentFixture<AdminpeIndexComponent>;
  const spies: any[] = [];
  let page: Page;
  function createSpy() {
    spies.push(SetUp.getSpy('lookupService'));
  }
  createSpy();

  async function createComponent() {
    fixture = TestBed.createComponent(AdminpeIndexComponent);
    page = new Page(fixture);
    component = page.component;
    page.component.pr = SetUp.getMockUpData();
    page.component.activeIndex = 2;
    page.component.isDisabled = false;
    spies[0].getPreApprovalCancelReasons.and.returnValue(SetUp.getCancelReasons());
    fixture.detectChanges();
    await fixture.whenStable();
  }

  beforeEach(waitForAsync(() => {
    TestBed.configureTestingModule({
      declarations: [
        AdminpeIndexComponent,
        MockComponent(DesigneeSummaryComponent),
        MockComponent(RequestInformationComponent),
        MockComponent(DmsTestCheckInformationComponent),
        MockComponent(DmsActivityLocationComponent),
        MockComponent(DmsApplicationInformationComponent),
        MockComponent(UploadControlComponent),
        MockComponent(DmsTextAreaComponent),
        MockComponent(PreApprovalRequestSummaryComponent),
      ],
      imports: [
        FormsModule,
        ReactiveFormsModule,
        BrowserAnimationsModule,
        TabsModule,
        DmsInputTextArea],
      providers: [
        { provide: LookupService, useValue: spies[0] },
      ]
    })
      .compileComponents();
    createComponent();
  }));

  it('should create', () => {
    expect(page.component).toBeTruthy();
  });

  it('should go through onTabChange function call', () => {
    fixture.detectChanges();
    spyOn(page.component, 'onTabChange');
    const firstTabButton = fixture.debugElement.query(By.css('.p-tablist .p-tab'));
    firstTabButton.nativeElement.click();
    expect(page.component.onTabChange).toHaveBeenCalled();
  });

  it('should go through emitFieldChange function call', () => {
    component.emitFieldChange(true);
    fixture.detectChanges(false);
    expect(component.emitChange.emit).toBeDefined();
  });

  it('should call isAutoPreapproval function', () => {
    expect(page.component.isAutoPreApproval).toBe(false);

    page.component.pr.testCheckInformation.isOtherAdminActivity = true;
    expect(page.component.isAutoPreApproval).toBe(true);
  });

  it('should call buildModel function', () => {
    page.component.getModel();
    spyOn(DmsTestInformationComponent, 'buildModel');
    page.component.form.markAllAsTouched();
    AdminpeIndexComponent.buildModel(page.component.form, page.component.pr);
    expect(DmsTestInformationComponent.buildModel).toHaveBeenCalled();
  });

  it('set pr id to 0 and should be timezoneid set to 5', () => {
    page.component.pr.id = 0;
    page.component.ngOnInit();
    expect(page.component.pr.testInformation.timeZoneId).toEqual(5);
  });

  it('should call setSummaryTab', () => {
    page.component.setSummaryTab();
    expect(page.component.summaryForm.status).toEqual("DISABLED");
  });

  it('set uploaded files count to 0 and should call buildform', () => {
    page.component.pr.documentReference = null;
    AdminpeIndexComponent.buildForm(page.component.pr, {
      categoryId: 0,
      isDisabled: false
    });
    expect(page.component.form.valid).toBeTrue();
  });
  it('should call when status is cancel',() => {   
    component.pr.requestInfo.activityStatus.id = ActivityRequestStatusEnum.Approved;    
    component.pr.statusId = PreApprovalRequestStatusEnum.Cancelled;
    component.ngOnInit();   
    fixture.detectChanges();  
    expect(component.isCancel).toEqual(true);
    expect(component.cancelReasons.length).toEqual(7);
  });

  it('should pass the actual designee type (Admin-PE-GEN) to DmsTestCheckInformationComponent.buildForm, not a hardcoded Admin-PE value', () => {
    spyOn(DmsTestCheckInformationComponent, 'buildForm').and.callThrough();
    const model = SetUp.getMockUpData();
    model.designeeInfo.typeId = DesigneeTypeEnum.ADMINPEGEN;

    AdminpeIndexComponent.buildForm(model, { isDisabled: false });

    expect(DmsTestCheckInformationComponent.buildForm).toHaveBeenCalledWith(
      model.testCheckInformation,
      model.testInformation,
      model.applicantInformation,
      jasmine.objectContaining({ designeeTypeId: DesigneeTypeEnum.ADMINPEGEN })
    );
  });

  it('should still pass Admin-PE correctly when the application is actually Admin-PE (regression check)', () => {
    spyOn(DmsTestCheckInformationComponent, 'buildForm').and.callThrough();
    const model = SetUp.getMockUpData();
    model.designeeInfo.typeId = DesigneeTypeEnum.ADMINPE;

    AdminpeIndexComponent.buildForm(model, { isDisabled: false });

    expect(DmsTestCheckInformationComponent.buildForm).toHaveBeenCalledWith(
      model.testCheckInformation,
      model.testInformation,
      model.applicantInformation,
      jasmine.objectContaining({ designeeTypeId: DesigneeTypeEnum.ADMINPE })
    );
  });
});
