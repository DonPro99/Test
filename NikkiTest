-- 1. Table existence check across all environments
SHOW TABLES LIKE 'RAD_DATAVANT_CHASE_PREMATCH' IN SCHEMA D01_RAA.RAA_RAWZ;
SHOW TABLES LIKE 'RAD_DATAVANT_CHASE_PREMATCH' IN SCHEMA DDL_REPOSITORY_01.RAA_RAWZ;
SHOW TABLES LIKE 'RAD_DATAVANT_CHASE_PREMATCH' IN SCHEMA T01_RAA.RAA_RAWZ;
SHOW TABLES LIKE 'RAD_DATAVANT_CHASE_PREMATCH' IN SCHEMA U01_RAA.RAA_RAWZ;

-- 2. Views check across all environments (using wildcard in case naming differs slightly)
SHOW VIEWS LIKE 'RAD_DATAVANT_CHASE_PREMATCH%' IN SCHEMA D01_RAA.RAA_RAWZ;
SHOW VIEWS LIKE 'RAD_DATAVANT_CHASE_PREMATCH%' IN SCHEMA T01_RAA.RAA_RAWZ;
SHOW VIEWS LIKE 'RAD_DATAVANT_CHASE_PREMATCH%' IN SCHEMA U01_RAA.RAA_RAWZ;

-- 3. Full detail via ACCOUNT_USAGE (creation dates, who created it, across everything)
SELECT table_catalog, table_schema, table_name, table_type, created, last_altered
FROM SNOWFLAKE.ACCOUNT_USAGE.TABLES
WHERE table_name = 'RAD_DATAVANT_CHASE_PREMATCH'
  AND table_schema = 'RAA_RAWZ'
ORDER BY created DESC;
