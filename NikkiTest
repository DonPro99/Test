                                            ? query.OrderBy(p => p.PreApprovalRequestFunctionCodes.OrderBy(p1 => p1.FunctionCode.Name).First())
                                            : query.OrderByDescending(p => p.PreApprovalRequestFunctionCodes.OrderBy(p1 => p1.FunctionCode.Name).First());
