cd ~/rbica14268
awk -F'|' '
{sub(/\r$/,"")}
FNR==1{p=c=0; for(i=1;i<=NF;i++){if($i=="ProjectID")p=i; if($i=="ClientChartID")c=i}; next}
NF<2{next}
FILENAME ~ /^mbrprov\//{mb[$c]=$p; keys[$c]=1; nm++; next}
{cp[$c]=$p; keys[$c]=1; nc++}
END{
  for(k in keys){
    if(!(k in mb))      {print k, "MISSING in MBR+PROV, CPL=" cp[k]; bad++}
    else if(!(k in cp)) {print k, "MISSING in CPL, MBR+PROV=" mb[k]; bad++}
    else if(mb[k]==cp[k]) {print k, mb[k], "MATCH"; ok++}
    else                {print k, "MBR+PROV=" mb[k], "CPL=" cp[k], "MISMATCH"; bad++}
  }
  print "----"
  print "MBR+PROV records: " nm "   CPL records: " nc
  print "Matched: " ok+0 "   Problems: " bad+0
  print (bad ? "RESULT: FAIL" : "RESULT: PASS - ProjectID identical in both files")
}' mbrprov/*.txt cpl/*.txt
