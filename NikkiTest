export SERVICE_USER=`echo $USER`

if [[ $SERVICE_USER == "srcradcoolbthts" ]]
then
    export ENVIRONMENT="ts"
elif [[ $SERVICE_USER == "srcradcoolbthpr" ]]
then
    export ENVIRONMENT="pr"
else
    export ENVIRONMENT="dv"
fi

export ENV=$ENVIRONMENT

if [[ "${ENVIRONMENT}" == "ts" ]]
then
  export SAS_ENV="SIT"
