git fetch origin
B=origin/feature/AG15138-1018
for env in develop sit uat preprod; do
  git checkout -q -B tmp-check-$env origin/$env
  if git merge --no-commit --no-ff -q $B >/dev/null 2>&1; then r="clean"; else r="CONFLICTS"; fi
  echo "== $env: $r | files changed: $(git diff --cached --name-only | wc -l) | deletions: $(git diff --cached --name-only --diff-filter=D | wc -l)"
  git diff --name-only --diff-filter=U | head -5
  git merge --abort 2>/dev/null; git reset -q --hard
done
git checkout -q feature/AM71511-snowflake-jdbc-dummy-master
