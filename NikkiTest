$ for env in develop sit uat preprod; do
  n=0; while read f; do git cat-file -e origin/$env:"$f" 2>/dev/null && ! git diff --quiet origin/master origin/$env -- "$f" && n=$((n+1)); done < pr_files.txt
  echo "== $env: files differing from master: $n"
done
