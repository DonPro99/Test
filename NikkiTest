                if (linkedAmeAccountApplication != null)
                {
                    model.OldApplicationId = linkedAmeAccountApplication.Id;
                }
            }

            return model;
        }

        private (DateTime? trainingDueDate, DateTime? seminarDueDate) GetNextTrainingDueDate(int userId, int? designeeTypeId, int? applicationId)
        {
            var dueDate = _context.NextTrainingDueDates.Where(n => n.UserId == userId && 
                                    (designeeTypeId == null || n.DesigneeTypeId == designeeTypeId) && 
                                    (applicationId == null || n.ApplicationId == applicationId))
                            .Select(n => n).FirstOrDefault();

            return new (dueDate?.NextTrainingDueDate, dueDate?.NextSeminarDueDate);
        }

        [SuppressMessage("SonarQube", "S3776:Cognitive Complexity of methods should not be too high", 
        Justification = "Complexity is aligned with business filtering requirements. Method is isolated and readable. Refactoring would fragment related logic without meaningful improvement")]
        private List<RecordNoteViewModel> BuildRecodNotes(int cloaId)
        {
            var cloa = _context.Cloas
                        .Include(c => c.Application.RecordNote)
                        .Where(c => c.Id == cloaId)
                        .FirstOrDefault();

            var msUserId = _context.UserOfficeRoles.Where(w => w.Id == cloa.ManagingSpecialistId).Select(s => s.UserId).FirstOrDefault();

            var authenticationInformation = GetAuthenticationInformation();
            var isCurrentUserAnMs = msUserId == authenticationInformation.AuthenticatedUserId || msUserId == authenticationInformation.ImpersonatedUserId;

            var recordNotes = cloa.Application.RecordNote != null && !string.IsNullOrEmpty(cloa.Application.RecordNote.Notes)
                                    ? JsonConvert.DeserializeObject<List<RecordNoteViewModel>>(cloa.Application.RecordNote.Notes)
                                    : new List<RecordNoteViewModel>();

            var msProxies = _context.UserOfficeRoles.Where(u => u.FormData != null &&
                                                                u.IsProxyRequestApproved.Value &&
                                                                u.IsActive &&
                                                                JsonExtensions.JsonIntValue(u.FormData, "$.UserOfficeRoleId") == cloa.ManagingSpecialistId).ToList();

            if (msProxies.Count > 0)
            {
                foreach (var msProxy in msProxies)
                {
                    var isCurrentUserProxyMs = msProxy.UserId == authenticationInformation.AuthenticatedUserId || msProxy.UserId == authenticationInformation.ImpersonatedUserId;

                    if (isCurrentUserProxyMs)
                    {
                        return recordNotes.Where(w => w.CreatedBy == msProxy.UserId).Select(d => { d.SortDate = string.IsNullOrWhiteSpace(d.Date) ? (DateTime?)null : DateTime.Parse(d.Date); return d; }).OrderByDescending(d => d.SortDate).ToList();
                    }
                }
            }

            return recordNotes.Where(w => isCurrentUserAnMs && w.CreatedBy == msUserId).Select(d => { d.SortDate = string.IsNullOrWhiteSpace(d.Date) ? (DateTime?)null : DateTime.Parse(d.Date); return d; }).OrderByDescending(d => d.SortDate).ToList();
        }

        private void MyOtherDesigneeTypes(DesigneeInfoViewModel model)
        {
            model.UserDesigneeList = _context.Cloas.Include(c => c.CloaDisciplineFarParts)
                                      .Where(c => c.Application.UserId == model.Id &&
                                                                        (c.CloaStatusId == (int)CloaStatusEnum.Active ||
                                                                        c.CloaStatusId == (int)CloaStatusEnum.Expired ||
                                                                        (c.CloaStatusId == (int)CloaStatusEnum.Terminated && c.TerminationDate.Value.AddDays(30) > DateTime.Now) ||
                                                                        c.CloaStatusId == (int)CloaStatusEnum.Suspended))
                                                                .Select(c => new LinkViewModel
                                                                {
                                                                    Id = c.ApplicationId,
                                                                    DisplayName = c.Application.DesigneeTypeId == (int)DesigneeTypeEnum.TCE
                                                                        ? $"{c.Application.DesigneeType.Code} ({c.Designator.Code})"
                                                                      :
                                                                      (c.Application.DesigneeTypeId == (int)DesigneeTypeEnum.DERT || c.Application.DesigneeTypeId == (int)DesigneeTypeEnum.DERY)
                                                                      ? $"{c.Application.DesigneeType.Code} - {c.DisciplineType.Name}"
                                                                      : c.Application.DesigneeType.Code,
                                                                    Url = model.ApplicationId == c.ApplicationId ? string.Empty : $"/planningpage/{c.ApplicationId}",
                                                                    HasNavigation = model.ApplicationId != c.ApplicationId
                                                                }).ToArray();
        }

        private static IList<LinkViewModel> BuildDueDates(IEnumerable<LinkViewModel> applicationDueDates, CloaDueDate cloaDueDate, DateTime threeMonthDueDate, int designeeGroupId, string trainingDueDate, string seminarDueDate)
        {
            var dueItems = applicationDueDates
                .Union(
                [
                    BuildDueDateLink(threeMonthDueDate, cloaDueDate.PerformanceEvaluationDueDate, "Performance Evaluation", "PE"),
                    BuildDueDateLink(threeMonthDueDate, (trainingDueDate != null && trainingDueDate != "None" ) ? DateTime.Parse(trainingDueDate) : null, "Training", "TR"),
                    BuildDueDateLink(threeMonthDueDate, (seminarDueDate != null && seminarDueDate != "None" ) ? DateTime.Parse(seminarDueDate) : null, "Seminar", "SM"),
                    BuildDueDateLink(threeMonthDueDate, cloaDueDate.AnnualProfileUpdateDueDate, "Annual Request to Extend Expiration Date", "PU"),
                    BuildDueDateLink(threeMonthDueDate, cloaDueDate.SuspensionReleaseRequestDueDate, "Suspension Release Request", "SR"),
                    BuildDueDateLink(threeMonthDueDate, cloaDueDate.DirectObservationDueDate, "Direct Observation", "DO", cloaDueDate.WitnessingDueDate),
                ]).ToArray();

            dueItems = dueItems.Where(d => d.Value != "None").OrderBy(o => DateTime.Parse(o.Value)).ToArray();
            switch (designeeGroupId)
            {
                case (int)DesigneeGroupEnum.Manufacturing:
                    dueItems = dueItems.Where(d => d.Code != "SM").ToArray();
                    break;
                case (int)DesigneeGroupEnum.AFS:
                    dueItems = dueItems.Where(d => d.Code != "SM" && d.Code != "WT").ToArray();
                    break;
                case (int)DesigneeGroupEnum.AME:
                    dueItems = dueItems.Where(d => d.Code != "WT").ToArray();
                    break;
                case (int)DesigneeGroupEnum.Engineering:
                    if (dueItems.Count() == 0 && trainingDueDate != null)
                    {
                        dueItems = dueItems.Union(new List<LinkViewModel> { BuildDueDateLink(threeMonthDueDate, DateTime.Parse(trainingDueDate, CultureInfo.InvariantCulture), "Training", "TR") }).ToArray();
                        dueItems = dueItems.Where(d => d.Value != "None").OrderBy(o => DateTime.Parse(o.Value)).ToArray();
                    }
                    break;
            }

            return dueItems;
        }

        private static LinkViewModel BuildDueDateLink(DateTime threeMonthDueDate, DateTime? date1, string displayName, string code, DateTime? date2 = null)
        {
            var model = new LinkViewModel
            {
                DisplayName = displayName,
                Code = code,
                Value = "None",
                IsLegacyUrl = false
            };

            if (date1.HasValue)
            {
                model.Value = date1.Value <= threeMonthDueDate ? date1.DateToString() : "None";
                model.IsLegacyUrl = date1.Value < DateTime.Now.Date;
            }
            else if (date2.HasValue)
            {
                model.Value = date2 <= threeMonthDueDate ? date2.DateToString() : "None";
                model.IsLegacyUrl = date2 < DateTime.Now.Date;
            }

            return model;
        }


