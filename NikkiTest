import { ChangeDetectorRef, Component, OnInit, ViewChild } from '@angular/core';
import { NavigationExtras, Router } from '@angular/router';
import {
  ConfirmationService,
  LazyLoadEvent,
  SelectItem,
  MessageService as ToastService,
} from 'primeng/api';
import {
  ActivityPaperWork,
  BaseComponent,
  CryptoService,
  DesigneeTypeEnum,
  LookupService,
  PreApprovalRequestService,
  RequestListModel,
  UtilityService,
} from 'dms-web-shared';
import { AuthenticationService } from '../services/authentication.service';
import {
  FormBuilder,
  FormControl,
  FormGroup,
  Validators,
} from '@angular/forms';
import { Table } from 'primeng/table';
import { takeUntil } from 'rxjs/operators';
import { Popover } from 'primeng/popover';

@Component({
    selector: 'activitypaperwork',
    templateUrl: 'index.component.html',
    styleUrls: ['index.component.scss'],
    standalone: false
})
export class PreApprovalRequestIndexComponent
  extends BaseComponent
  implements OnInit
{
  preApprovals: ActivityPaperWork[] = [];
  postActivities: ActivityPaperWork[] = [];  
  activityPaperWork: ActivityPaperWork | undefined | null;

  displayDialogue = false;
  isManufacturingGroup = false;
  isAfsGroup = false;
  isOther = false;
  event: any;
  isSubmit = false;
  reasonId: number = 0;
  comments: string = '';
  cancelReasons: SelectItem[] = [];
  preApprovalFormGroup: FormGroup | undefined | null;
  isCancelSelectType: boolean = false;
  model: any;
  prLoading = false;
  poLoading = false;
  oneYearData = new FormControl(true);
  prLabel:string = 'Pre-approval Request(s)';
  poLabel:string = 'Post Activity Report(s)';
  designeeTypeId?:number;
  @ViewChild('dtPostActivities') postActivityTable: Table | undefined | null;
  @ViewChild('dtPreApproval') preApprovalTable: Table | undefined | null;
  prTotalRecords: number = 0;
  poTotalRecords: number = 0;
  prSummary?: string = '';
  poSummary?: string = '';
  preApprovalSearchCriteria: RequestListModel = new RequestListModel();
  postActivitySearchCriteria: RequestListModel = new RequestListModel();
  invalidMessages: Record<string, Map<string, string>> = 
  {
    'invalidReason': new Map().set('required', 'Please enter the reason.'),
    'reasonDropdown': new Map().set('required', 'Please select the reason.')
  }

  static buildForm(isCancelSelectType: boolean): FormGroup {
    return new FormBuilder().group({
      reasonText: isCancelSelectType
        ? new FormControl('')
        : new FormControl('', [Validators.required, Validators.maxLength(4000)]),
      reasonDropdown: isCancelSelectType
        ? new FormControl('', [Validators.required, Validators.maxLength(4000)])
        : new FormControl(''),
      otherReason: new FormControl('', []),
    });
  }

  static buildModel(form: FormGroup, model: any): any {
    model = new Object();
    model.reasonText = form.get('reasonText')
      ? form.get('reasonText')?.value
      : '';
    model.reasonDropdown = form.get('reasonDropdown')
      ? form.get('reasonDropdown')?.value
      : null;
    model.otherReason = form.get('otherReason')
      ? form.get('otherReason')?.value
      : '';
    return model;
  }

  constructor(
    private confirmationService: ConfirmationService,
    private router: Router,
    private authenticationService: AuthenticationService,
    private preApprovalRequestService: PreApprovalRequestService,
    private toastService: ToastService,
    public utilityService: UtilityService,
    private cryptoService: CryptoService,
    private lookupService: LookupService,
    private cd: ChangeDetectorRef
  ) {
    super();
  }

  async ngOnInit() {
    this.preApprovalSearchCriteria.applicationId = this.authenticationService.getApplicationId();
    this.designeeTypeId = this.authenticationService.getDesigneeTypeId();
    this.preApprovalSearchCriteria.isInternal = false;
    this.preApprovalSearchCriteria.isOneYear = true;
    this.postActivitySearchCriteria.applicationId = this.authenticationService.getApplicationId();
    this.postActivitySearchCriteria.isInternal = false;
    this.postActivitySearchCriteria.isOneYear = true;
    await this.lookupService.populateLookupData();
    this.setCancelType(this.designeeTypeId!);
    if(this.designeeTypeId == DesigneeTypeEnum.DCTOE){
      this.prLabel = 'Pre-Approval Request(s)';
      this.poLabel = 'Post-Activity Report(s)';
    }
    this.preApprovalFormGroup = PreApprovalRequestIndexComponent.buildForm(
      this.isCancelSelectType
    );
    this.preApprovalFormGroup
        .get('reasonDropdown')
        ?.valueChanges.pipe(takeUntil(this.destroying$)).subscribe((reason: number) => {
          if (reason === 6) {
            this.preApprovalFormGroup!
              .get('otherReason')
              ?.setValidators([Validators.required]);
            this.preApprovalFormGroup!
              .get('otherReason')
              ?.updateValueAndValidity();
            this.isOther = true;
          } else {
            this.preApprovalFormGroup!.get('otherReason')?.setValidators([]);
            this.preApprovalFormGroup!
              .get('otherReason')
              ?.updateValueAndValidity();
            this.isOther = false;
          }
        });
    
    this.cancelReasons = this.lookupService.getPreApprovalCancelReasons();
  }

  loadPreApprovals(event: any) {
    if (event) {
      this.preApprovalSearchCriteria.pageModel = event;
    }

    if (!this.preApprovalSearchCriteria.pageModel) {
      this.preApprovalSearchCriteria.pageModel = { filters: this.preApprovalTable?.filters, sortField: this.preApprovalTable?.sortField, sortOrder: this.preApprovalTable?.sortOrder } as LazyLoadEvent;
    }

    this.preApprovalRequestService.getPreApprovalList(this.preApprovalSearchCriteria)
      .pipe(takeUntil(this.destroying$)).subscribe({
        next: (d) => {
          this.prLoading = false;
          this.prTotalRecords = d.total;
          this.preApprovals = d.data;
          this.setPrSummary();
        },
        error: () => {
          this.toastService.add({ 
            key: 'dms', 
            severity: 'error', 
            summary: 'Error Message', 
            detail: 'Fetching Preapprovals failed.'});    
        }});
  }

  loadPostActivities(event: any) {
    this.poLoading = true;
    if (event) {
      this.postActivitySearchCriteria.pageModel = event;
    }

    if (!this.postActivitySearchCriteria.pageModel) {
      this.postActivitySearchCriteria.pageModel = { filters: this.postActivityTable?.filters, sortField: this.postActivityTable?.sortField, sortOrder: this.postActivityTable?.sortOrder } as LazyLoadEvent;
    }

    this.preApprovalRequestService.getPostActivityList(this.postActivitySearchCriteria)
      .pipe(takeUntil(this.destroying$))
      .subscribe({
        next: (d:any) => {
        this.poLoading = false;
        this.poTotalRecords = d.total;
        this.postActivities = d.data;
        this.setPoSummary();
        },
        error: () => {
          this.poLoading = false;
          this.toastService.add({ 
            key: 'dms', 
            severity: 'error', 
            summary: 'Error Message', 
            detail: 'Fetching Post-Activites failed.'}); 
        }});  
  }

  setPrSummary() {
    if (this.preApprovalSearchCriteria && this.preApprovalSearchCriteria.pageModel && this.prTotalRecords) {
        const toCount = (this.preApprovalSearchCriteria.pageModel.rows! + this.preApprovalSearchCriteria.pageModel.first!) < this.prTotalRecords ? (this.preApprovalSearchCriteria.pageModel.rows! + this.preApprovalSearchCriteria.pageModel.first!) : this.prTotalRecords;
        this.prSummary = `Showing ${(this.preApprovalSearchCriteria.pageModel.first! + 1).toLocaleString()} to ${toCount.toLocaleString()} of ${this.prTotalRecords.toLocaleString()} Pre-Approvals`;
    }
    else{
        this.prSummary = '';
    }
    this.cd.detectChanges();
  }

  setPoSummary() {
    if (this.postActivitySearchCriteria && this.postActivitySearchCriteria.pageModel && this.poTotalRecords) {
        const toCount = (this.postActivitySearchCriteria.pageModel.rows! + this.postActivitySearchCriteria.pageModel.first!) < this.prTotalRecords ? (this.postActivitySearchCriteria.pageModel.rows! + this.postActivitySearchCriteria.pageModel.first!) : this.poTotalRecords;
        this.poSummary = `Showing ${(this.postActivitySearchCriteria.pageModel.first! + 1).toLocaleString()} to ${toCount.toLocaleString()} of ${this.poTotalRecords.toLocaleString()} Post-Activites`;
    }
    else{
        this.poSummary = '';
    }
  }

  loadData() {
    this.preApprovalSearchCriteria.isOneYear = this.oneYearData.value as any;
    this.postActivitySearchCriteria.isOneYear = this.oneYearData.value as any;
    this.loadPreApprovals(null);
    this.loadPostActivities(null);
  }

  cancelPreApprovalRequest(event:any) {
    this.confirmationService.confirm({
      key: 'dms',
      icon: undefined,
      header: 'Confirm',
      message: 'Are you sure you want to cancel the pre-approval request?',
      acceptVisible: true,
      rejectVisible: true,
      acceptLabel: 'OK',
      acceptIcon: 'fa fa-check',
      rejectLabel: 'Cancel',
      rejectIcon: 'fa fa-home',
      accept: () => {
        if (this.isManufacturingGroup === false) {
          this.displayDialogue = true;
          this.event = event;
        } else {
          this.event = event;
          this.cancelPreApproval();
        }
      },
      reject: () => {}
    });
  }
  goToUrl(url: string) {
    const index = url.indexOf('?');
    const navigateUrl = index === -1 ? url : url.slice(0, index);
    const navigationExtras: NavigationExtras = {
      queryParams: this.utilityService.getQueryParams(url),
    };
    this.router.navigate([navigateUrl], navigationExtras);
  }
  cancelRequest() {
    this.preApprovalFormGroup?.markAllAsTouched();
    if (!(this.preApprovalFormGroup!.valid)) { return; }

    this.isSubmit = true;
    this.model = PreApprovalRequestIndexComponent.buildModel(
                    this.preApprovalFormGroup!, this.model);

    if (this.isCancelSelectType === false &&
      !(this.model.reasonText === '' ||
        this.model.reasonText === null ||
        this.model.reasonText === undefined)) {
      this.cancelPreApproval();
    }
    if (this.isCancelSelectType === true &&
      !(this.model.reasonDropdown === 0 ||
        this.model.reasonDropdown === null ||
        this.model.reasonDropdown === undefined)) {
          
      if (this.model.reasonDropdown === 6) {
        if (this.preApprovalFormGroup!.get('otherReason')?.valid) {
          this.cancelPreApproval();
        }
      } else {
        this.cancelPreApproval();
      }
    }
    if (this.isManufacturingGroup) {
      this.cancelPreApproval();
    }
    
  }
  cancelPreApproval() {
    this.model = PreApprovalRequestIndexComponent.buildModel(
      this.preApprovalFormGroup!,
      this.model
    );
    this.event.justificationForCancellation =
      this.isCancelSelectType === false
        ? this.model.reasonText
        : this.model.reasonDropdown === 6
        ? this.model.otherReason
        : null;
    this.event.cancellationTypeId = this.model.reasonDropdown;
    this.preApprovalRequestService.cancel(this.event).pipe(takeUntil(this.destroying$)).subscribe((result) => {
      if (result) {
        this.loadPreApprovals(null);
        this.toastService.add({
          key: 'dms',
          severity: 'success',
          summary: 'Success',
          detail: 'Preapproval request has been canceled successfully.',
        });
        this.preApprovalFormGroup?.reset();
      }
    });
    this.displayDialogue = false;
  }
  back() {
    this.router.navigate(['activity']);
  }
  closeDialog() {
    this.displayDialogue = false;
    this.preApprovalFormGroup?.reset();
  }
  cancel() {
    this.router.navigate(['/home']);
  }

  selectVersion(
    event: any,
    activityPaperWork: ActivityPaperWork,
    overlaypanel: Popover
  ) {
    this.activityPaperWork = activityPaperWork;
    overlaypanel.toggle(event);
  }

  async getPostActivityVersion(
    preApprovalRequestId: number,
    postActivityId: number,
    isAdminType: boolean
  ) {
    this.router.navigate([]);
    const designeeType = this.authenticationService.getDesigneeTypeId();
    let url = '';
    switch (designeeType) {
      case DesigneeTypeEnum.APD:
      case DesigneeTypeEnum.TCE:
      case DesigneeTypeEnum.DADE:
        url = `/postactivity/afs/group3/summary/${(await this.cryptoService.encrypt(postActivityId))}/${await this.cryptoService.encrypt(isAdminType)}?isVersion=${await this.cryptoService.encrypt(true)}`;
        break;
      case DesigneeTypeEnum.DCTOE:
        url = `/postactivity/aovgroups/${await this.cryptoService.encrypt(postActivityId)}?isVersion=${await this.cryptoService.encrypt(true)}`;
        break;
      default:
        url = `/postactivity/afsgroups/${(await this.cryptoService.encrypt(postActivityId))}?isVersion=${await this.cryptoService.encrypt(true)}`;
        break;
    }
    const index = url.indexOf('?');
    const navigateUrl = index === -1 ? url : url.slice(0, index);
    const navigationExtras: NavigationExtras = {
      queryParams: this.utilityService.getQueryParams(url),
    };
    this.router.navigate([navigateUrl], navigationExtras);
  }

  setCancelType(designeeTypeId: number) {
    switch (designeeTypeId) {
      case DesigneeTypeEnum.DME:
      case DesigneeTypeEnum.DPRE:
      case DesigneeTypeEnum.DART:
      case DesigneeTypeEnum.DADE:
      case DesigneeTypeEnum.APD:
      case DesigneeTypeEnum.TCE:
        this.isCancelSelectType = false;
        this.isAfsGroup = true;
        break;
      case DesigneeTypeEnum.DPE:
      case DesigneeTypeEnum.SAE:
      case DesigneeTypeEnum.ADMINPE:
        this.isCancelSelectType = true;
        this.isAfsGroup = true;
        break;
      case DesigneeTypeEnum.DMIR:
      case DesigneeTypeEnum.DARF:
        this.isManufacturingGroup = true;
        break;
    }
  }
}





