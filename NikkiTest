                recipients.append(secondary_list)
            
            server = smtplib.SMTP('smtp.wellpoint.com', 25)
            server.sendmail(sender_email, recipients, msg.as_string())
            server.quit()
            
            logging.info(f"Email notification sent: {status} to {primary_list}" + (f" (CC: {secondary_list})" if secondary_list else ""))
        except Exception as e:
            logging.warning(f"Failed to send email notification: {str(e)}")


class Execution:
    
    def __init__(self, snowflake, s3, gatekeeping):
        self.snowflake = snowflake
        self.s3 = s3
        self.gatekeeping = gatekeeping
    
    def processSqlTemplate(self):
        import hashlib
        from datetime import datetime
        
        master_config = self.gatekeeping.masterConfig
        source_from = self.gatekeeping.s3Path
        sql_content = self.s3.readFile(source_from)
        
        # Generate consistent EDL_RUN_ID for this execution
        current_ts = datetime.now()
        edl_run_id = hashlib.md5(str(current_ts).encode()).hexdigest()
        
        logging.info(f"DEBUG: Master config keys: {list(master_config.keys())}")
        logging.info(f"DEBUG: Master config values: {master_config}")
        logging.info(f"Generated EDL_RUN_ID: {edl_run_id}")
        
        # Generate timestamp parameters for S3 export path
        timestamp_folder = current_ts.strftime('%Y%m%d_%H%M%S')  # e.g., 20260915_143000
        timestamp_date = current_ts.strftime('%Y%m%d')  # e.g., 20260915
        
        parameters = {
            'PROCESS_ID': str(master_config.get('PROCESS_ID')),
            'PROCESS_NAME': master_config.get('PROCESS_NAME'),
            'STEP_ID': str(master_config.get('STEP_ID')),
            'STEP_NAME': master_config.get('STEP_NAME'),
            'SOURCE_FROM': master_config.get('SOURCE_FROM'),
            'EDL_RUN_ID': edl_run_id,
            'TIMESTAMP_FOLDER': timestamp_folder,
            'TIMESTAMP_DATE': timestamp_date
        }
        
        # Store run_id for later use in load log
        self.edl_run_id = edl_run_id
        
        source_tables_raw = master_config.get('SOURCE_TABLE_NAMES')
        if source_tables_raw:
            source_tables = json.loads(source_tables_raw) if isinstance(source_tables_raw, str) else source_tables_raw
            parameters.update(source_tables)
        
        dest_tables_raw = master_config.get('DESTINATION_TABLE_NAMES')
        if dest_tables_raw:
            dest_tables = json.loads(dest_tables_raw) if isinstance(dest_tables_raw, str) else dest_tables_raw
            parameters.update(dest_tables)
        
        return Template(sql_content).render(**parameters)
    
    def executeSql(self, sql_query):
        from datetime import datetime
        
        statement_count = sql_query.count(';')
        logging.info(f"{'='*80}\nEXECUTING SQL ({statement_count} statements)\n{'='*80}")
        
        # Print the rendered SQL query
        logging.info("="*80)
        logging.info("RENDERED SQL QUERY:")
        logging.info("="*80)
        logging.info(sql_query)
        logging.info("="*80)
        
        # Validate SQL is not empty
        if not sql_query or not sql_query.strip():
            raise ValueError("SQL query is empty after template rendering")
        
        logging.info(f"SQL Query Length: {len(sql_query)} characters")
        logging.info(f"SQL Query (first 500 chars): {sql_query[:500]}")
        
        master_config = self.gatekeeping.masterConfig
        execution_start_time = datetime.now()
        
        # Prepare load log data with consistent run_id from template processing
        load_log_data = {
            'load_log_table': 'LOAD_LOG_KEY',
            'run_id': getattr(self, 'edl_run_id', None),  # Use same run_id as SQL
            'process_id': str(master_config.get('PROCESS_ID', '0')),
            'process_name': master_config.get('PROCESS_NAME', 'UNKNOWN'),
            'step_id': str(master_config.get('STEP_ID', '0')),
            'step_name': master_config.get('STEP_NAME', 'SQL Execution'),
            'source': master_config.get('SOURCE', 'GENAISA'),
            'path': master_config.get('SOURCE_FROM', 'N/A'),
            'lob': master_config.get('LOB', 'COM'),
            'start_time': execution_start_time
        }
        
        try:
            # Execute SQL
            self.snowflake.execute(sql_query, fetch=False)
            
            # Extract row count from validation_counts temp table created by SQL
            record_count = 0
            try:
                result = self.snowflake.execute(
                    "SELECT row_count FROM temp_db.temp_schema.validation_counts", 
                    fetch=True
                )
                if result and len(result) > 0:
                    record_count = result[0].get('ROW_COUNT', 0)
                    logging.info(f"Extracted row count from validation_counts table: {record_count}")
            except Exception as count_error:
                logging.warning(f"Could not extract row count from validation_counts table: {str(count_error)}")
                record_count = 0
            
            # Insert success load log
            load_log_data['status'] = 'Completed'
            load_log_data['record_count'] = record_count
            batch_id = self.snowflake.insertLoadLog(load_log_data)
            
            logging.info(f"SQL executed successfully - Load log recorded with BATCHID={batch_id}, RECCNT={record_count}")
            
        except Exception as e:
            # Insert failure load log
            load_log_data['status'] = 'Failed'
            load_log_data['record_count'] = 0
            try:
                batch_id = self.snowflake.insertLoadLog(load_log_data)
                logging.error(f"SQL execution failed - Load log recorded with BATCHID={batch_id}")
            except Exception as log_error:
                logging.error(f"Failed to insert load log: {str(log_error)}")
            raise


class Stitching:
    
    def __init__(self, snowflake, s3, gatekeeping):
        self.snowflake = snowflake
        self.s3 = s3
        self.gatekeeping = gatekeeping
        self.stitchingConfig = None
    
    def loadStitchingConfig(self, gen_ai_sa_id):
        """Load stitching configuration from database (may return multiple rows)"""
        self.stitchingConfig = self.snowflake.getStitchingConfig(gen_ai_sa_id)
        
        if not self.stitchingConfig:
            raise ValueError(f"No stitching config found for GEN_AI_SA_ID: {gen_ai_sa_id}")
        
        logging.info(f"Stitching config loaded for GEN_AI_SA_ID: {gen_ai_sa_id} - {len(self.stitchingConfig)} config row(s) found")
    
    def listAllFiles(self, bucket, prefix):
        """List all files in S3 folder with pagination"""
        all_files = []
        continuation_token = None
        
        while True:
            response = self.s3.listObjects(bucket, prefix, continuation_token)
            
            if 'Contents' in response:
                # Filter out directory entries
                files = [obj for obj in response['Contents'] if not obj['Key'].endswith('/')]
                all_files.extend(files)
            
            if response.get('IsTruncated'):
                continuation_token = response.get('NextContinuationToken')
            else:
                break
        
        # Sort files by name to maintain proper order (e.g., a_0_1.txt, a_0_2.txt, a_1_0.txt)
        all_files.sort(key=lambda obj: obj['Key'])
        
        logging.info(f"Found {len(all_files)} files in s3://{bucket}/{prefix} (sorted by name)")
        return all_files
    
    def mergeFiles(self):
        """Main method to merge files based on configuration.
        Iterates over all stitching config rows for the GEN_AI_SA_ID."""
        configs = self.stitchingConfig
        logging.info(f"Processing {len(configs)} stitching config row(s)")
        for idx, config in enumerate(configs, start=1):
            logging.info(f"Processing stitching config row {idx}/{len(configs)}")
            self._mergeFilesForConfig(config)

    def _mergeFilesForConfig(self, config):
        """Merge files for a single stitching config row"""
        from datetime import datetime
        
        # Get configuration - normalize bucket names (no s3:// prefix) and folder paths
        src_bucket = config['SRC_S3_BUCKET'].replace('s3://', '').strip('/')
        src_folder = config['SRC_S3_FOLDER_PATH'].strip('/') + '/'
        dest_bucket = config['DEST_S3_BUCKET'].replace('s3://', '').strip('/')
        dest_folder = config['DEST_S3_FOLDER'].strip('/')
        file_format = config['INPUT_FILE_FORMAT']
        output_filename = config['OUT_PUT_FILE_NAME']
        header_template = config.get('OUT_PUT_FILE_HEADER')
        footer_template = config.get('OUT_PUT_FILE_FOOTER')
        # Treat 'NA' sentinel as not configured
        if header_template and header_template.strip().upper() == 'NA':
            header_template = None
        if footer_template and footer_template.strip().upper() == 'NA':
            footer_template = None
        size_split_req = config.get('SIZE_BASED_SPLIT_REQ', False)
        split_size_mb = config.get('SPLIT_SIZE_MB')
        
        # Get latest folder
        latest_folder = self.s3.getLatestFolder(src_bucket, src_folder)
        
        # List all files in latest folder
        all_files = self.listAllFiles(src_bucket, latest_folder)
        
        # Filter files by glob pattern (e.g., ANTHEM_Member_Enroll_*.txt)
        from fnmatch import fnmatch
        logging.info(f"Using file pattern: '{file_format}'")
        
        matching_files = [f for f in all_files if fnmatch(f['Key'].split('/')[-1], file_format)]
        
        if not matching_files:
            logging.warning(f"No files matching pattern '{file_format}' found in {latest_folder}")
            return
        
        logging.info(f"Found {len(matching_files)} matching files:")
        for f in matching_files:
            logging.info(f"  - {f['Key'].split('/')[-1]}")
        
        logging.info(f"Merging {len(matching_files)} files...")
        
        # Read and merge all files
        merged_content = b''
        for file_obj in matching_files:
            file_key = file_obj['Key']
            logging.info(f"Reading file: s3://{src_bucket}/{file_key}")
            file_content = self.s3.readFileBinary(src_bucket, file_key)
            merged_content += file_content
        
        # Decode and normalize line endings
        merged_text = merged_content.decode('utf-8')
        merged_text = merged_text.replace('\r\n', '\n').replace('\r', '\n').replace('\n', '\r\n')
        
        # Count rows (non-empty lines)
        row_count = len([line for line in merged_text.splitlines() if line.strip()])
        
        # Delimiter map - supports any {*_delimiter} placeholder from config
        delimiter_map = {
            'tab_delimiter':       '\t',
            'pipe_delimiter':      '|',
            'comma_delimiter':     ',',
            'semicolon_delimiter': ';',
            'caret_delimiter':     '^',
            'tilde_delimiter':     '~',
            'colon_delimiter':     ':',
        }

        def resolve_placeholders(text, row_count=None):
            import re
            # Replace known delimiters dynamically
            for key, char in delimiter_map.items():
                text = text.replace(f'{{{key}}}', char)
            # Warn on any unresolved {*_delimiter} placeholders
            unresolved = re.findall(r'\{[^}]*_delimiter\}', text)
            if unresolved:
                logging.warning(f"Unresolved delimiter placeholders: {unresolved}")
            # Replace other standard placeholders
            text = text.replace('{timestamp}', datetime.now().strftime("%Y%m%d%H%M%S"))
            if row_count is not None:
                text = text.replace('{row_count}', str(row_count))
            return text

        # Add header if configured
        final_content = ''
        if header_template:
            header = resolve_placeholders(header_template)
            final_content = header + "\r\n"
            logging.info(f"Added header: {header[:100]}...")
        
        # Add merged content
        final_content += merged_text.rstrip()
        
        # Add footer if configured
        if footer_template:
            footer = resolve_placeholders(footer_template, row_count=row_count)
            final_content += "\r\n" + footer
            logging.info(f"Added footer: {footer}")
        
        # Generate output filename with date format placeholders
        from datetime import datetime
        current_dt = datetime.now()
        timestamp_folder = current_dt.strftime("%Y%m%d_%H%M%S")
        
        # Replace various date format placeholders
        output_name = output_filename
        output_name = output_name.replace('{YYYYMMDD}', current_dt.strftime("%Y%m%d"))
        output_name = output_name.replace('{YYYMMDD}', current_dt.strftime("%Y%m%d"))  # Handle typo
        output_name = output_name.replace('{MMDDYYYY}', current_dt.strftime("%m%d%Y"))
        output_name = output_name.replace('{DDMMYYYY}', current_dt.strftime("%d%m%Y"))
        output_name = output_name.replace('{MMDDYY}', current_dt.strftime("%m%d%y"))
        output_name = output_name.replace('{DDMMYY}', current_dt.strftime("%d%m%y"))
        output_name = output_name.replace('{timestamp}', timestamp_folder)
        
        logging.info(f"Output filename: {output_filename} -> {output_name}")
        
        output_key = f"{dest_folder}/{timestamp_folder}/{output_name}"
        
        # Handle file splitting if required
        if size_split_req and split_size_mb:
            self.splitAndWriteFiles(dest_bucket, output_key, final_content, split_size_mb, header_template, footer_template)
        else:
            # Write single merged file
            self.s3.writeFileBinary(dest_bucket, output_key, final_content.encode('utf-8'))
            logging.info(f"Merged file written to: s3://{dest_bucket}/{output_key}")
        
        logging.info(f"Stitching completed successfully. Total rows: {row_count}")
    
    def splitAndWriteFiles(self, bucket, base_key, content, max_size_mb, header_template, footer_template):
        """Split large file into smaller chunks"""
        from datetime import datetime
        
        max_size_bytes = max_size_mb * 1024 * 1024
        lines = content.splitlines(keepends=True)
        
        part_num = 1
        current_chunk = []
        current_size = 0
        
        timestamp = datetime.now().strftime("%Y%m%d%H%M%S")
        
        for line in lines:
            line_size = len(line.encode('utf-8'))
            
            if current_size + line_size > max_size_bytes and current_chunk:
                # Write current chunk
                self.writeChunk(bucket, base_key, part_num, current_chunk, header_template, footer_template, timestamp)
                part_num += 1
                current_chunk = []
                current_size = 0
            
            current_chunk.append(line)
            current_size += line_size
        
        # Write remaining chunk
        if current_chunk:
            self.writeChunk(bucket, base_key, part_num, current_chunk, header_template, footer_template, timestamp)
        
        logging.info(f"File split into {part_num} parts")
    
    def writeChunk(self, bucket, base_key, part_num, lines, header_template, footer_template, timestamp):
        """Write a single chunk with optional header/footer"""
        import re
        delimiter_map = {
            'tab_delimiter':       '\t',
            'pipe_delimiter':      '|',
            'comma_delimiter':     ',',
            'semicolon_delimiter': ';',
            'caret_delimiter':     '^',
            'tilde_delimiter':     '~',
            'colon_delimiter':     ':',
        }

        def resolve_placeholders(text, row_count=None):
            for key, char in delimiter_map.items():
                text = text.replace(f'{{{key}}}', char)
            unresolved = re.findall(r'\{[^}]*_delimiter\}', text)
            if unresolved:
                logging.warning(f"Unresolved delimiter placeholders in chunk: {unresolved}")
            text = text.replace('{timestamp}', timestamp)
            if row_count is not None:
                text = text.replace('{row_count}', str(row_count))
            return text

        chunk_content = ''
        
        # Add header if configured
        if header_template:
            chunk_content = resolve_placeholders(header_template) + "\r\n"
        
        # Add lines
        chunk_content += ''.join(lines).rstrip()
        
        # Add footer if configured
        if footer_template:
            row_count = len([line for line in lines if line.strip()])
            chunk_content += "\r\n" + resolve_placeholders(footer_template, row_count=row_count)
        
        # Generate part filename
        base_name = base_key.rsplit('.', 1)
        if len(base_name) == 2:
            part_key = f"{base_name[0]}_part{part_num}.{base_name[1]}"
        else:
            part_key = f"{base_key}_part{part_num}"
        
        self.s3.writeFileBinary(bucket, part_key, chunk_content.encode('utf-8'))
        logging.info(f"Written part {part_num}: s3://{bucket}/{part_key}")


class Dispatch:
    
    def __init__(self, snowflake, gatekeeping):
        self.snowflake = snowflake
        self.gatekeeping = gatekeeping
        self.lambdaConfig = None
    
    def loadLambdaConfig(self, gen_ai_sa_id):
        """Load Lambda dispatch configuration from database (may return multiple rows)"""
        self.lambdaConfig = self.snowflake.getLambdaConfig(gen_ai_sa_id)
        
        if not self.lambdaConfig:
            raise ValueError(f"No Lambda config found for GEN_AI_SA_ID: {gen_ai_sa_id}")
        
        logging.info(f"Lambda config loaded for GEN_AI_SA_ID: {gen_ai_sa_id} - {len(self.lambdaConfig)} config row(s) found")
    
    def getRoutingFlag(self, config):
        """Query Snowflake table to get routing flag value for a given config row"""
        routing_table = config.get('ROUTING_FLAG_SOURCE_TABLE')
        routing_column = config.get('ROUTING_FLAG_COLUMN')
        
        # Treat 'NA' as NULL/not configured
        if not routing_table or not routing_column or routing_table == 'NA' or routing_column == 'NA':
            logging.warning("No routing flag configured, using primary destination")
            return None
        
        query = f"SELECT DISTINCT {routing_column} FROM {routing_table} LIMIT 1"
        results = self.snowflake.execute(query, fetch=True)
        
        if results and len(results) > 0:
            flag_value = results[0].get(routing_column)
            logging.info(f"Routing flag from {routing_table}.{routing_column}: {flag_value}")
            return flag_value
        
        logging.warning(f"No routing flag found in {routing_table}.{routing_column}")
        return None
    
    def invokeLambda(self):
        """Invoke Lambda function(s) for every config row associated with the GEN_AI_SA_ID"""
        import boto3
        import json
        
        configs = self.lambdaConfig
        lambda_client = boto3.client('lambda')
        all_responses = []
        
        logging.info(f"Processing {len(configs)} lambda config row(s)")
        for idx, config in enumerate(configs, start=1):
            logging.info(f"Processing lambda config row {idx}/{len(configs)}")
            responses = self._invokeLambdaForConfig(config, lambda_client)
            all_responses.extend(responses)
        
        return all_responses

    def _invokeLambdaForConfig(self, config, lambda_client):
        """Invoke Lambda function(s) for a single config row based on routing flag"""
        import json
        
        # Get routing flag
        routing_flag = self.getRoutingFlag(config)
        routing_flag_value = config.get('ROUTING_FLAG_VALUE')
        process_name = self.gatekeeping.masterConfig.get('PROCESS_NAME', 'UNKNOWN')
        
        # Determine destinations based on routing flag
        # If flag matches configured value, send to BOTH primary AND alternate
        # Otherwise, send to primary only
        send_to_alternate = (routing_flag == routing_flag_value)
        
        if send_to_alternate:
            logging.info(f"Routing flag matched ({routing_flag} == {routing_flag_value})")
            logging.info(f"Will send to PRIMARY + ALTERNATE destinations")
        else:
            logging.info(f"Routing flag not matched ({routing_flag} != {routing_flag_value})")
            logging.info(f"Will send to PRIMARY destination only")
        
        # Build Lambda payload for PRIMARY destination
        primary_payload = {
            "etl_stp_parms": {
                "src_s3_bucket": config['PRIMARY_SRC_S3_BUCKET'],
                "src_s3_path": config['PRIMARY_SRC_S3_PATH'],
                "dest_s3_bucket": config.get('PRIMARY_DEST_S3_BUCKET'),
                "dest_s3_path": config.get('PRIMARY_DEST_S3_PATH'),
                "arh_s3_bucket": config.get('LAMBDA_ARH_S3_BUCKET'),
                "arh_s3_path": config.get('LAMBDA_ARH_S3_PATH'),
                "process_name": process_name,
                "notiy_to": config.get('LAMBDA_NOTIFY_TO'),
                "is_deploy": config.get('LAMBDA_IS_DEPLOY', 'Y')
            }
        }
        
        # Add additional params if configured
        additional_params = config.get('LAMBDA_ADDITIONAL_PARAMS')
        if additional_params:
            if isinstance(additional_params, str):
                additional_params = json.loads(additional_params)
            primary_payload["etl_stp_parms"].update(additional_params)
        
        lambda_function_name = config['LAMBDA_FUNCTION_NAME']
        responses = []
        
        # Invoke Lambda for PRIMARY destination
        logging.info(f"Invoking Lambda for PRIMARY destination: {lambda_function_name}")
        logging.info(f"PRIMARY payload: {json.dumps(primary_payload, indent=2)}")
        
        primary_response = lambda_client.invoke(
            FunctionName=lambda_function_name,
            InvocationType='RequestResponse',
            Payload=json.dumps(primary_payload)
        )
        
        primary_response_payload = json.loads(primary_response['Payload'].read())
        primary_status = primary_response.get('StatusCode')
        
        logging.info(f"PRIMARY Lambda invocation completed. Status: {primary_status}")
        logging.info(f"PRIMARY response: {json.dumps(primary_response_payload, indent=2)}")
        
        # Check HTTP status code
        if primary_status != 200:
            raise Exception(f"PRIMARY Lambda invocation failed with HTTP status {primary_status}: {primary_response_payload}")
        
        # Check if Lambda function itself failed (errorMessage in response)
        if 'errorMessage' in primary_response_payload or 'errorType' in primary_response_payload:
            error_type = primary_response_payload.get('errorType', 'Unknown')
            error_msg = primary_response_payload.get('errorMessage', 'Unknown error')
            raise Exception(f"PRIMARY Lambda function failed with {error_type}: {error_msg}")
        
        responses.append({
            'destination': 'PRIMARY',
            'status': primary_status,
            'response': primary_response_payload
        })
        
        # Invoke Lambda for ALTERNATE destination if routing flag matched
        if send_to_alternate:
            alternate_payload = {
                "etl_stp_parms": {
                    "src_s3_bucket": config['PRIMARY_SRC_S3_BUCKET'],
                    "src_s3_path": config['PRIMARY_SRC_S3_PATH'],
                    "dest_s3_bucket": config.get('ALTERNATE_DEST_S3_BUCKET'),
                    "dest_s3_path": config.get('ALTERNATE_DEST_S3_PATH'),
                    "arh_s3_bucket": config.get('LAMBDA_ARH_S3_BUCKET'),
                    "arh_s3_path": config.get('LAMBDA_ARH_S3_PATH'),
                    "process_name": process_name,
                    "notiy_to": config.get('LAMBDA_NOTIFY_TO'),
                    "is_deploy": config.get('LAMBDA_IS_DEPLOY', 'Y')
                }
            }
            
            if additional_params:
                alternate_payload["etl_stp_parms"].update(additional_params)
            
            logging.info(f"Invoking Lambda for ALTERNATE destination: {lambda_function_name}")
            logging.info(f"ALTERNATE payload: {json.dumps(alternate_payload, indent=2)}")
            
            alternate_response = lambda_client.invoke(
                FunctionName=lambda_function_name,
                InvocationType='RequestResponse',
                Payload=json.dumps(alternate_payload)
            )
            
            alternate_response_payload = json.loads(alternate_response['Payload'].read())
            alternate_status = alternate_response.get('StatusCode')
            
            logging.info(f"ALTERNATE Lambda invocation completed. Status: {alternate_status}")
            logging.info(f"ALTERNATE response: {json.dumps(alternate_response_payload, indent=2)}")
            
            # Check HTTP status code
            if alternate_status != 200:
                raise Exception(f"ALTERNATE Lambda invocation failed with HTTP status {alternate_status}: {alternate_response_payload}")
            
            # Check if Lambda function itself failed (errorMessage in response)
            if 'errorMessage' in alternate_response_payload or 'errorType' in alternate_response_payload:
                error_type = alternate_response_payload.get('errorType', 'Unknown')
                error_msg = alternate_response_payload.get('errorMessage', 'Unknown error')
                raise Exception(f"ALTERNATE Lambda function failed with {error_type}: {error_msg}")
            
            responses.append({
                'destination': 'ALTERNATE',
                'status': alternate_status,
                'response': alternate_response_payload
            })
        
        return responses


class GenAiSa:
    
    def __init__(self, sql_filename):
        self.sqlFilename = sql_filename
        self.statusTracker = {
            'execution_status': None,
            'execution_start': None,
            'execution_end': None,
            'execution_error_cd': None,
            'execution_error_msg': None,
            'stitching_status': None,
            'stitching_start': None,
            'stitching_end': None,
            'stitching_error_cd': None,
            'stitching_error_msg': None,
            'dispatch_status': None,
            'dispatch_start': None,
            'dispatch_end': None,
            'dispatch_error_cd': None,
            'dispatch_error_msg': None,
            'final_status': None
        }
        
        self.snowflake = SnowflakeService()
        self.s3 = S3Service()
        self.gatekeeping = Gatekeeping(self.snowflake, self.s3)
        self.execution = Execution(self.snowflake, self.s3, self.gatekeeping)
        self.stitching = Stitching(self.snowflake, self.s3, self.gatekeeping)
        self.dispatch = Dispatch(self.snowflake, self.gatekeeping)
        
        logging.info(f"GenAiSa initialized for SQL file: {sql_filename}")
    
    def checkLastRunAndDetermineStep(self):
        """Check last audit trail and determine which step to run"""
        last_audit = self.snowflake.getLastAuditTrail(self.gatekeeping.genAiSaId)
        
        if not last_audit:
            logging.info("No previous audit trail found. Starting fresh execution.")
            return 'execution'
        
        final_status = last_audit.get('FINAL_STATUS')
        logging.info(f"Last run FINAL_STATUS: {final_status}")
        
        if final_status == 'FAILED':
            # Determine which step failed
            if last_audit.get('EXECUTION_REQ_STATUS') == 'FAILED':
                logging.info("Last run failed at EXECUTION step. Retrying EXECUTION.")
                return 'execution'
            elif last_audit.get('STITCHING_REQ_STATUS') == 'FAILED':
                logging.info("Last run failed at STITCHING step. Retrying STITCHING.")
                return 'stitching'
            elif last_audit.get('DISPATCH_REQ_STATUS') == 'FAILED':
                logging.info("Last run failed at DISPATCH step. Retrying DISPATCH.")
                return 'dispatch'
        
        logging.info("Last run was successful. Starting fresh execution.")
        return 'execution'
    
    def insertAuditTrail(self):
        """Upsert audit trail record with current status"""
        audit_data = {
            'gen_ai_sa_id': self.gatekeeping.genAiSaId,
            'executable_sql_file': self.gatekeeping.masterConfig.get('EXECUTABLE_SQL_FILE'),
            **self.statusTracker
        }
        
        # Get edl_run_id from execution phase if available (fresh run)
        edl_run_id = getattr(self.execution, 'edl_run_id', None) if hasattr(self, 'execution') else None
        
        # If not available, get it from last audit trail (re-run scenario)
        if not edl_run_id:
            last_audit = self.snowflake.getLastAuditTrail(self.gatekeeping.genAiSaId)
            if last_audit and last_audit.get('EDL_RUN_ID'):
                edl_run_id = last_audit.get('EDL_RUN_ID')
                logging.info(f"Using EDL_RUN_ID from last audit trail for re-run: {edl_run_id}")
            else:
                # Generate new one if still not available (shouldn't happen)
                import hashlib
                from datetime import datetime
                current_ts = datetime.now()
                edl_run_id = hashlib.md5(str(current_ts).encode()).hexdigest()
                logging.warning(f"No EDL_RUN_ID found, generated new one: {edl_run_id}")
        
        self.snowflake.upsertAuditTrail(audit_data, edl_run_id)
    
    def executePhase(self, phase_name, phase_func, error_code):
        """Execute a phase with standardized error handling and audit trail"""
        from datetime import datetime
        
        status_key = f'{phase_name.lower()}_status'
        start_key = f'{phase_name.lower()}_start'
        end_key = f'{phase_name.lower()}_end'
        error_cd_key = f'{phase_name.lower()}_error_cd'
        error_msg_key = f'{phase_name.lower()}_error_msg'
        
        self.statusTracker[start_key] = datetime.now()
        try:
            phase_func()
            self.statusTracker[status_key] = 'SUCCESS'
            self.statusTracker[end_key] = datetime.now()
            self.statusTracker['final_status'] = 'SUCCESS'
            self.insertAuditTrail()
            logging.info(f"{phase_name} phase completed successfully - Audit trail recorded")
        except Exception as e:
            self.statusTracker[status_key] = 'FAILED'
            self.statusTracker[end_key] = datetime.now()
            self.statusTracker[error_cd_key] = error_code
            self.statusTracker[error_msg_key] = str(e)[:5000]
            self.statusTracker['final_status'] = 'FAILED'
            self.insertAuditTrail()
            logging.error(f"{phase_name} phase failed - Audit trail recorded")
            raise
    
    def markPhaseNotRequired(self, phase_name):
        """Mark a phase as not required and insert audit trail"""
        status_key = f'{phase_name.lower()}_status'
        self.statusTracker[status_key] = 'NR'
        self.statusTracker['final_status'] = 'SUCCESS'
        self.insertAuditTrail()
        logging.info(f"{phase_name} phase not required - Audit trail recorded")
    
    def run(self):
        from datetime import datetime
        
        try:
            logging.info(f"{'='*80}\nStarting GenAiSa SQL Automation Pipeline\n{'='*80}")
            self.snowflake.connect()
            
            logging.info(f"GATEKEEPING PHASE\n{'-'*80}")
            try:
                self.gatekeeping.validateS3File(self.sqlFilename)
                self.gatekeeping.validateRunConfig()
                self.gatekeeping.validateDependentConfigs()
            except Exception as e:
                # Gatekeeping failure - insert audit trail if we have gen_ai_sa_id
                if self.gatekeeping.genAiSaId:
                    self.statusTracker['execution_status'] = 'FAILED'
                    self.statusTracker['execution_error_cd'] = 'GATEKEEP_ERR'
                    self.statusTracker['execution_error_msg'] = str(e)[:5000]
                    self.statusTracker['final_status'] = 'FAILED'
                    self.insertAuditTrail()
                raise
            
            # Check last run and determine starting step
            start_step = self.checkLastRunAndDetermineStep()
            
            # Get run config flags
            run_config = self.gatekeeping.runConfig
            execution_flg = run_config.get('EXECUTION_FLG', True)
            stitching_flg = run_config.get('STITCHING_FLG', False)
            dispatch_flg = run_config.get('DISPATCH_FLG', False)
            
            # EXECUTION PHASE
            if start_step == 'execution' and execution_flg:
                logging.info(f"{'='*80}\nEXECUTION PHASE\n{'-'*80}")
                
                def execute_phase():
                    sql_content = self.execution.processSqlTemplate()
                    self.execution.executeSql(sql_content)
                
                self.executePhase('EXECUTION', execute_phase, 'EXEC_ERR')
            elif not execution_flg:
                self.markPhaseNotRequired('EXECUTION')
            
            # STITCHING PHASE
            if start_step in ['execution', 'stitching'] and stitching_flg:
                logging.info(f"{'='*80}\nSTITCHING PHASE\n{'-'*80}")
                
                def stitching_phase():
                    self.stitching.loadStitchingConfig(self.gatekeeping.genAiSaId)
                    self.stitching.mergeFiles()
                
                self.executePhase('STITCHING', stitching_phase, 'STITCH_ERR')
            elif not stitching_flg:
                self.markPhaseNotRequired('STITCHING')
            
            # DISPATCH PHASE
            if start_step in ['execution', 'stitching', 'dispatch'] and dispatch_flg:
                logging.info(f"{'='*80}\nDISPATCH PHASE\n{'-'*80}")
                
                def dispatch_phase():
                    self.dispatch.loadLambdaConfig(self.gatekeeping.genAiSaId)
                    self.dispatch.invokeLambda()
                
                self.executePhase('DISPATCH', dispatch_phase, 'DISPATCH_ERR')
            elif not dispatch_flg:
                self.markPhaseNotRequired('DISPATCH')
            
            # All phases completed - audit trail already inserted after each phase
            logging.info(f"{'='*80}\nPipeline execution completed successfully\n{'='*80}")
            self.gatekeeping.sendNotification("SUCCEEDED")
            
            return {'status': 'SUCCESS', 'sql_filename': self.sqlFilename, 'gen_ai_sa_id': self.gatekeeping.genAiSaId,
                    'process_name': self.gatekeeping.masterConfig.get('PROCESS_NAME'), 'step_name': self.gatekeeping.masterConfig.get('STEP_NAME')}
            
        except Exception as e:
            error_msg = str(e)
            logging.error(f"{'='*80}\nPipeline execution failed: {error_msg}\n{'='*80}", exc_info=True)
            self.gatekeeping.sendNotification("FAILED", error_msg)
            raise


def main():
    try:
        parser = argparse.ArgumentParser(description='GenAiSa SQL Automation Pipeline')
        parser.add_argument('--SQL_FILENAME', type=str, required=True, help='SQL file name to execute')
        args = parser.parse_args()
        sql_filename = args.SQL_FILENAME
        
        logging.info(f"Starting GenAiSa job")
        logging.info(f"Processing SQL file: {sql_filename}")
        
        processor = GenAiSa(sql_filename)
        result = processor.run()
        
        logging.info(f"Job completed with status: {result['status']}")
        return result
        
    except Exception as e:
        logging.critical(f"Job failed with error: {str(e)}", exc_info=True)
        raise


if __name__ == '__main__':
    main()
