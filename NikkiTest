       public class AdminPeGenPreApprovalRequestService : AdminPePreApprovalRequestService
    {
                public AdminPeGenPreApprovalRequestService(
            DmsContext context,
            ITaskService taskService,
            IDocumentService documentService,
            IActivityService activityService,
            IMessageService messageService,
            ISharedService sharedService,
            ILookupService lookupService,
            IUserService userService)
            : base(context, taskService, documentService, activityService, messageService, sharedService, lookupService, userService)
        {
            _designeeType = (int)DesigneeTypeEnum.ADMINPEGEN;
        }

    public override PreApprovalRequestViewModel GetNew(int applicationId)
        {
            base.GetNew(applicationId);
            if (_preApprovalRequestViewModel?.TestCheckInformation != null && _cloa != null)
            {
                var cloaFunctionCodes = _context.CloaFunctionCodes
                    .Where(c => c.CloaId == _cloa.Id && c.Cloa.CloaStatusId == (int)CloaStatusEnum.Active)
                    .Include(c => c.FunctionCode)
                    .ToList();

                var requestedAuths = cloaFunctionCodes.Select(c => new FunctionCodeViewModel
                {
                    Id = c.FunctionCodeId,
                    FunctionCode = c.FunctionCode?.Name,
                    HasTypeRating = c.FunctionCode?.HasTypeRating ?? false,
                    IsAutomaticPreapproval = c.IsAutoPreApproval
                }).ToList();

                _preApprovalRequestViewModel.TestCheckInformation.RequestedAuthorizations = requestedAuths;

                if (_cloa.DesigneeInfo?.TypeId == (int)DesigneeTypeEnum.ADMINPEGEN || _cloa.DesigneeInfo?.TypeId == 31)
                {
                    var codeNames = requestedAuths.Select(a => a.FunctionCode ?? string.Empty).ToList();
                    var testCheckInfo = _preApprovalRequestViewModel.TestCheckInformation;

                    testCheckInfo.IsAdminPeGenFPE = codeNames.Any(c => c.Contains("FPE", StringComparison.OrdinalIgnoreCase));
                    testCheckInfo.IsAdminPeGenMCE = codeNames.Any(c => c.Contains("MCE", StringComparison.OrdinalIgnoreCase));
                    testCheckInfo.IsAdminPeGenGIE = codeNames.Any(c => c.Contains("GIE", StringComparison.OrdinalIgnoreCase));
                    testCheckInfo.IsAdminPeGenFIRE = codeNames.Any(c => c.Contains("FIRE", StringComparison.OrdinalIgnoreCase));
                    testCheckInfo.IsAdminPeGenBAE = codeNames.Any(c => c.Contains("BAE", StringComparison.OrdinalIgnoreCase));
                }
            }

            return _preApprovalRequestViewModel;
        }

        protected override bool IsAutoPreApproval(PreApprovalRequestViewModel model)
        {
            var testCheckInfo = model?.TestCheckInformation;
            if (testCheckInfo == null) return false;

            if (testCheckInfo.IsOtherAdminActivity.GetValueOrDefault())
            {
                return true;
            }

            if (model.ActivityLocation != null && model.ActivityLocation.IsOutsideOfficeDistrict.GetValueOrDefault())
            {
                return false;
            }

            var autoApprovedCloaCodes = GetAutoApprovedCloaCodes(model.ApplicationId.GetValueOrDefault());

            var selectedCodes = GetSelectedCodeLabels(testCheckInfo);
            if (!selectedCodes.Any()) return false;

            return selectedCodes.Any(selected =>
                autoApprovedCloaCodes.Any(approved => approved.Contains(selected, StringComparison.OrdinalIgnoreCase))
            );
        }

        public override PreApprovalRequestViewModel Save(PreApprovalRequestViewModel model)
        {
            var testCheckInfo = model?.TestCheckInformation;
            if (model != null && model.isSubmit && testCheckInfo != null)
            {
                var autoApprovedCloaCodes = GetAutoApprovedCloaCodes(model.ApplicationId.GetValueOrDefault());
                var classification = ClassifyFlags(testCheckInfo, autoApprovedCloaCodes);

                // MIXED SELECTION: Split into Record 1 (Auto) and Record 2 (Manual)
                if (classification.HasAuto && classification.HasManual)
                {
                    // Clean Record 1 to strictly hold Auto-Approved flags
                    ApplyFlags(testCheckInfo, classification.AutoFlags);

                    // Save Record 1
                    base.Save(model);

                    // Create & Save Record 2 (Manual Approval)
                    var manualModel = JsonConvert.DeserializeObject<PreApprovalRequestViewModel>(JsonConvert.SerializeObject(model));
                    manualModel.Id = 0;
                    manualModel.RequestInfo.ControlNumber = _activityService.GenerateTrackingNumber(model.DesigneeInfo.CloaId, (int)ProcessTypeEnum.PreApproval, null);

                    ApplyFlags(manualModel.TestCheckInformation, classification.ManualFlags);

                    base.Save(manualModel);
                    base.CreateTask(manualModel);

                    return model;
                }
            }

            return base.Save(model);
        }

        protected override void CompleteOrCreateTask(PreApprovalRequestViewModel model, bool canComplete)
        {
            // Standard execution handles auto-approval tasks for sanitized Record 1 and pure requests
            base.CompleteOrCreateTask(model, canComplete);
        }

        #region Helper Methods

        private List<string> GetAutoApprovedCloaCodes(int applicationId)
        {
            return _context.CloaFunctionCodes
                .Where(c => c.Cloa.ApplicationId == applicationId &&
                            c.Cloa.CloaStatusId == (int)CloaStatusEnum.Active &&
                            c.IsAutoPreApproval)
                .Select(c => c.FunctionCode.Name.ToUpper())
                .ToList();
        }

        private List<string> GetSelectedCodeLabels(PreApprovalTestCheckInformationViewModel testCheckInfo)
        {
            var selectedCodes = new List<string>();
            if (testCheckInfo.IsAdminPeGenFPE.GetValueOrDefault()) selectedCodes.Add("FPE");
            if (testCheckInfo.IsAdminPeGenMCE.GetValueOrDefault()) selectedCodes.Add("MCE");
            if (testCheckInfo.IsAdminPeGenGIE.GetValueOrDefault()) selectedCodes.Add("GIE");
            if (testCheckInfo.IsAdminPeGenFIRE.GetValueOrDefault()) selectedCodes.Add("FIRE");
            if (testCheckInfo.IsAdminPeGenBAE.GetValueOrDefault()) selectedCodes.Add("BAE");
            return selectedCodes;
        }

        private FlagClassification ClassifyFlags(PreApprovalTestCheckInformationViewModel testCheckInfo, List<string> autoApprovedCloaCodes)
        {
            var result = new FlagClassification();

            bool isFpe = testCheckInfo.IsAdminPeGenFPE.GetValueOrDefault();
            bool isMce = testCheckInfo.IsAdminPeGenMCE.GetValueOrDefault();
            bool isGie = testCheckInfo.IsAdminPeGenGIE.GetValueOrDefault();
            bool isFire = testCheckInfo.IsAdminPeGenFIRE.GetValueOrDefault();
            bool isBae = testCheckInfo.IsAdminPeGenBAE.GetValueOrDefault();

            result.AutoFlags.FPE = isFpe && autoApprovedCloaCodes.Any(c => c.Contains("FPE"));
            result.AutoFlags.MCE = isMce && autoApprovedCloaCodes.Any(c => c.Contains("MCE"));
            result.AutoFlags.GIE = isGie && autoApprovedCloaCodes.Any(c => c.Contains("GIE"));
            result.AutoFlags.FIRE = isFire && autoApprovedCloaCodes.Any(c => c.Contains("FIRE"));
            result.AutoFlags.BAE = isBae && autoApprovedCloaCodes.Any(c => c.Contains("BAE"));

            result.ManualFlags.FPE = isFpe && !result.AutoFlags.FPE;
            result.ManualFlags.MCE = isMce && !result.AutoFlags.MCE;
            result.ManualFlags.GIE = isGie && !result.AutoFlags.GIE;
            result.ManualFlags.FIRE = isFire && !result.AutoFlags.FIRE;
            result.ManualFlags.BAE = isBae && !result.AutoFlags.BAE;

            return result;
        }

        private void ApplyFlags(PreApprovalTestCheckInformationViewModel target, AdminPeGenFlags flags)
        {
            target.IsAdminPeGenFPE = flags.FPE;
            target.IsAdminPeGenMCE = flags.MCE;
            target.IsAdminPeGenGIE = flags.GIE;
            target.IsAdminPeGenFIRE = flags.FIRE;
            target.IsAdminPeGenBAE = flags.BAE;
        }

        private class FlagClassification
        {
            public AdminPeGenFlags AutoFlags { get; set; } = new AdminPeGenFlags();
            public AdminPeGenFlags ManualFlags { get; set; } = new AdminPeGenFlags();
            public bool HasAuto => AutoFlags.FPE || AutoFlags.MCE || AutoFlags.GIE || AutoFlags.FIRE || AutoFlags.BAE;
            public bool HasManual => ManualFlags.FPE || ManualFlags.MCE || ManualFlags.GIE || ManualFlags.FIRE || ManualFlags.BAE;
        }

        private class AdminPeGenFlags
        {
            public bool FPE { get; set; }
            public bool MCE { get; set; }
            public bool GIE { get; set; }
            public bool FIRE { get; set; }
            public bool BAE { get; set; }
        }

        #endregion
    }
