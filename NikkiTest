             COUNT_ACA_RECORDS = spark.sql('select * from rad_charts_mra').count()
        elif table == "rad_score_aca":
             a = f"""SCORE ACA"""
             COUNT_ACA_RECORDS = spark.sql('select * from rad_score_aca').count()

        msg['Subject'] = f"Load Successful for {a} : {file_date}"

        body = f"""**************Table {a} is loaded in Snowflake********\r\r\nRecord Count of {a} : {COUNT_ACA_RECORDS}\r\r\n******************************************************"""

        msg.attach(MIMEText(body, 'plain'))

        s = smtplib.SMTP('smtp.wellpoint.com:25')
        text = msg.as_string()
        s.sendmail(fromaddr, toaddr, text)
        s.quit()

    except Exception as err:

        print("<< Email Handler executuin has been failed >>>>")
        raise err

def main():

    print("<< main Executuin has been completed >>>>")
    try:
        env = sys.argv[1]
        table = sys.argv[2]
        email_handler(env,table)

    except Exception as err:
        print("<< main Executuin has been failed >>>>")
        raise err

if __name__ == '__main__':
