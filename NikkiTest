                                    Comments = a.Comments,
                                    ReviewComments = a.ActivityComment != null ? a.ActivityComment.ReviewedComments : null,
                                    ApplicationId = applicationId,
                                    CloaId = a.CloaId.GetValueOrDefault(0),
                                    NewCloaId = a.NewCloaId,
                                    ModifiedDate = a.ModifiedDate.GetValueOrDefault(a.CreatedDate),
                                    ModifiedBy = (a.AuditPrimaryLog != null && a.AuditPrimaryLog.ImpersonationLog != null) ? a.AuditPrimaryLog.ImpersonationLog.ImpersonatedUserId : a.ModifiedBy.GetValueOrDefault(a.CreatedBy),
                                    IsSeed = a.ActivityType.IsSeed,
                                    ActivityTypeId = a.ActivityTypeId,
                                    DesigneeTypeId = a.Cloa.Application.DesigneeTypeId.GetValueOrDefault(),
                                    Url = a.Module.RolePermissionDesigneeTypes.Any(r => r.LinkType.Code == "AL" && r.DesigneeTypeId == a.Cloa.Application.DesigneeTypeId)
                                        ? a.Module.RolePermissionDesigneeTypes.Where(r => r.LinkType.Code == "AL" && r.DesigneeTypeId == a.Cloa.Application.DesigneeTypeId).Select(r => r.Permission.UrlRouter).FirstOrDefault()
                                        : a.Module.RolePermissionDesigneeTypes.Where(r => r.LinkType.Code == "AL").Select(r => r.Permission.UrlRouter).FirstOrDefault(),
                                    CreatedById = designeeGroupId == (int)DesigneeGroupEnum.Manufacturing ? a.CreatedBy : a.ModifiedBy.GetValueOrDefault(a.CreatedBy),
                                    CreatedOrModifiedBy = designeeGroupId == (int)DesigneeGroupEnum.Manufacturing
                                                        ? a.CreatedUser.ToFullName()
                                                        : a.GetModifiedBy(),
