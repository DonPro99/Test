                preApprovalRequest.AfsPreApprovalRequest.IsCivilExperience = model.ApplicationInformation.IsCivilExperience != null
                                                                             ? model.ApplicationInformation.IsCivilExperience : null;
                preApprovalRequest.AfsPreApprovalRequest.IsMilitaryExperience = model.ApplicationInformation.IsMilitaryExperience != null
                                                                                ? model.ApplicationInformation.IsMilitaryExperience : null;
            }
            else
