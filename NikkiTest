    def execute(self, query, fetch=False):
        if not self.session:
            raise ConnectionError("Not connected to Snowflake")
        if fetch:
            # For queries that need results (SELECT statements)
            result = self.session.sql(query)
            return [row.as_dict() for row in result.collect()]
        else:
            # For execution without fetching results (DML/DDL)
            # Check if query contains EXECUTE IMMEDIATE - treat as single statement
            if 'EXECUTE IMMEDIATE' in query.upper():
                # Use cursor.execute for single EXECUTE IMMEDIATE block
                cursor = self.session.connection.cursor()
                try:
                    cursor.execute(query)
                finally:
                    cursor.close()
            else:
                # Use execute_string which handles both single and multi-statement SQL
                self.session.connection.execute_string(query)
            return None
    
    def getMasterConfig(self, sql_filename):
        # Extract filename from full S3 path if provided
        if sql_filename.startswith('s3://'):
