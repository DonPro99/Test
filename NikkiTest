-- All his Designation Location activities, to also check the multi-location theory
SELECT Id, ActivityTypeId, StatusId, CloaId, NewCloaId, CreatedDate
FROM DMS_mimic.dbo.Activity
WHERE DesignatorName LIKE '%Anorga%'
ORDER BY CreatedDate DESC;

