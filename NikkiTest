for env in develop sit uat preprod; do
  git merge-base --is-ancestor dfe566bbb origin/$env && s="SYNCED (has cleanup)" || s="not synced"
  left=0; while read f; do git cat-file -e origin/$env:"$f" 2>/dev/null && left=$((left+1)); done < pr_files.txt
  echo "== $env: $s | #12725 files still present: $left"
done
git log --merges --format='%h | %an | %ad | %s' --date=short -n 3 origin/preprod
