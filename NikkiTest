SELECT EDL_RUN_ID, COUNT(*), MIN(EDL_LOAD_DTM)
FROM U01_RAA.RAA_RAWZ.RAD_CIOXRT_ALL_LOB
WHERE INTERVENTION = 'DTVNTRT' AND BATCHID = '9'
GROUP BY EDL_RUN_ID ORDER BY 3;

SELECT COUNT(*) AS new_not_in_old FROM (
  SELECT * EXCLUDE (EDL_LOAD_DTM, EDL_RUN_ID) FROM U01_RAA.RAA_RAWZ.RAD_CIOXRT_ALL_LOB
  WHERE EDL_RUN_ID = 'f2ca1aed45fae4694493b1ae4af95fb1'
  MINUS
  SELECT * EXCLUDE (EDL_LOAD_DTM, EDL_RUN_ID) FROM U01_RAA.RAA_RAWZ.RAD_CIOXRT_ALL_LOB
  WHERE EDL_RUN_ID = '<latest old run id from query 1>'
);

SELECT COUNT(*) AS old_not_in_new FROM (
  SELECT * EXCLUDE (EDL_LOAD_DTM, EDL_RUN_ID) FROM U01_RAA.RAA_RAWZ.RAD_CIOXRT_ALL_LOB
  WHERE EDL_RUN_ID = '<latest old run id from query 1>'
  MINUS
  SELECT * EXCLUDE (EDL_LOAD_DTM, EDL_RUN_ID) FROM U01_RAA.RAA_RAWZ.RAD_CIOXRT_ALL_LOB
  WHERE EDL_RUN_ID = 'f2ca1aed45fae4694493b1ae4af95fb1'
);
