protected static void SaveDpeSaeFunctionCodes(PreApprovalRequestViewModel model, PreApprovalRequest preApprovalRequest)
{
    if (model.TestCheckInformation.SelectedRequestAuthorizations != null && model.TestCheckInformation.SelectedRequestAuthorizations.Count > 0)
    {
        preApprovalRequest.PreApprovalRequestFunctionCodes = model.TestCheckInformation.SelectedRequestAuthorizations.Select(f => new PreApprovalRequestFunctionCode
        {
            FunctionCodeId = f.Id,
            IsCloaFunctionCode = true,
            PreApprovalRequestFunctionCodeTypeRatings = f.SelectedTypeRatings != null && f.SelectedTypeRatings.Any() ? f.SelectedTypeRatings.Select(sf => new PreApprovalRequestFunctionCodeTypeRating
            {
                TypeRatingId = sf
            }).ToArray() : null
        }).ToList();
    }
    else if (model.TestCheckInformation.SelectedTemporaryAuthorizations != null && model.TestCheckInformation.SelectedTemporaryAuthorizations.Count > 0)
    {
        preApprovalRequest.PreApprovalRequestFunctionCodes = model.TestCheckInformation.SelectedTemporaryAuthorizations.Select(f => new PreApprovalRequestFunctionCode
        {
            FunctionCodeId = f.Id,
            IsCloaFunctionCode = false,
            PreApprovalRequestFunctionCodeTypeRatings = f.SelectedTypeRatings != null && f.SelectedTypeRatings.Any() ? f.SelectedTypeRatings.Select(sf => new PreApprovalRequestFunctionCodeTypeRating
            {
                TypeRatingId = sf
            }).ToArray() : null
        }).ToList();
    }
    else
    {
        preApprovalRequest.PreApprovalRequestFunctionCodes = new List<PreApprovalRequestFunctionCode>();
    }
}
