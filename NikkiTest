      def generateOutboundFile(finalDataFrame: DataFrame, fileInd:String) : Unit = {

        val Rvalue: String = spark.sql(s"""Select Substr(add_val4,1,2) as Aval from MBRPROV_DPLY_DATA""").first().get.getString(0)
        val maxRecordsPerFile = 500000L
        
        // Filter data for the current ONOFFSHORE value and add row number
        val filteredDF = finalDataFrame.filter(col("ONOFFSHORE")===fileInd).drop("ONOFFSHORE")
          .withColumn("row_num", row_number().over(Window.orderBy(lit(1))))
        
        val totalRecords = filteredDF.count()
        val numFiles = Math.ceil(totalRecords.toDouble / maxRecordsPerFile).toInt
        
        log.info(s"Creating $numFiles Datavantmbrprov file(s) for line of business - $lob with $totalRecords total records")
        
        // Generate files with sequential numbering
        for (fileNum <- 1 to numFiles) {
          val startRow = (fileNum - 1) * maxRecordsPerFile + 1
          val endRow = Math.min(fileNum * maxRecordsPerFile, totalRecords)
          
          val datavantmbrprovFilename: String = s"ELV_DTVNT_${Rvalue}_MRA_"+ fileInd + "_" + fileNum + "_" + dt.toString("yyyyMMdd") + dt.toString("HHmmss") + ".txt"
          val fileOutBoundLocation: String = outBoundLocation + "/datavantprov-retro-etl/" + dt.toString("yyyyMMdd_HHmmss") + "/" + datavantmbrprovFilename
          
          log.info(s"Writing file $fileNum of $numFiles: records $startRow to $endRow")
          
          filteredDF.filter(col("row_num") >= startRow && col("row_num") <= endRow).drop("row_num")
            .write
            .option("header", "true")
            .option("field_delimiter", "|")
            .option("empty_field_as_null", false)
            .option("null_if", "")
            .option("COMPRESSION", "NONE")
            .option("SINGLE", "True")
            .option("MAX_FILE_SIZE", 999999999)
            .mode("Overwrite")
            .csv(fileOutBoundLocation)
          
          log.info(s"Successfully created file: $datavantmbrprovFilename")
        }

