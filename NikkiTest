        CASE WHEN PLAN_BNFT_PKG_ID LIKE '8%' THEN 'GRS' ELSE 'IND' END AS BusinessUnit,
        TRIM(add_val5) AS LOB,
        CASE WHEN TRIM(INPAT_CD) = 'Y' THEN 'Inpatient' ELSE 'Outpatient' END AS FacilityType,
        TRIM(CHART_NPI) AS ProviderID,
        TRIM(CHART_SPCLTY_CD) AS ProviderSpecialty,
        TRIM(CHART_PROV_FRSTNM) AS ProviderFirstName,
        CASE WHEN CHART_PROV_LASTNM = '' THEN SUBSTR(chart_rndrg_grpnm, 1, 50)
             ELSE SUBSTR(CHART_PROV_LASTNM, 1, 50) END AS ProviderLastName,
        TRIM(CHART_PROV_ADRS1) AS ProviderAddress1,
        TRIM(CHART_PROV_ADRS2) AS ProviderAddress2,
        TRIM(CHART_PROV_CITY) AS ProviderCity,
        TRIM(CHART_PROV_ST) AS ProviderState,
        TRIM(CHART_PROV_ZIP) AS ProviderZip,
        TRIM(CHART_PROV_PHONE_NBR) AS ProviderPhone,
        TRIM(CHART_PROV_FAX) AS ProviderFax,
        '' AS ProviderContact,
        SUBSTR(chart_rndrg_grpnm, 1, 50) AS ProviderGroupName,
        CASE WHEN TRIM(ONOFFSHORE) = 'ONSHORE' THEN CONCAT(add_val4, '_1_', rundatetime)
             WHEN TRIM(ONOFFSHORE) = 'OFFSHORE' OR TRIM(ONOFFSHORE) = '' THEN CONCAT(add_val4, '_2_', rundatetime) END AS ProjectID,
        CASE WHEN TRIM(ONOFFSHORE) = 'ONSHORE' THEN CONCAT(add_val4, '_', ONOFFSHORE, '_', rundatetime)
             WHEN TRIM(ONOFFSHORE) = 'OFFSHORE' THEN CONCAT(add_val4, '_', ONOFFSHORE, '_', rundatetime) END AS ProjectName,
        '' AS CentralizedHandling,
        '' AS CentralizedHandlingCode,
        '' AS CentralizedHandlingContactName,
        '' AS CentralizedHandlingContactPhone,
        '' AS SpecialHandlingInstructions,
        TRIM(add_val3) AS ClientChartID,
        TRIM(add_val7) AS UserDefinedText1,
        TRIM(PLAN_BNFT_PKG_ID) AS UserDefinedText2,
        CONCAT(TRIM(CMPNY_RGN_NM), '_', TRIM(SUB_RGN_NM)) AS UserDefinedText3,
        'null' AS UserDefinedText4,
        '' AS UserDefinedCategory1,
        '' AS UserDefinedCategory2,
        '' AS UserDefinedDate1,
        '' AS UserDefinedDate2,
        '' AS UserDefinedNumber1,
        '' AS UserDefinedNumber2,
        TRIM(add_val9) AS BegDOS,
        '' AS EndDOS,
        TRIM(chart_taxid) AS GroupTIN,
        TRIM(PAT_ACCT_NBR) AS ClaimId,
        TRIM(MBR_ZIP) AS MemberZip,
        TRIM(MBR_SSNLST4) AS MemberSSN,
        TRIM(CHART_NPI) AS NPI,
        TRIM(MBI) AS MBI,
        TRIM(mbr_adrs1) AS MemberAddress1,
        SUBSTR(CONCAT(TRIM(mbr_adrs2), ' ', TRIM(mbr_adrs3)), 1, 50) AS MemberAddress2,
        '' AS MemberAlias,
        TRIM(MBR_CITY) AS MemberCity,
        TRIM(MBR_ADRS_ST) AS MemberState,
        TRIM(HC_ID) AS MemberInsuranceID,
        CASE WHEN TRIM(ONOFFSHORE) = 'OFFSHORE' THEN 1 ELSE 0 END AS OSEligible,
        ONOFFSHORE
    FROM temp_db.temp_schema.mbrprov_dply_data;

    -- Step 3c: CPL outbound file / RAD_DATAVANT_CHASE_CPL layout
    CREATE OR REPLACE TEMPORARY TABLE temp_db.temp_schema.cpl_file_data AS
    SELECT
        t.*,
        ROW_NUMBER() OVER (PARTITION BY t.ONOFFSHORE ORDER BY NULL) AS ROW_NUM
    FROM (
        SELECT
            CASE WHEN TRIM(ONOFFSHORE) = 'ONSHORE' THEN CONCAT(add_val4, '_1_', rundatetime)
                 ELSE CONCAT(add_val4, '_2_', rundatetime) END AS "ProjectID",
            TRIM(add_val3) AS "ClientChartID",
            SUBSTR(TRIM(chart_rndrg_grpnm), 1, 50) AS "RenderingProviderGroupName",
            TRIM(CHART_PROV_FRSTNM) AS "RenderingProviderFirstName",
            CASE WHEN TRIM(CHART_PROV_LASTNM) = '' THEN SUBSTR(TRIM(chart_rndrg_grpnm), 1, 50)
                 ELSE SUBSTR(TRIM(CHART_PROV_LASTNM), 1, 50) END AS "RenderingProviderLastName",
            TRIM(CHART_PROV_ADRS1) AS "SpecificLocationofCareAddress1",
            TRIM(CHART_PROV_ADRS2) AS "SpecificLocationofCareAddress2",
            TRIM(CHART_PROV_CITY) AS "SpecificLocationOfCareCity",
            TRIM(CHART_PROV_ST) AS "SpecificLocationofCareState",
            TRIM(CHART_PROV_ZIP) AS "SpecificLocationOfCareZIP",
            TO_VARCHAR(TO_DATE(clm_line_srvc_strt_dt, 'DDMONYYYY'), 'MM/DD/YYYY') AS "SpecificDOS",
            '' AS "ClaimNumber",
            TRIM(PAT_ACCT_NBR) AS "AccountNumber",
            '' AS "LocationCode",
            '' AS "SupplementalNPI",
            '' AS "SupplementalNPISpecialtyCode",
            '' AS "HMO_PPOFlag",
            TRIM(CHART_PROV_PHONE_NBR) AS "SpecificLocationOfCarePhone",
            ONOFFSHORE
        FROM temp_db.temp_schema.cpl_dply_data
    ) t;

    -- Step 4a: File-name prefix value R = SUBSTR(add_val4, 1, 2) (first row, as in source)
    SELECT SUBSTR(add_val4, 1, 2) INTO mbrprov_r_value
    FROM temp_db.temp_schema.mbrprov_dply_data
    LIMIT 1;

    SELECT SUBSTR(add_val4, 1, 2) INTO cpl_r_value
    FROM temp_db.temp_schema.cpl_dply_data
    LIMIT 1;

    -- Scala string interpolation renders a NULL value as the text 'null'
    mbrprov_r_value := COALESCE(mbrprov_r_value, 'null');
    cpl_r_value := COALESCE(cpl_r_value, 'null');

    -- Step 4b: CPL FTP_To_Vndr flag (informational only; SFTP is handled by the existing CFX step)
    SELECT ADD_VAL8 INTO cpl_ftp_to_vendor
    FROM (
        SELECT DISTINCT ADD_VAL8
        FROM temp_db.temp_schema.cpl_dply_data
        WHERE UPPER(TRIM(ADD_COL8)) = 'FTP_TO_VNDR'
    )
    LIMIT 1;

    cpl_ftp_to_vendor := COALESCE(cpl_ftp_to_vendor, 'N');

    -- Step 4c: Determine file indicators to export.
    -- Source: if > 1 distinct non-empty ONOFFSHORE -> ONSHORE then OFFSHORE;
    --         otherwise -> the (first) distinct ONOFFSHORE value.
    SELECT COUNT(DISTINCT ONOFFSHORE) INTO mbrprov_file_cnt
    FROM temp_db.temp_schema.mbrprov_file_data
    WHERE LENGTH(ONOFFSHORE) > 0;

    CREATE OR REPLACE TEMPORARY TABLE temp_db.temp_schema.mbrprov_file_ind (seq INTEGER, file_ind VARCHAR);

    IF (mbrprov_file_cnt > 1) THEN
        INSERT INTO temp_db.temp_schema.mbrprov_file_ind (seq, file_ind)
        SELECT DISTINCT 1, ONOFFSHORE FROM temp_db.temp_schema.mbrprov_file_data WHERE ONOFFSHORE = 'ONSHORE'
        UNION ALL
        SELECT DISTINCT 2, ONOFFSHORE FROM temp_db.temp_schema.mbrprov_file_data WHERE ONOFFSHORE = 'OFFSHORE';
    ELSE
        INSERT INTO temp_db.temp_schema.mbrprov_file_ind (seq, file_ind)
        SELECT 1, ONOFFSHORE
        FROM (SELECT DISTINCT ONOFFSHORE FROM temp_db.temp_schema.mbrprov_file_data)
        LIMIT 1;
    END IF;

    SELECT COUNT(DISTINCT ONOFFSHORE) INTO cpl_file_cnt
    FROM temp_db.temp_schema.cpl_file_data
    WHERE LENGTH(ONOFFSHORE) > 0;

    CREATE OR REPLACE TEMPORARY TABLE temp_db.temp_schema.cpl_file_ind (seq INTEGER, file_ind VARCHAR);

    IF (cpl_file_cnt > 1) THEN
        INSERT INTO temp_db.temp_schema.cpl_file_ind (seq, file_ind)
        SELECT DISTINCT 1, ONOFFSHORE FROM temp_db.temp_schema.cpl_file_data WHERE ONOFFSHORE = 'ONSHORE'
        UNION ALL
        SELECT DISTINCT 2, ONOFFSHORE FROM temp_db.temp_schema.cpl_file_data WHERE ONOFFSHORE = 'OFFSHORE';
    ELSE
        INSERT INTO temp_db.temp_schema.cpl_file_ind (seq, file_ind)
        SELECT 1, ONOFFSHORE
        FROM (SELECT DISTINCT ONOFFSHORE FROM temp_db.temp_schema.cpl_file_data)
        LIMIT 1;
    END IF;

    -- ========================================================================
    -- SECTION 6: DATA VALIDATION
    -- ========================================================================
    
    -- Step 5: Create validation counts table for Python to query
    -- row_count     = MbrProv outbound rows (reccnt logged to load_log_key in source)
    -- stage_count   = de-duplicated deploy/charts join rows feeding the outputs
    --                 (source audit vs. deploy reccnt was commented out; deploy_rec_cnt is informational)
    CREATE OR REPLACE TEMPORARY TABLE temp_db.temp_schema.validation_counts AS
    SELECT 
        (SELECT COUNT(*) FROM temp_db.temp_schema.mbrprov_file_data) AS row_count,
        (SELECT COUNT(*) FROM temp_db.temp_schema.mbrprov_dply_data) AS stage_count,
        (SELECT COUNT(*) FROM U01_RAA.RAA_RAWZ.RAD_CIOXRT_ALL_LOB WHERE EDL_RUN_ID = :edl_run_id) AS duplicate_count,
        (SELECT COUNT(*) FROM temp_db.temp_schema.cpl_file_data) AS cpl_row_count,
        (SELECT COUNT(*) FROM U01_RAA.RAA_RAWZ.RAD_DATAVANT_CHASE_CPL WHERE EDL_RUN_ID = :edl_run_id) AS cpl_duplicate_count,
        :deploy_rec_cnt AS deploy_rec_cnt,
        :batch_id AS batch_id,
        :cpl_ftp_to_vendor AS cpl_ftp_to_vendor;
    
    -- NOTE: Validation logic is handled in Python layer
    -- Python will query validation_counts table and raise errors if:
    --   - row_count > stage_count (data integrity issue)
    --   - duplicate_count > 0 (idempotency check)
    --   - row_count = 0 (no data to process)

    -- ========================================================================
    -- SECTION 7: DATA PERSISTENCE
    -- ========================================================================
    
    -- Step 6a: Insert into RAD_CIOXRT_ALL_LOB
    INSERT INTO U01_RAA.RAA_RAWZ.RAD_CIOXRT_ALL_LOB (
        EDL_LOAD_DTM,
        EDL_RUN_ID,
        EDL_SCRTY_LVL_CD,
        EDL_LOB_CD,
        EDL_EXTRNL_LOAD_CD,
        EDL_SOR_CD,
        ContractNumber,
        MemberId,
        MemberHIC,
        MemberFirstName,
        MemberLastName,
        MemberGender,
        MemberDOB,
        Source,
        BusinessUnit,
        FacilityType,
        ProviderID,
        ProviderSpecialty,
        ProviderFirstName,
        ProviderLastName,
        ProviderAddress1,
        ProviderAddress2,
        ProviderCity,
        ProviderState,
        ProviderZip,
        ProviderPhone,
        ProviderFax,
        ProviderContact,
        ProviderGroupName,
        ProjectID,
        ProjectName,
        CentralizedHandling,
        CentralizedHandlingCode,
        CentralizedHandlingContactName,
        CentralizedHandlingContactPhone,
        SpecialHandlingInstructions,
        ClientChartID,
        UserDefinedText1,
        UserDefinedText2,
        UserDefinedText3,
        UserDefinedText4,
        UserDefinedCategory1,
        UserDefinedCategory2,
        UserDefinedDate1,
        UserDefinedDate2,
        UserDefinedNumber1,
        UserDefinedNumber2,
        BegDOS,
        EndDOS,
        GroupTIN,
        ClaimId,
        MemberZip,
        MemberSSN,
        NPI,
        MBI,
        MemberAddress1,
        MemberAddress2,
        MemberAlias,
        MemberCity,
        MemberState,
        MemberInsuranceID,
        INTERVENTION,
        LOB,
        BATCHID,
        OSELIGIBLE
    )
    SELECT
        CURRENT_TIMESTAMP() AS EDL_LOAD_DTM,
        :edl_run_id AS EDL_RUN_ID,
        'NA' AS EDL_SCRTY_LVL_CD,
        :lob AS EDL_LOB_CD,
        'NA' AS EDL_EXTRNL_LOAD_CD,
        CASE
            WHEN :lob LIKE 'MEDICAID%' THEN '1104'
            WHEN :lob LIKE 'MCR%' THEN '1104'
            WHEN :lob LIKE 'MCAID%' THEN '1104'
            ELSE '9'
        END AS EDL_SOR_CD,
        ContractNumber,
        MemberId,
        MemberHIC,
        MemberFirstName,
        MemberLastName,
        MemberGender,
        MemberDOB,
        Source,
        BusinessUnit,
        FacilityType,
        ProviderID,
        ProviderSpecialty,
        ProviderFirstName,
        ProviderLastName,
        ProviderAddress1,
        ProviderAddress2,
        ProviderCity,
        ProviderState,
        ProviderZip,
        ProviderPhone,
        ProviderFax,
        ProviderContact,
        ProviderGroupName,
        ProjectID,
        ProjectName,
        CentralizedHandling,
        CentralizedHandlingCode,
        CentralizedHandlingContactName,
        CentralizedHandlingContactPhone,
        SpecialHandlingInstructions,
        ClientChartID,
        UserDefinedText1,
        UserDefinedText2,
        UserDefinedText3,
        UserDefinedText4,
        UserDefinedCategory1,
        UserDefinedCategory2,
        UserDefinedDate1,
        UserDefinedDate2,
        UserDefinedNumber1,
        UserDefinedNumber2,
        BegDOS,
        EndDOS,
        GroupTIN,
        ClaimId,
        MemberZip,
        MemberSSN,
        NPI,
        MBI,
        MemberAddress1,
        MemberAddress2,
        MemberAlias,
