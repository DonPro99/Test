def get_latest_date_folder_prefix(bucket_name, prefix):
    objects = list(s3_resource.Bucket(bucket_name).objects.filter(Prefix=prefix))
    objects.sort(key=lambda o: o.last_modified)
    print(objects[-1].key)
    latest_date_str = objects[-1].key.replace(prefix, '').split('/', 1)[0]
    print("latest_date_str " + latest_date_str)
    final_prefix = prefix+latest_date_str+"/"
    return final_prefix

def get_file_count(src_bucket_name,src_file_name):
    response = s3.get_object(Bucket=src_bucket_name,Key=src_file_name)
    line_count = 0
    for line in response['Body'].iter_lines():
        line_count += 1
    return line_count

def send_ftp_notification(etl_name,receiver_email,is_deploy="N",deply_file_name="",outfile="",deply_cnt=0, out_cnt=0, cfx_bucket="",cfx_path=""):

    sender_email = f"FTP-Notification-{etl_name}-AWS@carelon.com"
    host="smtp.wellpoint.com"
    message = MIMEMultipart("alternative")
    message["Subject"] = f'FTP Sucessful for {etl_name}-{date.today()}'
    message["From"] = sender_email
    message["To"] = receiver_email

    text_deploy = f"""
    ******** {etl_name} Summary ********
    {''.join(outfile)}

    Deploy file name is: {deply_file_name}
    Record count of file is: {deply_cnt}

    Action: upload to CFX Bucket path: {cfx_bucket}{cfx_path}
    *****************************************
    """
    text_no_deploy = f"""
    ******** {etl_name} Summary ********
    {''.join(outfile)}

    Action: upload to S3 Bucket: f'{cfx_bucket}/{cfx_path}'
    *****************************************
    """

    if is_deploy=="Y":
        part1 = MIMEText(text_deploy, "plain")
    else:
        part1 = MIMEText(text_no_deploy,"plain")

    message.attach(part1)

    try:
        server = smtplib.SMTP(host)
        server.set_debuglevel(False)
        server.sendmail(sender_email, receiver_email.split(','), message.as_string())
    except Exception as ex:
        print(f'failed with error {ex}')

def archive_files(src_s3_bucket, final_prefix, archv_s3_bucket, archv_s3_path,extraArgs):
    for file in s3.list_objects(Bucket=src_s3_bucket, Prefix=final_prefix)['Contents']:
        print(f'inloop files is: {file}')
        copy_source = {'Bucket': src_s3_bucket, 'Key': file['Key']}
        destKey = final_prefix.split('/')[-2]+"/"
        fn = file['Key'].split('/')[-1]
        s3_resource.meta.client.copy(CopySource= copy_source,Bucket = archv_s3_bucket,Key=archv_s3_path + destKey+fn, ExtraArgs = extraArgs)
    print(f"***** All latest Files have been archieved to '{archv_s3_path}' Successfully *****")       


