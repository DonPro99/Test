import { RouterModule, Routes } from '@angular/router';
import { NgModule } from '@angular/core';

import { PreApprovalRequestComponent } from './preapprovalrequest.component';
import { AfsPreApprovalRequestComponent } from './afspreapprovalrequest.component';
import { PostActivityComponent } from './postactivity/postactivity.component';
import { GeographicExpansionRequestComponent } from '../shared/geographicexpansionrequest.component';
import { AfsSummaryComponent } from './afssummary.component';
import { AfsPostActivityComponent } from './postactivity/afspostactivity.component';
import { PostActivityVersionsCompareComponent } from './postactivity/afspostactivityversioncomparision.component';
import { AuthenticationGuard } from '../security/authentication.guard';
import { AuthorizationGuard } from '../auth/authorization.guard';
import { AfsGrp3PostActivityVersionComparisionComponent } from './postactivity/afs-grp3-post-activity-version-comparision.component';
import { PostActivityDataResolver } from '../resolvers/post-activity-data.resolver';
import { AfsGroup3PoSummaryComponent } from './postactivity/afs-group3-po-summary.component';
import { PoIndexComponent } from './postactivity/afsgroups/index.component';
import { OktaAuthGuard } from '@okta/okta-angular';
import { PoAovIndexComponent } from './postactivity/aovgroups/index.component';
import { AovGrpPostActivityVersionComparisonComponent } from './postactivity/aovgroups/aov-grp-post-activity-version-comparison.component';

const routes: Routes = [
  { path: 'preapprovalrequest/evaluate/:preApprovalRequestId', component: PreApprovalRequestComponent, canActivate: [OktaAuthGuard, AuthenticationGuard, AuthorizationGuard], data: { permissions: ['INTPREP'] } },
  { path: 'performanceresult/:preApprovalRequestId', component: PostActivityComponent, canActivate: [OktaAuthGuard, AuthenticationGuard, AuthorizationGuard], data: { permissions: ['INTPRP'] } },
  { path: 'geographicalexpansionrequest/:preApprovalRequestId/:userOfficeRoleId', component: GeographicExpansionRequestComponent, canActivate: [OktaAuthGuard, AuthenticationGuard, AuthorizationGuard], data: { permissions: ['INTPRAGECP'] } },
  { path: 'preapprovalrequest/afs/evaluate/:preApprovalRequestId', component: AfsPreApprovalRequestComponent, canActivate: [OktaAuthGuard, AuthenticationGuard, AuthorizationGuard], data: { permissions: ['INTPRAEP'] } },
  { path: 'preapprovalrequest/afs/summary/:preApprovalRequestId', component: AfsSummaryComponent, canActivate: [OktaAuthGuard, AuthenticationGuard, AuthorizationGuard], data: { permissions: ['INTPRASP'] } },
  { path: 'postactivity/afs/:preApprovalRequestId', component: AfsPostActivityComponent, canActivate: [OktaAuthGuard, AuthenticationGuard, AuthorizationGuard], data: { permissions: ['INTPOAEP'] } },
  { path: 'postactivity/afs/:preApprovalRequestId/:postActivityId', component: AfsPostActivityComponent, canActivate: [OktaAuthGuard, AuthenticationGuard, AuthorizationGuard], data: { permissions: ['INTPOAVP'] } },
  { path: 'afspostactivityversioncomparision/versions/:postActivityId', component: PostActivityVersionsCompareComponent, canActivate: [OktaAuthGuard, AuthenticationGuard, AuthorizationGuard], data: { permissions: ['INTPOAVCP'] } },
  { path: 'afs/postactivity/versions/:postActivityId', component: AfsGrp3PostActivityVersionComparisionComponent, canActivate: [OktaAuthGuard, AuthenticationGuard] },
  {
    path: 'postactivity/group3/summary/:postActivityId/:isAdmin/:highlightChanges/:showMenu',
    pathMatch: 'full',
    canActivate: [OktaAuthGuard, AuthenticationGuard],
    resolve: {
      postActivity: PostActivityDataResolver
    },
    component: AfsGroup3PoSummaryComponent,
    data: { permissions: ['EXTGR3PRSMRY'] }
  },
  {
    path: 'postactivity/afsgroups/:postActivityId/:isAdmin/:cAction',
    pathMatch: 'full',
    canActivate: [OktaAuthGuard, AuthenticationGuard],
    resolve: {
      postActivity: PostActivityDataResolver,
    },
    component: PoIndexComponent,
    data: { permissions: ['EXTGR3PRSMRY'] },
  },
  {
    path: 'postactivity/aovgroups/:postActivityId/:cAction',
    pathMatch: 'full',
    canActivate: [OktaAuthGuard, AuthenticationGuard],
    resolve: {
      postActivity: PostActivityDataResolver,
    },
    component: PoAovIndexComponent,
    data: { permissions: ['INTAOVPOSMRY'] },
  },
  {
    path: 'preapprovalrequest/aov/summary/:preApprovalRequestId',
    canActivate: [OktaAuthGuard, AuthenticationGuard, AuthorizationGuard],
    component: PreApprovalRequestComponent,  
    data: { permissions: ['INTAOVPRSMRY'] },
  },
  { 
    path: 'aov/postactivity/versions/:postActivityId', 
    component: AovGrpPostActivityVersionComparisonComponent, 
    canActivate: [OktaAuthGuard, AuthenticationGuard],
     data: { permissions: ['INTPOAOVVCP'] },
   },

];


@NgModule({
  imports: [RouterModule.forChild(routes)],
  exports: [RouterModule],
})
export class PreApprovalRequestRoutingModule { }
