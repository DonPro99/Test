        columns_list = [col.strip() for col in columns_list]

    target_table_name = f"{raadatabase}.{table_name}"

    client = boto3.client('secretsmanager', region_name=region_name)
    secretsConfig = client.get_secret_value(SecretId=f"{env}{secret_path}")
    secret_dict = eval(secretsConfig['SecretString'])

    # RBICA-13935: use key-pair auth (pem_private_key) instead of sfPassword.
    raw_pem_bytes = secret_dict['raa_private_key'].encode('utf-8')
    p_key = serialization.load_pem_private_key(raw_pem_bytes, password=None)
    pkb = p_key.private_bytes(
        encoding=serialization.Encoding.PEM,
        format=serialization.PrivateFormat.PKCS8,
        encryption_algorithm=serialization.NoEncryption()
    )
    pkb = pkb.decode("UTF-8")
    pkb = re.sub("-*(BEGIN|END) PRIVATE KEY-*\n", "", pkb).replace("\n", "")

    snowflake_options = {
        "sfURL": f"{secret_dict['account']}.snowflakecomputing.com:443",
        "sfUser": secret_dict['raa_user'],
        "pem_private_key": pkb,
        "sfRole": secret_dict['raa_role'],
        "sfWarehouse": warehouse,
        "sfDatabase": usedatabase,
        "sfSchema": sf_schema
    }
    # --- END MODIFIED ---

    print(f"====================={target_table_name}==============================")


    file_paths = get_matching_files_from_s3(s3_file_path, file_name, step)

    loaded_files = [path.split("/")[-1] for path in file_paths]

    print(f"====================={loaded_files}==============================")

    latest_batch_id = get_latest_batch_id(snowflake_options, target_table_name)
    batch_id = latest_batch_id + 1



    combined_df = None

    logger.info("Running Load for {step}: InProgress")
    for file_path in file_paths:
        print(f"-+-+-+-+-+-+{file_path}-+-+-+-+")
        df = read_source_file(file_path, delimiter, file_format, schema_name, file_name, run_id, columns_list)

        if combined_df is None:
            combined_df = df
        else:
            combined_df = combined_df.union(df)

    if combined_df is not None:
        try:
            load_data_to_snowflake(combined_df, snowflake_options, target_table_name, schema_name, load_mode, today_date, process, batch_id)
            archive_s3_source_files(s3_file_path, s3_archive_file_path, loaded_files)
            files_string = '\n'.join(loaded_files)
            body_email = f"""
           Hello,

