< # =============================================================================
< # RADV-specific processing function --- Akhil Feb 2026
< # =============================================================================
< run_radv_intervention() {
<   local one_intervention="$1"
<   local INT_LOWER=$(echo "$one_intervention" | tr '[:upper:]' '[:lower:]')
<   local INT_UPPER=$(echo "$one_intervention" | tr '[:lower:]' '[:upper:]')
<   local LOB_LOWER=$(echo "$LOB" | tr '[:upper:]' '[:lower:]')
<   
<   LOG_MESG "------------------------------------------------------------"
<   LOG_MESG "Starting RADV deploy run for INTERVENTION=${INT_UPPER}; LOB=${LOB}"
<   
<   # Pattern now searches across all LOBs within rv (ACA, MCAID, MCARE)
<   # Format: deply_<int>_rv_<lob>_<date>.sas7bdat
<   PATTERN="deply_${INT_LOWER}*_rv_*_*.sas7bdat"
<   
<   # If specific LOB provided (not RADV), filter by that LOB
<   if [[ "$LOB_LOWER" != "radv" ]]; then
<     PATTERN="deply_${INT_LOWER}*_rv_${LOB_LOWER}_*.sas7bdat"
<   fi
<   
<   LATEST_FILE=$(ls -1t ${SAS_DEPLOY_LOC}/${PATTERN} 2>/dev/null | head -n 1)
<   
<   if [[ -z "$LATEST_FILE" ]]; then
<     LOG_MESG "No dataset found for ${PATTERN}, skipping..."
<     return 0
<   fi
<   
<   FILENAME=$(basename "$LATEST_FILE")
<   
<   # Parse filename dynamically
<   # Remove .sas7bdat extension
<   BASENAME="${FILENAME%.sas7bdat}"
<   
<   # Split by underscore
<   IFS="_" read -ra PARTS <<< "$BASENAME"
<   
<   # Extract date (last part)
<   RUN_DT="${PARTS[-1]}"
<   
<   # Extract actual LOB from filename (second to last part) - THIS IS THE KEY CHANGE
<   LOB_FROM_FILE="${PARTS[-2]}"
<   LOB_FROM_FILE_UPPER=$(echo "$LOB_FROM_FILE" | tr '[:lower:]' '[:upper:]')
<   
<   # Extract LINE (rv - third from last)
<   LINE_F="${PARTS[-3]}"
<   LINE_UP=$(echo "$LINE_F" | tr '[:lower:]' '[:upper:]')
<   
<   # Extract intervention (everything between "deply_" and "_rv_")
<   # This handles both "cioxrt" and "vrtxrt_ooa" formats
<   INT_PARTS=("${PARTS[@]:1:$((${#PARTS[@]}-4))}")
<   INT_FROM_FILE=$(IFS="_"; echo "${INT_PARTS[*]}")
<   INT_FROM_FILE_UPPER=$(echo "$INT_FROM_FILE" | tr '[:lower:]' '[:upper:]')
<   
<   DATASET_NAME="${BASENAME}"
<   
<   RADV_LOG_FILE="${LOG_PATH}/${DATASET_NAME}_$(date +%Y%m%d_%H%M%S).log"
<   
<   # CRITICAL FIX: Use LOB_FROM_FILE_UPPER instead of LINE_UP for output filename
<   TXT_OUTPUT="/hcaaapck/backup/IT/${SAS_ENV}/work/DEPLOY_${INT_FROM_FILE_UPPER}_RADV_${LOB_FROM_FILE_UPPER}_${RUN_DT}.txt"
<   
<   RADV_SCRIPT="/hcaaapck/backup/IT/SIT/code/dynamic_radv.sas"
<   INTERVENTION="$INT_FROM_FILE_UPPER"
<   
<   export LINE="$LINE_UP"
<   export SAS_DATASET_NAME="$DATASET_NAME"
<   export SAS_DATASET_LOCATION="$SAS_DEPLOY_LOC"
<   export SAS_WORK_LOCATION="/hcaaapck/backup/IT/${SAS_ENV}/work"
<   export ARCHIVE_LOCATION="$SAS_OUT_LOC"
<   export RUN_DT
<   
<   LOG_MESG ">>> Processing $DATASET_NAME"
<   LOG_MESG ">>> Intervention extracted: $INT_FROM_FILE_UPPER"
<   LOG_MESG ">>> LOB from file: $LOB_FROM_FILE_UPPER"
<   LOG_MESG ">>> Output: $(basename "$TXT_OUTPUT")"
<   
<   /sasconfig/scripts/sassubmit \
<     -gridsubmitpgm "$RADV_SCRIPT" \
<     -gridwaitresults \
<     -gridsasopts "(
<       -log $RADV_LOG_FILE
<       -set LINE $LINE
<       -set LOB $LOB_FROM_FILE
<       -set INTERVENTION $INT_FROM_FILE_UPPER
<       -set SAS_DATASET_NAME $SAS_DATASET_NAME
<       -set SAS_DATASET_LOCATION $SAS_DATASET_LOCATION
<       -set SAS_WORK_LOCATION $SAS_WORK_LOCATION
<       -set ARCHIVE_LOCATION $ARCHIVE_LOCATION
<       -set RUN_DT $RUN_DT
<     )"
<   
<   if [ $? -eq 0 ]; then
<     LOG_MESG "SAS export completed successfully."
<     LOG_MESG "Archiving $FILENAME"
<     mv "$LATEST_FILE" "$SAS_OUT_LOC"
<     
<     if [ -f "$TXT_OUTPUT" ]; then
<       LOG_MESG "Initiating SFTP of ${TXT_OUTPUT}"
<       ${SAS_HOME}/raa_inbound_pgp_sftp_notify.sh "$TXT_OUTPUT"
<       if [ $? -eq 0 ]; then
<         LOG_MESG "SFTP completed successfully."
<         return 0
<       else
<         LOG_MESG "WARNING: SFTP failed for RADV intervention."
<         return 1
<       fi
<     else
<       LOG_MESG "ERROR: Output file not found: $TXT_OUTPUT"
<       return 1
<     fi
<   else
<     LOG_MESG "SAS export failed. Not archiving the dataset or SFTP'ing the file."
<     return 1
<   fi
< }
