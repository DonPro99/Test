import { Component, Input, OnChanges, OnInit, SimpleChanges } from '@angular/core';
import { PlanningPageService } from '../services/planningpage.service';
import { ManagementInfoLinksModel } from '../models/planningpage/managementinfolinks';
import { BaseComponent, DesigneeTypeEnum, LinkViewModel, OfficeEnum, UtilityService } from 'dms-web-shared';
import { NavigationExtras, Router } from '@angular/router';
import { TokenStorageService } from '../services/tokenstorage.service';
import { DesigneeInfoModel } from '../models/planningpage/designeeinfo';
import { ConfirmationService } from 'primeng/api';
import { takeUntil } from 'rxjs/operators';

@Component({
    selector: 'app-managementinformationlinks',
    templateUrl: './managementinformationlinks.component.html',
    styleUrls: ['./managementinformationlinks.component.scss'],
    standalone: false
})
export class ManagementinformationlinksComponent extends BaseComponent implements OnInit, OnChanges {

  @Input() designeeInfo: DesigneeInfoModel | undefined;
  @Input() roleId: number | undefined;
  @Input() isLinked: boolean = false;
  @Input() selected = false;
  managementInfoLinksModel: ManagementInfoLinksModel | undefined;

  constructor(private router: Router,
    private utilityService: UtilityService,
    private storageService: TokenStorageService,
    private confirmationService: ConfirmationService,
    private planningPageService: PlanningPageService) { super(); }

  ngOnInit() {
    const currentOfficeId = this.storageService.getCurrentOffice();
    const userofficeroleId = this.storageService.getCurrentUserOfficeRole();
    this.planningPageService.managementInformationLinks(this.designeeInfo?.applicationId!, this.roleId!, this.designeeInfo!.isMyDesignee!, currentOfficeId, userofficeroleId!).pipe(takeUntil(this.destroying$)).subscribe(d => {
      this.managementInfoLinksModel = d;
    });
  }

  ngOnChanges(changes: SimpleChanges) {
    if ((changes['designeeInfo'] && !changes['designeeInfo'].firstChange && this.selected === true) ||
    (changes['selected'] && !changes['selected'].firstChange && this.selected === true)){
      this.ngOnInit();
    }
  }

  navigateToUrl(item: LinkViewModel) {
    if (item.code === 'IDT' && this.designeeInfo?.office?.id === OfficeEnum.AFG970 && this.designeeInfo.type?.id == DesigneeTypeEnum.SAE) {
      this.confirmationService.confirm({
        key: 'dms',
        icon: undefined,
        header: 'Message',
        message: 'This designee cannot be transferred to another office as an SAE. Please contact the policy office, AFS-650, for further guidance.',
        acceptVisible: true,
        acceptLabel:  'Ok',
        acceptIcon: 'fa fa-check',
        rejectVisible: false,
        accept: () => { }
      });
    } else {
      if (item.code == 'SEF' && this.isLinked) {
        item.url = `${item.url}?isLink=${this.isLinked}`;
      }
      const index = item.url?.indexOf('?');
      const navigateUrl = index === -1 ? item.url : item.url?.slice(0, index);
      const navigationExtras: NavigationExtras = {
        queryParams: this.utilityService.getQueryParams(item.url!)
      };
      this.router.navigate([navigateUrl], navigationExtras);
    }
  }
}
