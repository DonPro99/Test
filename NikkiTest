    def insertLoadLog(self, load_log_data):
        """Insert load log entry for SQL execution tracking"""
        import hashlib
        from datetime import datetime
        
        current_ts = datetime.now()
        # Use provided run_id if available, otherwise generate new one
        run_id = load_log_data.get('run_id')
        if not run_id:
            run_id = hashlib.md5(str(current_ts).encode()).hexdigest()
        
        # Generate batch_id if not provided
        batch_id = load_log_data.get('batch_id')
        if not batch_id:
            # Get max batch_id for this process and increment
            max_batch_query = f"""
            SELECT COALESCE(MAX(BATCHID), 0) + 1 AS next_batch
            FROM {load_log_data.get('load_log_table', 'LOAD_LOG_KEY')}
            WHERE PROCESSID = '{load_log_data.get('process_id')}'
            """
            result = self.execute(max_batch_query, fetch=True)
            batch_id = result[0]['NEXT_BATCH'] if result else 1
        
        query = f"""
        INSERT INTO {load_log_data.get('load_log_table', 'LOAD_LOG_KEY')} (
            EDL_LOAD_DTM, EDL_RUN_ID, EDL_SCRTY_LVL_CD, EDL_LOB_CD,
            EDL_EXTRNL_LOAD_CD, EDL_SOR_CD, ID, BATCHID, SOURCE,
            PATH, RECCNT, PROCESSNAME, PROCESSID, STEP, STEPID,
            STATUS, CREATEDATETIME, ENDDATETIME
        ) VALUES (
            CURRENT_TIMESTAMP(),
            '{run_id}',
            'NA',
            '{load_log_data.get('lob', 'COM')}',
            'I',
            '9',
            '{run_id}',
            {batch_id},
            '{load_log_data.get('source', 'GENAISA')}',
            '{load_log_data.get('path', 'N/A')}',
            {load_log_data.get('record_count', 0)},
            '{load_log_data.get('process_name', 'UNKNOWN')}',
            '{load_log_data.get('process_id', '0')}',
            '{load_log_data.get('step_name', 'SQL Execution')}',
            '{load_log_data.get('step_id', '0')}',
            '{load_log_data.get('status', 'Completed')}',
            '{load_log_data.get('start_time', current_ts)}',
            CURRENT_TIMESTAMP()
        )
        """
        
        self.execute(query, fetch=False)
        logging.info(f"Load log inserted: BATCHID={batch_id}, STATUS={load_log_data.get('status')}, RECCNT={load_log_data.get('record_count', 0)}")
