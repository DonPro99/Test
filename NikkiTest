import { ChangeDetectorRef, Component, OnInit, ViewChild, ViewEncapsulation } from '@angular/core';
import { ActivatedRoute, NavigationExtras, Router } from '@angular/router';
import { Location } from '@angular/common';
import {
  ActionButton, ActivityRequestStatusEnum,
  BaseComponent,
  ButtonActionsEnum,
  CategoryEnum,
  CryptoService,
  DesigneeTypeEnum,
  LookupService,
  PreApprovalRequestInfoModel,
  PreApprovalRequestService,
  PreApprovalTabEnum,
  UtilityService
} from 'dms-web-shared';
import { Title } from '@angular/platform-browser';
import { ApdIndexComponent } from './apd-index.component';
import { DadeIndexComponent } from './dade-index.component';
import { TceIndexComponent } from './tce-index.component';
import { MessageService as ToastService } from 'primeng/api';
import { AuthenticationService } from '../../services/authentication.service';
import { Observable, Subscriber } from 'rxjs';
import { ConfirmationService } from 'primeng/api';
import { takeUntil } from 'rxjs/operators';

@Component({
    selector: "pr-index",
    templateUrl: "./index.component.html",
    styleUrls: ["./index.component.scss"],
    encapsulation: ViewEncapsulation.None,
    standalone: false
})
export class IndexComponent extends BaseComponent implements OnInit {
  designeeTypeId: number = 0;
  data: PreApprovalRequestInfoModel | undefined | null;
  activeIndex: number = 0;
  props: any;
  isAdmin: boolean = false;
  isAutoPreApproval: boolean = false;

  @ViewChild("active") index:
    | ApdIndexComponent
    | DadeIndexComponent
    | TceIndexComponent | undefined | null;

  get isDisabled() {
    return (
      this.data!.requestInfo?.activityStatus?.id ===
        ActivityRequestStatusEnum.Completed ||
      this.data!.requestInfo?.activityStatus?.id ===
        ActivityRequestStatusEnum.Canceled ||
      this.data!.requestInfo?.activityStatus?.id ===
        ActivityRequestStatusEnum.Denied
    );
  }

  get canPrint() {
    return this.activeIndex === this.props.tabCount - 1; // should be the last tab
  }

  get canCopy() {
    const isPreApproval = !!this.data!.requestInfo?.activityStatus?.id;
    if (this.data!.requestInfo?.submittedDate) {
      let tmpSubmittedDate = this.data!.requestInfo.submittedDate.replace(
        "AM",
        ""
      );
      tmpSubmittedDate = tmpSubmittedDate.replace("PM", "");
      const submittedDate = new Date(tmpSubmittedDate);
      const year = submittedDate.getFullYear() + 1;
      const submittedDateWithYr = new Date(
        year,
        submittedDate.getMonth(),
        submittedDate.getDate()
      );
      const isWithinYear = submittedDateWithYr > new Date();
      return isPreApproval && isWithinYear;
    } else {
      return isPreApproval;
    }
  }

  isAutoPreapproval(model: any): Observable<boolean> {
      return new Observable((observer) => {
      if (model.id === 0) {
        const prevIsSubmit = model.isSubmit;
        model.isSubmit = false;

        this.service.saveAfsPreApprovalRequest(model).pipe(takeUntil(this.destroying$)).subscribe(
          (result) => {
            model.id = result.id;
            model.isSubmit = prevIsSubmit;
            this.service.checkAutoPreapproval(model).pipe(takeUntil(this.destroying$)).subscribe((r) => {
              observer.next(r);
              observer.complete();
            });
        })
      } else {
        this.service.checkAutoPreapproval(model).pipe(takeUntil(this.destroying$)).subscribe((r) => {
          observer.next(r);
          observer.complete();
        });
      }
    });
  }

  constructor(
    private titleService: Title,
    private lookupService: LookupService,
    private service: PreApprovalRequestService,
    private authenticationService: AuthenticationService,
    private route: ActivatedRoute,
    private router: Router,
    private util: UtilityService,
    private ref: ChangeDetectorRef,
    private confirmationService: ConfirmationService,
    private toastService: ToastService,
    private location: Location,
    private cryptoService: CryptoService
  ) {
    super();
    this.props = {
      title: "Pre Approval Request",
      tabCount: 0,
      buttons: [],
      acceptLabel: "Yes",
      acceptVisible: true,
      rejectLabel: "No",
      rejectVisible: true,
    };
    this.activeIndex = -1;
    this.titleService.setTitle(this.props.title);
    this.isAdmin = false;
  }

  async ngOnInit() {
    this.designeeTypeId = +this.route.snapshot.data['designeeTypeId'];
    
    this.isAdmin = this.util.toBoolean(
      await this.cryptoService.decrypt(this.route.snapshot.queryParams["isAdmin"])
    );
    await this.lookupService.populateLookupData();

    const preApprovalRequest$ = this.route.snapshot.data['preApprovalRequest'];
    
    preApprovalRequest$.pipe(takeUntil(this.destroying$)).subscribe(async (data: any) => {
      this.data = data;
      this.configure();
    });
  }

  setConfig($event:any) {
    this.props.title = $event.title;
    this.titleService.setTitle(this.props.title);
    this.activeIndex = 0; // reset to first tab
    this.props.tabCount = $event.tabCount;
    this.ref.detectChanges(); // angular doesn't like resetting values in ngOnInit from child components
  }

  getActionButtons(): ActionButton[] {
    const buttons = this.lookupService.getActionButtons();
    buttons.splice(
      2,
      0,
      new ActionButton("Print", "Print", "print", true, false, 5, "fa fa-print")
    );
    buttons.splice(
      3,
      0,
      new ActionButton("Copy", "Copy", "copy", true, false, 6, "fa fa-copy")
    );
    buttons.splice(
      3,
      0,
      new ActionButton(
        "Continue",
        "Continue",
        "continue",
        true,
        false,
        7,
        "fa fa-arrow-right"
      )
    );
    return buttons;
  }

  configure() {
    this.props.buttons = [].concat((this.getActionButtons() as any));
    this.activeIndex = 0;
    this.setActionButtons();
    if (this.isDisabled) {
      this.index!.form!.disable();
    }
  }

  buttonClick(eventKey: string) {
    const saveData = this.updateModel();
    switch (eventKey) {
      case ButtonActionsEnum.Save:
        const handle = this.saveRequest(saveData).subscribe();
        break;
      case ButtonActionsEnum.Print:
        window.print();
        break;
      case ButtonActionsEnum.Copy:
        this.copyPreApproval();
        break;
      case ButtonActionsEnum.Continue:
        this.index!.showTabError(this.activeIndex);
        this.saveRequest(saveData).pipe(takeUntil(this.destroying$)).subscribe(() => {
          // goto next tab
          const nextTabIndex =
            this.activeIndex !== this.props.tabCount // if it is not the last tab
              ? this.activeIndex + 1 // move to next
              : this.activeIndex; // stay at current index
          this.setActiveIndex(nextTabIndex);
        });
        break;
      case ButtonActionsEnum.Submit:
        this.activeIndex = this.props.tabCount - 1;
        this.index!.showTabError(this.props.tabCount - 2);
        this.util.markFormGroupTouched(this.index!.form!);
        if (this.index!.form!.invalid) {
          return;
        }

        // submit routine
        saveData.isSubmit = true;
        if (!saveData.isApproved) {
          this.isAutoPreapproval(saveData).pipe(takeUntil(this.destroying$)).subscribe(v => {
          if (v) {
            this.saveRequest(saveData).pipe(takeUntil(this.destroying$)).subscribe();
          } else {
            this.confirmationService.confirm({
              key: 'dms',
              icon: undefined,
              header: "Pre-Approval Submit Message",
              acceptVisible: true,
              rejectVisible: true,
              acceptLabel: "Continue",
              rejectLabel: "Cancel",
              rejectIcon: 'fa fa-times',
              acceptIcon: 'fa fa-check',
              message:
                "This Pre-Approval will require FAA authorization before proceeding. You will receive a message after Pre-Approval request is reviewed.",
              accept: () => {
                this.saveRequest(saveData).pipe(takeUntil(this.destroying$)).subscribe();
              },
            });
          }
                      
        });
        } else {
          this.saveRequest(saveData).pipe(takeUntil(this.destroying$)).subscribe();
        }
        break;
      case ButtonActionsEnum.Cancel:
        this.goToHomePage();
        break;
      case ButtonActionsEnum.Back:
        this.goToActionsPage();
        break;
    }
  }

  setActiveIndex($event: number) {
    this.activeIndex = $event;
    this.setActionButtons();
    // To make sure pre-approval request is available before using upload functionality
    if (this.index?.props?.headers[this.activeIndex] === PreApprovalTabEnum.uploadTab 
        && !this.index!.pr!.id ) {
      const saveData = this.updateModel();
      this.saveRequest(saveData).pipe(takeUntil(this.destroying$)).subscribe();
    }
  }

  onPreApprovalChange() {
    this.confirmationService.confirm({
      key: 'dms',
      icon: undefined,
      header: "New PreApproval Message",
      acceptVisible: true,
      rejectVisible: true,
      acceptLabel: "Continue",
      rejectLabel: "Cancel",
      rejectIcon: 'fa fa-times',
      acceptIcon: 'fa fa-check',
      message:
        "This Pre-Approval was already authorized by the Managing Specialist. You are about to make an update to a field that will require a new Pre-Approval. If you continue, your current Pre-Approval will be cancelled and all information will be transferred to a new Pre-Approval that will need to be submitted again. Continue?",
      accept: () => {
        this.service.reinitiateNew(this.data!.id!).pipe(takeUntil(this.destroying$)).subscribe(async (requestId) => {
          let url = `/preapproval/reinitiate/afs/group3?requestId=${(await this.cryptoService.encrypt(requestId))}`;
          if (this.isAdmin) {
            url += `&isAdmin=${(await this.cryptoService.encrypt(this.isAdmin))}`;
          }
          this.navigate(url);
        });
      },
    });
  }

  onIsAutoPreApprovalChanged(event:any) {
    this.isAutoPreApproval = event;
  }

  private navigate(url: string) {
    const index = url.indexOf("?");
    const navigateUrl = index === -1 ? url : url.slice(0, index);
    const navigationExtras: NavigationExtras = {
      queryParams: this.util.getQueryParams(url),
    };
    this.router.navigate([navigateUrl], navigationExtras);
  }

  private getCategoryId(designeeTypeId: number, isAdmin: boolean) {
    if (designeeTypeId === DesigneeTypeEnum.APD && isAdmin) {
      return CategoryEnum.AdminApd;
    }
    if (designeeTypeId === DesigneeTypeEnum.TCE && isAdmin) {
      return CategoryEnum.AdminTce;
    }
    return null;
  }

  private saveRequest(saveData: PreApprovalRequestInfoModel): Observable<any> {
    const saveMessage = "Pre-Approval request has been saved successfully.";
    const updateMessage = saveData.isSubmit
      ? "Pre-Approval request has been submitted successfully."
      : "Pre-Approval request has been updated successfully.";

    if (saveData.id === 0) {
      return new Observable((observer) => {
        saveData.categoryId = this.getCategoryId(
          this.designeeTypeId,
          this.isAdmin
        ) as any;
          this.service.saveAfsPreApprovalRequest(saveData).pipe(takeUntil(this.destroying$)).subscribe(
          (result) => {
            this.data = result;
            this.uploadDocuments(saveMessage, saveData, observer, true);
          },
          () => {
            this.toastService.add({
              key: "dms",
              severity: "error",
              summary: "Error Message",
              detail: "Request failed.",
            });
          }
        );
      });
    }
    return new Observable((observer) => {
        this.service.updateAfsPreApprovalRequest(saveData)
        .pipe(takeUntil(this.destroying$))
        .subscribe({
          next: (result) => {
            this.data = result;
            this.uploadDocuments(updateMessage, saveData, observer, false);
          },
          error: () => {
            this.toastService.add({
              key: "dms",
              severity: "error",
              summary: "Error Message",
              detail: "Request failed.",
            });
          }
        });
    });
  }

  private uploadDocuments(message: string, saveData: PreApprovalRequestInfoModel, observer: Subscriber<any>, navigateHome: boolean) {
    this.index!.uploadControl!.fileUpload(this.data!.documentReference!.referenceId!)
      .pipe(takeUntil(this.destroying$))
      .subscribe({
        next: async () => {
          this.toastService.add({ key: 'dms', severity: 'success', summary: 'Success Message', detail: message });
          if (saveData.isSubmit) {
            this.goToActivityPage();
          } else if(navigateHome) {
            const navigationExtras: NavigationExtras = {
              queryParams: {
                requestId: await this.cryptoService.encrypt(saveData.id),
                isAdmin: await this.cryptoService.encrypt(this.isAdmin),
              },
              relativeTo: this.route,
              replaceUrl: true, // navigate while replacing the current state. Solves the problem of having two routes in history.
            };
            this.router.navigate([], navigationExtras);
          }
          observer.next();
          observer.complete();
        },
        error: () => {
          this.toastService.add({
            key: 'dms',
            severity: 'error',
            summary: 'Error Message',
            detail: 'Upload Document failed.'
          });
        }
      });
  }

  private goToActionsPage() {
    this.location.back();
  }

  private goToActivityPage() {
    this.router.navigate(["/activity"]);
  }

  private goToHomePage() {
    this.router.navigate(["/home"]);
  }

  private updateModel() {
    const model = this.index!.getModel();
    return Object.assign({}, this.data, {
      id: this.data!.id,
      designeeTypeId: this.designeeTypeId,
      ...model,
    });
  }

  private setActionButtons() {
    this.props.buttons.forEach((a:any) => {
      switch (a.eventKey) {
        case ButtonActionsEnum.Save:
          a.isDisplay = !this.isDisabled && !this.canPrint;
          break;
        case ButtonActionsEnum.Print:
          a.isDisplay = this.canPrint;
          break;
        case ButtonActionsEnum.Continue:
          a.isDisplay = !this.canPrint;
          a.displayOrder = 3;
          break;
        case ButtonActionsEnum.Copy:
          a.isDisplay = this.canCopy && this.canPrint;
          break;
        case ButtonActionsEnum.Submit:
          a.isDisplay = !this.isDisabled;
          break;
      }
    });
  }

  private copyPreApproval() {
    // Check for any pending post activities for designee before proceding copy show warning if any pending post activities.
    this.service
      .checkPendingPostActivitiesExists(this.data!.designeeInfo!.applicationId!)
      .pipe(takeUntil(this.destroying$))
      .subscribe(async data => {
        const isPendingPostActivities = data;
        if (isPendingPostActivities) {
          this.confirmationService.confirm({
            key: 'dms',
            icon: undefined,
            header: "Pending Post Activity",
            acceptVisible: true,           
            acceptLabel: "Ok",
            acceptIcon: 'fa fa-check',
            rejectVisible: false,
            message:
              "You must submit all overdue Post-Activity reports in order to initiate new Pre-Approval.",
          });
        } else {
          const url = `/preapproval/clone/afs/group3/${(await this.cryptoService.encrypt(this.data!.id))}?isAdmin=${(await this.cryptoService.encrypt(this.isAdmin))}`;
          this.navigate(url);
        }
      });
  }
}
