    -- Step 7a: Datavant Member/Provider files
    -- @<stage>/<s3_folder_path>/<TIMESTAMP_FOLDER>/ELV_DTVNT_<R>_MRA_<ONOFFSHORE>_<n>_<yyyyMMddHHmmss>.txt
    -- One file per 500,000 rows per ONOFFSHORE value; header, '|' delimited, uncompressed, single file, overwrite.
    FOR rec IN c_mbrprov_file_ind DO
        file_ind := rec.file_ind;

        SELECT COUNT(*) INTO total_records
        FROM temp_db.temp_schema.mbrprov_file_data
        WHERE ONOFFSHORE = :file_ind;

        num_files := CEIL(total_records / max_records_per_file);

        FOR file_num IN 1 TO num_files DO
            start_row := (file_num - 1) * max_records_per_file + 1;
            end_row := LEAST(file_num * max_records_per_file, total_records);
            file_name := 'ELV_DTVNT_' || mbrprov_r_value || '_MRA_' || file_ind || '_' || TO_VARCHAR(file_num) || '_' || file_ts || '.txt';

            copy_stmt := 'COPY INTO @' || snowflake_stage || '/' || s3_folder_path || '/' || timestamp_folder || '/' || file_name
