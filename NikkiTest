        [HttpPut("PostActivity/submit/{id}")]
        public IActionResult PostActivityPut(int id, [FromBody]PreApprovalRequestViewModel model)
        {

            if (ModelState.IsValid && model != null)
            {
                DesigneeTypeEnum designeeType = (DesigneeTypeEnum)model.DesigneeTypeId;
                var _preApprovalRequestService = _preApprovalRequestServiceDelegate(designeeType);
                if (model.IsAfsType)
                {
                    model.AfsPostActivity.Id = id;
                }
                else
                {
                    model.PostActivity.Id = id;
                }

                return new OkObjectResult(_preApprovalRequestService.SavePostActivityEvaluation(model));
            }
            return new BadRequestObjectResult(model);
        }

        [HttpPut("PostActivity/afs/submit/{id}")]
        public IActionResult PostActivityAfsPut(int id, [FromBody]AfsGroupsPostActivityViewModel model)
        {
            if (!ModelState.IsValid || model == null)
                return new BadRequestObjectResult(model);

            DesigneeTypeEnum designeeType = (DesigneeTypeEnum)model.DesigneeInfo.TypeId;
            var _preApprovalRequestService = _preApprovalRequestServiceDelegate(designeeType);
            var latestPostActivity = _preApprovalRequestService.GetLatestPostActivityVersion(model.PreApprovalRequestId);
            if (latestPostActivity.postActivityId != id || (latestPostActivity.statusId != model.StatusId && latestPostActivity.statusId == (int)PreApprovalRequestStatusEnum.Completed))
            {
                ModelState.AddModelError("Id", "Please reload the page with latest postactivity and then save/submit.");
                model.Id = latestPostActivity.postActivityId;
                model.StatusId = latestPostActivity.statusId;
                return new BadRequestObjectResult(model);
            }

            return new OkObjectResult(_preApprovalRequestService.SaveAfsPostActivity(model));
        }

