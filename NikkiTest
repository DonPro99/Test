            ("FIRE", d.IsAdminPeGenFIRE),
            ("BAE", d.IsAdminPeGenBAE),
        };
        preApprovalType = string.Join(", ", codes.Where(c => c.IsSelected).Select(c => c.Label));
    }
    if (string.IsNullOrWhiteSpace(preApprovalType))
