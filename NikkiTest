## Example Conversion

### **Input: Snowpark Code**

```python
from snowflake.snowpark import Session
from snowflake.snowpark.functions import col, count, when, current_timestamp

# Create session
session = Session.builder.configs(connection_params).create()

# Read source data
source_df = session.table("RAW.CUSTOMER_DATA") \
    .filter(col("LOB") == "COM") \
    .filter(col("STATUS") == "ACTIVE")

# Apply transformations
transformed_df = source_df.select(
    col("CUSTOMER_ID"),
    col("FIRST_NAME"),
    col("LAST_NAME"),
    when(col("STATE").isNull(), "UNKNOWN").otherwise(col("STATE")).alias("STATE"),
    current_timestamp().alias("LOAD_DATE")
)

# Aggregate
summary_df = transformed_df.groupBy("STATE") \
    .agg(count("CUSTOMER_ID").alias("CUSTOMER_COUNT"))

# Write to target
summary_df.write.mode("overwrite").saveAsTable("ANALYTICS.CUSTOMER_SUMMARY")
```

### **Output: SQL Script**

```sql
EXECUTE IMMEDIATE $$
DECLARE
    process_id VARCHAR := '{{ PROCESS_ID }}';
    lob VARCHAR := '{{ LOB }}';
    edl_run_id VARCHAR := '{{ EDL_RUN_ID }}';
    batch_id INTEGER;
BEGIN
    SELECT COALESCE(batchid, 1) INTO batch_id
    FROM {{ LOAD_LOG_KEY_TABLE }}
    WHERE processid = :process_id
      AND UPPER(status) = 'COMPLETED'
    ORDER BY createdatetime DESC
    LIMIT 1;

    IF (batch_id IS NULL) THEN
        batch_id := 1;
    END IF;

    BEGIN TRANSACTION;

    CREATE OR REPLACE TEMPORARY TABLE temp_db.temp_schema.source_data AS
    SELECT *
    FROM {{ sourceTable }}
    WHERE LOB = :lob
      AND STATUS = 'ACTIVE';

    CREATE OR REPLACE TEMPORARY TABLE temp_db.temp_schema.transformed_data AS
    SELECT
        CUSTOMER_ID,
        FIRST_NAME,
        LAST_NAME,
        CASE WHEN STATE IS NULL THEN 'UNKNOWN' ELSE STATE END AS STATE,
        CURRENT_TIMESTAMP() AS LOAD_DATE
    FROM temp_db.temp_schema.source_data;

    CREATE OR REPLACE TEMPORARY TABLE temp_db.temp_schema.summary_data AS
    SELECT STATE, COUNT(CUSTOMER_ID) AS CUSTOMER_COUNT
    FROM temp_db.temp_schema.transformed_data
    GROUP BY STATE;

    CREATE OR REPLACE TEMPORARY TABLE temp_db.temp_schema.validation_counts AS
    SELECT
        (SELECT COUNT(*) FROM temp_db.temp_schema.summary_data) AS row_count,
        0 AS stage_count,
        (SELECT COUNT(*) FROM {{ targetTable }} WHERE EDL_RUN_ID = :edl_run_id) AS duplicate_count;

    CREATE OR REPLACE TABLE {{ targetTable }} AS
    SELECT
        CURRENT_TIMESTAMP() AS EDL_LOAD_DTM,
        :edl_run_id AS EDL_RUN_ID,
        :lob AS EDL_LOB_CD,
        STATE,
        CUSTOMER_COUNT
    FROM temp_db.temp_schema.summary_data;

    COMMIT;
END;
$$;
