            copy_stmt := 'COPY INTO @' || snowflake_stage || '/' || s3_folder_path || '/' || timestamp_folder || '/' || file_name
                      || ' FROM (SELECT * EXCLUDE (ONOFFSHORE, ROW_NUM) FROM temp_db.temp_schema.cpl_file_data'
                      || ' WHERE ONOFFSHORE = ''' || file_ind || ''''
                      || ' AND ROW_NUM BETWEEN ' || TO_VARCHAR(start_row) || ' AND ' || TO_VARCHAR(end_row)
                      || ' ORDER BY ROW_NUM)'
                      || copy_options;

            EXECUTE IMMEDIATE :copy_stmt;
        END FOR;
    END FOR;

    -- ========================================================================
    -- SECTION 9: TRANSACTION COMMIT
    -- ========================================================================
    
    -- Commit all changes
    COMMIT;

END;
