        public bool SaveAfsAdditionalInfo(DesigneeInfoViewModel model)
        {
            try
            {
                var cloa = _context.Cloas.First(c => c.Id == model.CloaId);
                var date = model.CertificateIssuedDate != null && model.CertificateIssuedDate != string.Empty ? Convert.ToDateTime(model.CertificateIssuedDate) : (DateTime?)null;
                var certificateNumber = cloa.CertificateNumber != null && cloa.CertificateNumber.Length > 1 ? cloa.CertificateNumber.PadLeft(9, '0') : null;
                var ftn = cloa.Ftn != null && cloa.Ftn.Length > 1 ? cloa.Ftn.PadLeft(8, '0') : null;

                if (cloa.CertificateIssuedDate != date || certificateNumber != model.CertificateNumber || ftn != model.Ftn)
                {
                    var newCloa = new Dms.Services.ViewModel.Cloa.CloaGenerateViewModel
                    {
                        Id = model.CloaId,
                        UserId = model.ModifiedBy,
                        CertificateIssuedDate = date,
                        CertificateNumber = model.CertificateNumber,
                        Ftn = model.Ftn,
                        DesigneeTypeId = model.Type.Id
                    };
                    _cloaService.GenerateNewCloa(newCloa);
                    _context.SaveChanges();
                }
                return true;
            }
            catch
            {
                return false;
            }
        }

        private static void DisableActivityIfNotHisDesignee(ActivityHistoryViewModel[] list, bool isMyDesignee, int roleId)
        {
            if (isMyDesignee) return;
            foreach (var link in list)
            {
                if (link.ModuleId == (int)ProcessTypeEnum.OverallPerformanceEvaluation)
                {
                    link.HasNavigation = link.StatusId == (int)ActivityStatusEnum.Completed;
                }
                if (link.ModuleId != (int)ProcessTypeEnum.RecordFeedback && link.ModuleId != (int)ProcessTypeEnum.Counseling && link.ModuleId != (int)ProcessTypeEnum.SiteEvaluationForm)
                {
                    link.HasNavigation = link.StatusId != (int)ActivityStatusEnum.Saved;
                }
                if (link.ModuleId == (int)ProcessTypeEnum.InvestigationRecord && roleId == (int)RoleEnum.AviationSafetyInspector)
                {
                    link.HasNavigation = link.StatusId == (int)ActivityStatusEnum.Saved || link.StatusId == (int)ActivityStatusEnum.Completed;
                }
            }
        }

        private static string GetTrainingRecordUrl(CloaViewModel cloa, int roleId, bool isMyDesignee)
        {
            if (cloa.DesigneeTypeId == (int)DesigneeTypeEnum.AME ||
                            (cloa.DesigneeTypeId == (int)DesigneeTypeEnum.DMIR || cloa.DesigneeTypeId == (int)DesigneeTypeEnum.DARF && (roleId == (int)RoleEnum.PolicyOwnerDmirDarf || roleId == (int)RoleEnum.PolicyOwnerOda)) ||
                            (cloa.DesigneeGroupId == (int)DesigneeGroupEnum.AFS && (roleId == (int)RoleEnum.PolicyOwnerAfs || roleId == (int)RoleEnum.OfficeAdministrator || roleId == (int)RoleEnum.PolicyOwnerOda)))
            {
                return $"/training/record/{cloa.ApplicationId}/{cloa.DesigneeTypeId}/{0}";
            }

            return $"/training/record/{cloa.ApplicationId}/{cloa.DesigneeTypeId}/{(isMyDesignee ? 0 : 1)}";

        }

        public bool SaveAovAdditionalInfo(DesigneeInfoViewModel model)
        {
            var cloa = _context.Cloas.Include(c => c.CloaAddresses).First(c => c.Id == model.CloaId);
            var date = model.CertificateIssuedDate != null && model.CertificateIssuedDate != string.Empty ? Convert.ToDateTime(model.CertificateIssuedDate) : (DateTime?)null;
            var certificateNumber = cloa.CertificateNumber != null && cloa.CertificateNumber.Length > 1 ? cloa.CertificateNumber.PadLeft(9, '0') : null;
            var medicalCertificationDate = model.MedicalCertificationDate != null && model.MedicalCertificationDate != string.Empty ? Convert.ToDateTime(model.MedicalCertificationDate) : (DateTime?)null;

            if (cloa.CertificateIssuedDate != date || certificateNumber != model.CertificateNumber || medicalCertificationDate != cloa.MedicalCertificationDate)
            {
                var cloaGenerateModel = new Dms.Services.ViewModel.Cloa.CloaGenerateViewModel
                {
                    Id = model.CloaId,
                    UserId = model.ModifiedBy,
                    CertificateIssuedDate = date,
                    CertificateNumber = model.CertificateNumber,
                    MedicalCertificationDate = medicalCertificationDate,
                    DesigneeTypeId = model.Type.Id
                };
                var newCloa = _cloaService.GenerateNewCloa(cloaGenerateModel);
                _context.SaveChanges();

                if (newCloa != null)
                {
                    newCloa.CloaAddresses =
                        cloa.CloaAddresses.Select(c => new AddressReference
                        {
                            ApplicationId = newCloa.ApplicationId,
                            AddressId = c.AddressId,
                            CloaId = newCloa.Id,
                            CloaFunctionCodes = c.CloaFunctionCodes
                                                .Where(f => f.IsActive)
                                                .Select(f => new CloaFunctionCode()
                                                {
                                                    CloaId = newCloa.Id,
                                                    FunctionCodeId = f.FunctionCodeId,
                                                    IsActive = f.IsActive,
                                                    IsAutoPostActivity = f.IsAutoPostActivity,
                                                    IsAutoPreApproval = f.IsAutoPreApproval,
                                                    Limitation = f.Limitation,
                                                }).ToList()
                        }).ToList();
                    _context.SaveChanges();
                }
            }
            return true;
        }
    }
