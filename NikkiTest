def load_config(config_file):
    config = configparser.ConfigParser()
    config.read(config_file)
    return config

def get_latest_batch_id(snowflake_options, target_table_name):
    df = spark.read \
        .format("net.snowflake.spark.snowflake") \
        .options(**snowflake_options) \
        .option("dbtable", target_table_name) \
        .load()

    latest_batch_id = df.select(max("batch_id")).collect()[0][0]
    print(f"-------{latest_batch_id}----------")
    if latest_batch_id is None:
        return 0
    else:
        return int(latest_batch_id)
    #return latest_batch_id if latest_batch_id else 0


def load_data_to_snowflake(df: DataFrame, snowflake_options, table_name: str, schema_name: str, load_mode: str, today_date: str, process: str, batch_id: int):
    try:
        logger.info(f"At withColumns for Snowflake table: {table_name}")

        df = df.withColumn("LOB", lit(process)) \
               .withColumn("INSERT_DT", lit(today_date)) \
               .withColumn("BATCH_ID", lit(batch_id))

        if "RISK_RETRO_INTERNALCODING_SRC" in table_name.upper():
            df = df.withColumn("FILENAME", input_file_name())


        logger.info(f"Loading data into Snowflake table: {table_name}")
        print("-----------------------------------------------------------------------------------------------------------------------------------------------------")
        df.printSchema()

        df.write \
            .format("net.snowflake.spark.snowflake") \
            .options(**snowflake_options) \
            .option("dbtable", table_name) \
            .mode(load_mode) \
            .save()
    except Exception as e:
        logger.exception(f"Failed while inserting data into Snowflake: {e}")
        raise


def read_source_file(file_path: str, delimiter: str, file_format: str, schema_name: str, file_name: str, run_id: str, column_list: list) -> DataFrame:
    if file_format == 'csv' or file_format == 'txt':
        if schema_name is None or schema_name == "":
            df = spark.read.option("header","true").option("delimiter", delimiter).csv(file_path)
            df.show(5, False)
        else:
            df = spark.read.schema(schema_name).option("delimiter", delimiter).csv(file_path, header=True)
            df.show(5, False)
    elif file_format == 'parquet':
        df = spark.read.parquet(file_path)
    else:
        raise ValueError(f"Unsupported file format: {file_format}")

    logger.info(f"File {file_path} read with format {file_format}")



    if df is not None:
        if "CIX" in file_name:
            logger.info(f"Inside File {file_name} for date conversion in CIX ")
            df = df.withColumn("MemberDOB", when(col("MemberDOB").rlike(r"\d{2}[A-Za-z]{3}\d{4}"),
                                          to_date(col("MemberDob"), "ddMMMyyyy"))
                                          .when(col("MemberDOB").rlike(r"\d{2}/\d{2}/\d{4}"), to_date(col("MemberDOB"),"MM/dd/yyyy")).otherwise(None))
        elif "M360" in file_name:
            logger.info(f"Inside File {file_name} for date conversion in M360")
            df = df.withColumn("mbr_brth_dt", when(to_date(from_unixtime(unix_timestamp(col("mbr_brth_dt"), "d-MMM-yy"))) < from_unixtime(unix_timestamp()),
            lit(to_date(from_unixtime(unix_timestamp(col("mbr_brth_dt"), "d-MMM-yy"))))).otherwise(concat(year(to_date(from_unixtime(unix_timestamp(col("mbr_brth_dt"), "d-MMM-yy"))))-100, SUBSTRING(to_date(from_unixtime(unix_timestamp(col("mbr_brth_dt"), "d-MMM-yy"))),5,10)))) \
                .withColumn("Special_Handling_Category", lit(""))
        elif "MBR" in file_name:
            logger.info(f"Inside File {file_name} for date conversion in MBR")
            df = df.withColumn("memberbirthdate", lit(to_date(trim(col("memberbirthdate")), "yyyyMMdd"))).withColumn("memberdateofdeath", lit(to_date(trim(col("memberdateofdeath")), "yyyyMMdd")))
            cleaned_columns = [re.sub(r'[^a-zA-Z0-9]+$','', col) for col in df.columns]
            df = df.toDF(*cleaned_columns)
        elif "ChartData_ANT" in file_name:
            logger.info(f"Inside File {file_name} for date conversion in Episource")
            df = df.withColumn("MBRDOB", lit(to_date(trim(col("MBRDOB")),"MM/dd/yyyy"))).withColumn("TIN", lit(0)).withColumn("BILLNPI", lit(0)).withColumn("BILLTIN", lit(0)).withColumn("PRVGROUP",col("PRVGROUP").substr(1,50))
        elif "ChartData_CAID_Virtix" in file_name:
            logger.info(f"Inside File {file_name} for date conversion in Virtix")
            # RBICA-13935 : Virtix files don't carry STATE as a data column. STATE is embedded in the
            # merged output filename by the SAS merge step, e.g. ChartData_CAID_Virtix_Chase_<STATE>_yyyymmdd.txt
            # so we extract it here from the actual S3 file path being read.
            df = df.withColumn("MemberDOB", lit(to_date(trim(col("MemberDOB")), "MM/dd/yyyy"))) \
                   .withColumn("STATE", regexp_extract(input_file_name(), r'ChartData_CAID_Virtix_Chase_([A-Za-z]{2})_\d{8}\.txt', 1)) \
                   .withColumn("KF_TMS", lit(None).cast("timestamp")) \
                   .withColumn("EDL_CREAT_DTM", current_timestamp()) \
                   .withColumn("EDL_INCRMNTL_LOAD_DTM", lit("8888-12-31 00:00:00").cast("timestamp"))
       elif "PROV" in file_name:
            logger.info(f"Inside File {file_name} for date conversion in PROV")
            if "UserDefined2" not in df.columns:
                df = df.withColumn("UserDefined2", lit(""))
        elif "IH_MCD" in file_name:
            logger.info("Applying IH_MCD columns and transformations:")
            df = df.withColumn("MEMBERDOB", to_date(col("MEMBERDOB"),"ddMMMyyyy")) \
                    .withColumn("KF_TMS", current_timestamp()) \
                    .withColumn("EDL_CREAT_DTM", current_timestamp()) \
                    .withColumn("EDL_INCRMNTL_LOAD_DTM", current_timestamp())


        if len(column_list) == 0:
            cleaned_columns = [re.sub(r'[^a-zA-Z0-9]+$','', col) for col in df.columns]
            df = df.toDF(*cleaned_columns)
            column_list = df.columns
            print(column_list)

        # RBICA-13935: STATE is derived
        if "ChartData_CAID_Virtix" in file_name:
            if "STATE" not in column_list:
                column_list = column_list + ["STATE"]

        df = df.withColumn("EDL_LOAD_DTM", date_trunc('MILLISECOND', current_timestamp())) \
               .withColumn("EDL_RUN_ID", lit(run_id)) \
               .withColumn("EDL_SCRTY_LVL_CD", lit("UNK")) \
               .withColumn("EDL_LOB_CD", lit("XMGBD")) \
               .withColumn("EDL_EXTRNL_LOAD_CD", lit("I")) \
               .withColumn("EDL_SOR_CD", lit("9"))

        add_column_list = ["EDL_LOAD_DTM", "EDL_RUN_ID", "EDL_SCRTY_LVL_CD", "EDL_LOB_CD", "EDL_EXTRNL_LOAD_CD", "EDL_SOR_CD"]
        extra_column_list = ["EDL_LOAD_DTM", "EDL_RUN_ID", "EDL_SCRTY_LVL_CD", "EDL_LOB_CD", "EDL_EXTRNL_LOAD_CD", "EDL_SOR_CD", "KF_TMS", "EDL_CREAT_DTM", "EDL_INCRMNTL_LOAD_DTM"]

    if "IH_MCD" in file_name or "ChartData_CAID_Virtix" in file_name:
        column_sequence = extra_column_list + column_list
    else:
        column_sequence = add_column_list + column_list

    df = df.select(*column_sequence)
    df.printSchema()

    df.show(10,False)
    return df

def get_matching_files(s3_file_path:str, file_name: str, step: str):
    part_spilt = s3_file_path.replace("s3://", "").split("/", 1)
    s3 = boto3.client('s3')
    bucket = s3_file_path.split('/')[2]
    print(bucket)
    prefix = part_spilt[1] if len(part_spilt) > 1 else ""
    print(prefix)
    regex_pattern = re.compile(file_name.replace('*', '.*') + '$')
    print(regex_pattern)

    response = s3.list_objects_v2(Bucket=bucket, Prefix=prefix)
    print(response)

    if 'Contents' not in response:
        logger.warning(f"No files found for {step}: {s3_file_path}/{file_name}")
        #sys.exit(0)

    matching_files = [obj['Key'] for obj in response['Contents'] if regex_pattern.match(obj['Key'].split('/')[-1])]
    print(matching_files)

    if not matching_files:
        logger.warning(f"No files found for {step}: {s3_file_path}/{file_name}")
        sys.exit(0)

    files = spark.read.text(f"{s3_file_path}/{file_name}").inputFiles()
    files = [file for file in files if file.strip()]
    print(f"+++++++++++++++++++++++++++{files}++++++++++++++++++++++++++")
    if not files:
        logger.warning(f"No files found for {step}: {s3_file_path}/{file_name}")
        sys.exit(0)
    return files

def get_matching_files_from_s3(s3_file_path: str, file_name: str, step: str):
    # Remove s3:// prefix and split into bucket and prefix
    path_without_protocol = s3_file_path.replace("s3://", "")
    path_parts = path_without_protocol.split("/", 1)

    bucket = path_parts[0]
    prefix = path_parts[1] if len(path_parts) > 1 else ""

    if prefix and not prefix.endswith('/'):
        prefix += '/'

    print(f"Bucket: {bucket}")
    print(f"Prefix: {prefix}")
    print(f"Looking for files matching: {file_name}")

    regex_pattern = re.compile(file_name.replace('*', '.*') + '$')
    s3 = boto3.client('s3')

    try:
        paginator = s3.get_paginator('list_objects_v2')
        matching_keys = []

        for page in paginator.paginate(Bucket=bucket, Prefix=prefix):
            for obj in page.get('Contents', []):
                filename = obj['Key'].split('/')[-1]
                print(f"Found file: {filename}")
                if regex_pattern.match(filename):
                    matching_keys.append(f"s3a://{bucket}/{obj['Key']}")
                    print(f"File matches pattern: {filename}")

        if matching_keys:
            print(f"Total matching files found: {len(matching_keys)}")
            return matching_keys
        else:
            logger.warning(f"No matching files found for {step} in {s3_file_path} with pattern {file_name}")
            return []

    except Exception as e:
        logger.error(f"Error accessing S3 bucket {bucket}: {e}")


def send_email( sender_email, recipient_email, smtp_server, smtp_port, loaded_files, step, today_date,body_email, status_code):
    subject = f"{step} to snowflake - {today_date}: {status_code}."
    body = body_email

    message = MIMEMultipart()
    message["From"] = sender_email
    message["To"] = recipient_email
    message["Subject"] = subject
    message.attach(MIMEText(body, "plain"))

    try:
        server = smtplib.SMTP(smtp_server, smtp_port)
        server.sendmail(sender_email, recipient_email, message.as_string())
        server.quit()
        logger.info("Email sent Successfully.")
    except Exception as e:
        logger.exception(f"Failed to send an email: {e}")
        raise


def archive_s3_source_files(s3_file_path, s3_archive_file_path, loaded_files):
    try:
        for file_name in loaded_files:
            command = f"aws s3 mv {s3_file_path}{file_name} {s3_archive_file_path}{file_name}"
            result = subprocess.run(command, shell=True, text=True, capture_output=True)
            if result.returncode == 0:
                logger.info(f"Source is archivied successfully {file_name}")
            else:
                logger.error(f"Failed while archiving the source file {file_name}")
    except Exception as e:
        logger.exception(f"An error occured while executing the copy command: {e}")
        raise

