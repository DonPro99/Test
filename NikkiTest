protected override bool IsAutoPreApproval(PreApprovalRequestViewModel model)
{
    var cloaAutoPreApproval = _context.PreApprovalRequests
        .Where(par => par.Id == model.Id)
        .Select(par => par.Cloa.IsAutoPreApproval)
        .FirstOrDefault();

    if (cloaAutoPreApproval)
    {
        return true;
    }

    // Fix for AdminPeGen: if nothing is currently selected, treat it as no function codes
    // (the shared SaveDpeSaeFunctionCodes doesn't clear stale codes when both lists are empty)
    bool nothingSelected =
        (model.TestCheckInformation.SelectedRequestAuthorizations == null || model.TestCheckInformation.SelectedRequestAuthorizations.Count == 0) &&
        (model.TestCheckInformation.SelectedTemporaryAuthorizations == null || model.TestCheckInformation.SelectedTemporaryAuthorizations.Count == 0);

    if (nothingSelected)
    {
        return false;
    }

    return !model.TestCheckInformation.IsOtherAdminActivity.GetValueOrDefault() && base.IsAutoPreApproval(model);
}
