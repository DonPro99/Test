                }
                //check if  postactivities has modifiedDatas.
                var activity = _context.PostActivities.Where(e=> e.PreApprovalRequestId == preApprovalRequestId).FirstOrDefault();
                if (activity != null && activity.PostActivityModifiedDatas != null && activity.PostActivityModifiedDatas.FirstOrDefault() != null)
                {
                    var modifiedData = activity.PostActivityModifiedDatas.FirstOrDefault();
                    var formData = modifiedData != null && modifiedData.FormData != null ? JsonConvert.DeserializeObject<AfsPostActivityModifiedPreApprovalViewModel>(modifiedData.FormData) : null;
                    afsPostActivity.AfsPostActivityModifiedPreApprovalViewModel = formData;
                }

                afsPostActivity.DocumentReference = _documentService.GetDocumentsByRef((int)DocumentReferenceEnum.PostActivity, afsPostActivity.Id, null);
                _preApprovalRequestViewModel.IsPostActivityCurrentVersion = postActivityId > 0 && preApprvoalRequest.PostActivities.OrderByDescending(p => p.Id).First().Id == postActivityId;
                if (postActivity.StatusId == (int)PreApprovalRequestStatusEnum.Completed && _preApprovalRequestViewModel.IsPostActivityCurrentVersion && (DateTime.Now - postActivity.CompletedDate).Value.TotalDays <= 30)
                {
                    // Before Post activity version, Delete any previous orphan data and create version of documents for edit functionlity (Delete them when navigate back)
                    _documentService.Delete(
                        new DocumentReferenceViewModel
                        {
                            DocumentReferenceEnum = DocumentReferenceEnum.PostActivity,
                            ReferenceId = preApprovalRequestId,
                            SecondaryReferenceId = preApprovalRequestId
                        });
                    var documents = _context.DocumentReferences
                        .Where(d => d.DocumentTypeId == (int)DocumentReferenceEnum.PostActivity &&
                                d.ReferenceId == afsPostActivity.Id &&
                                d.SecondaryReferenceId == null).ToArray();
                    _context.DocumentReferences.AddRange(documents.Select(d => new DocumentReference
                    {
                        ReferenceId = preApprovalRequestId,
                        SecondaryReferenceId = preApprovalRequestId,
                        DocumentTypeId = (int)DocumentReferenceEnum.PostActivity,
                        DocumentId = d.DocumentId
                    }).ToArray());
                    _context.SaveChanges();
                    afsPostActivity.DocumentReference = _documentService.GetDocumentsByRef((int)DocumentReferenceEnum.PostActivity, preApprovalRequestId, preApprovalRequestId);
                }

                preApprovalRequestViewModel.AfsPostActivity = afsPostActivity;
            }
            _preApprovalRequestViewModel = preApprovalRequestViewModel;
            return _preApprovalRequestViewModel;

        }

