import { Injectable } from '@angular/core';
import { ActivatedRouteSnapshot } from '@angular/router';
import { Observable } from 'rxjs';
import { ActivityStatusEnum, CryptoService, PreApprovalRequestService } from 'dms-web-shared';

@Injectable({ providedIn: 'root' })
export class PostActivityDataResolver  {
  constructor(private service: PreApprovalRequestService, private cryptoService: CryptoService) { }

  async resolve(
    route: ActivatedRouteSnapshot
  ): Promise<Observable<any> | Promise<any> | any> {
    const postActivityId = +(await this.cryptoService.decrypt(route.params['postActivityId']));
    const activityStatus = +route.queryParams['activityStatus'] === ActivityStatusEnum.Completed;
    return this.service.getPostActivity(postActivityId, activityStatus);
  }
}
