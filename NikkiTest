def export_csv(df):
    with pd.io.common.StringIO() as buffer:
        df.to_csv(buffer, index=False)
        return buffer.getvalue()

def send_email(logger,from_address, to_addresses, subject, body, attachments):
    msg = MIMEMultipart()
    msg['From'] = from_address
    msg['To'] = to_addresses
    msg['Subject'] = subject
    msg.attach(MIMEText(body, 'html'))
    
    for filename, data in attachments.items():
        part = MIMEApplication(data)
        part['Content-Disposition'] = f'attachment; filename="{filename}"'
        msg.attach(part)
    
    with smtplib.SMTP('smtp.wellpoint.com', 25) as smtp:
        smtp.sendmail(from_address, to_addresses , msg.as_string())
    logger.info("Email sent successfully")

