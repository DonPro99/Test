SELECT pa.Id AS PostActivityId, pa.PreApprovalRequestId, pr.ApplicationId, pr.Id AS PreApprovalRequestId
FROM PostActivity pa
JOIN PreApprovalRequest pr ON pa.PreApprovalRequestId = pr.Id
WHERE pr.ApplicationId IN (
    SELECT Id FROM Application WHERE DesigneeTypeId = 31  -- 31 = ADMINPEGEN, confirmed earlier today
)
ORDER BY pa.Id DESC
