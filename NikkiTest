        public static void PreProcessData(PreApprovalRequestViewModel model)
        {
            model.AuthFunctionCodes = CleanFc(model.AuthFunctionCodes);
            model.DesigneeFunctionCodes = CleanFc(model.DesigneeFunctionCodes) as List<FunctionCodeViewModel>;
            model.SelectedOtherFunctionCodes = CleanFc(model.SelectedOtherFunctionCodes) as List<FunctionCodeViewModel>;

            if (model.ApplicationInformation != null)
            {
                model.ApplicationInformation.PreApprovalCertificateRatingType = null;
            }
            if (model.PoApplicationInformation != null)
            {
                model.PoApplicationInformation.PreApprovalCertificateRatingType = null;
            }
            model.PreApprovalDateWiseCount = null;
            if (model.TestCheckInformation?.RequestedAuthorizations != null)
            {
                foreach (var requestedAuthorization in model.TestCheckInformation.RequestedAuthorizations)
                {
                    requestedAuthorization.TypeRatings?.ToList().Clear();
                }
            }

            if (model.TestCheckInformation?.TemporaryAuthorizations == null) return;
            foreach (var temporaryAuthorization in model.TestCheckInformation.TemporaryAuthorizations)
            {
                temporaryAuthorization.TypeRatings?.ToList().Clear();
            }
        }

        private static IList<FunctionCodeViewModel> CleanFc(IList<FunctionCodeViewModel> fcList)
        {
            if (fcList == null) return new List<FunctionCodeViewModel>();
            foreach (var fc in fcList)
            {
                fc.TypeRatings?.ToList().Clear();
            }

            return fcList;
        }

