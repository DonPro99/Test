                switch (link.Code)
                {
                    case "CC": //CLOA/ID Card
                        link.Url = $"/cloainformation/{cloa.Id}/{false}";
                        break;
                    case "CI": //Contact Information
                        link.Url = $"/contactinformation/{cloa.Id}";
                        break;
                    case "OA": //Original Application
                        link.Url = $"/application/summary/{cloa.ApplicationId}/{cloa.VersionId}";
                        link.IsNewWindow = true;
                        break;
                    case "AL": //Authorizations and limitations
                        link.Url = $"/manageauthorization/{cloa.Id}?isInfo=true";
                        break;
                    case "VTR": //View Training Record
                        link.Url = $"/training/record/{cloa.ApplicationId}/{cloa.DesigneeTypeId}/{1}";
                        break;
                    case "SEF": //Site Evaluation Form
                        link.Url = $"/sitevisits/siteevaluationform/history/{cloa.Id}";
                        break;
                    case "ECF": //Equipment Certification Form
                        link.Url = $"/equipment/list/{cloa.Id}";
                        break;
                    case "PAS": //Auto PreApproval PostActivity
                        link.DisplayName = "View Pre-Approval Settings";
                        link.Url = $"/manageauthorization/manufacturing/{cloa.Id}?isInfo=true";
