            logging.debug("Master config not available, skipping notification")
            return
        
        primary_list = self.masterConfig.get('PRIMARY_NOTIFICATION_LIST')
        secondary_list = self.masterConfig.get('SECONDARY_NOTIFICATION_LIST')
        
        if not primary_list:
            logging.debug("PRIMARY_NOTIFICATION_LIST not configured, skipping notification")
            return
        
        try:
            env = os.getenv('ENV', 'uat')
