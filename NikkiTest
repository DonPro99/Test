case ButtonActionsEnum.Submit:
  ...
  saveData.isSubmit = true;
  if (!saveData.isApproved) {
    if (this.designeeTypeId === DesigneeTypeEnum.ADMINPEGEN) {
      // Save first, then decide the message based on the REAL outcome
      this.saveRequest(saveData).pipe(takeUntil(this.destroying$)).subscribe(() => {
        if (!this.data?.isApproved) {
          this.confirmationService.confirm({
            key: 'dms',
            header: "Pre-Approval Submit Message",
            acceptVisible: true,
            rejectVisible: false,
            acceptLabel: "OK",
            message: "This Pre-Approval will require FAA authorization before proceeding. You will receive a message after Pre-Approval request is reviewed.",
            accept: () => {},
          });
        }
      });
    } else {
      this.isAutoPreapproval(saveData).pipe(takeUntil(this.destroying$)).subscribe(v => {
        if (v) {
          this.saveRequest(saveData)...
        } else {
          this.confirmationService.confirm({...});
        }
      });
    }
  } else {
    this.saveRequest(saveData)...
  }
  break;
