            today = date.today()
            order_date = today.strftime("%Y-%m-%d")
            
            body = f"<html><head><style>table{{border-collapse:collapse;width:100%}}th{{background-color:green;color:white;padding:8px}}td{{border:1px solid black;padding:8px}}</style></head><body><h3>Risk Adjustment Analytics AWS-{env.upper()} : Business Process Notification</h3><table><thead><tr><th>Process ID</th><th>Process Name</th><th>Application ID</th><th>Order Date</th><th>Status</th></tr></thead><tbody><tr><td>{process_id}</td><td>{process_name}</td><td>{application_id}</td><td>{order_date}</td><td>{status}</td></tr></tbody></table><br><p><u>Exception/Error Details (If Any)</u></p><p>{error}</p><br><p>Thank You!<br>Anthem Information Technology<br>For assistance, contact the RAA Risky Business Team at <a href='mailto:dl-raa-teamriskybusiness@anthem.com'>dl-raa-teamriskybusiness@anthem.com</a></p></body></html>"
            
            msg = MIMEMultipart()
            msg['From'] = sender_email
            msg['To'] = primary_list
            if secondary_list:
                msg['Cc'] = secondary_list
            msg['Subject'] = subject
            msg.attach(MIMEText(body, 'html'))
            
            recipients = [primary_list]
