    FROM temp_db.temp_schema.mbrprov_table_data;

    -- Step 6b: Insert into RAD_DATAVANT_CHASE_CPL
    INSERT INTO U01_RAA.RAA_RAWZ.RAD_DATAVANT_CHASE_CPL (
        EDL_LOAD_DTM,
        EDL_RUN_ID,
        EDL_SCRTY_LVL_CD,
        EDL_LOB_CD,
        EDL_EXTRNL_LOAD_CD,
        EDL_SOR_CD,
        PROJECTID,
        CLIENTCHARTID,
        RENDERINGPROVIDERGROUPNAME,
        RENDERINGPROVIDERFIRSTNAME,
        RENDERINGPROVIDERLASTNAME,
        SPECIFICLOCATIONOFCAREADDRESS1,
