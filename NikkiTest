-- 1. Confirm the User record
SELECT Id, OktaCid, UserName, EmailAddress, StatusId, CreatedDate
FROM [DMS_Mimic].[dbo].[User]
WHERE UserName LIKE '%Anorga%' OR EmailAddress LIKE '%Anorga%';

-- 2. Confirm the Application record
SELECT * FROM [DMS_Mimic].[dbo].[Application] WHERE UserId = 20138;

-- 3. Confirm the Cloa history (this is the core evidence)
SELECT Id, OfficeId, AppointingOfficialId, CloaStatusId, UpdatedDate
FROM [DMS_Mimic].[dbo].[Cloa]
WHERE ApplicationId = 20896
ORDER BY UpdatedDate DESC;

-- 4. Confirm the invalid AO doesn't exist
SELECT Id, UserName, EmailAddress, StatusId
FROM [DMS_Mimic].[dbo].[User]
WHERE Id = 212065;

-- 5. Confirm who made the change and when (CloaHistory)
SELECT * FROM [DMS_Mimic].[dbo].[CloaHistory]
WHERE Id = 147168
ORDER BY SysStartDate;
