  practicalTypes: SelectItem[] = [];
  tempPracticalTypes: SelectItem[] = [];
  includeFunctionCode: number []  = [1287, 1307];
  gradeCertificates: SelectItem[] = [];
  aircraftCategories: SelectItem[] = [];
  aircraftClass: SelectItem[] = [];
  makeModels: LookupItem[] = [];
  gradeOfCertificateTypeEnum: typeof GradeofCertificateEnum = GradeofCertificateEnum;
  isLoaded = false;
  todayDate: Date = new Date();
  functionCodeSelection: FunctionCodeSelectionViewModel | undefined | null;
  isAdminPreapprovals = false;
  isAdminPeGen = false;
  previousAuthorizationRecord?: boolean;
  previousSelectedAuthorizations: FunctionCode[] = [];
  previousSelectedAirportNotRequired?: boolean;
  isRenewalofCFI = false;
