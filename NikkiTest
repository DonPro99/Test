    def _formatValue(self, value):
        if value is None:
            return 'NULL'
        return f"'{str(value).replace(chr(39), chr(39)+chr(39))}'"
    
    def _formatTimestamp(self, value):
        if value is None:
            return 'NULL'
        return f"'{value}'"


class S3Service:
    
    def __init__(self, sub_group_name=None):
        import boto3
        self.client = boto3.client('s3')
        self.bucket = os.getenv('S3_BUCKET', 'crln-raa-uat-codez-nogbd-phi-useast1')
        self.prefix = os.getenv('S3_PREFIX', 'raa/genaisa/sql')
        self.sub_group_name = sub_group_name
    
    def getFullPath(self, filename):
        if filename.startswith('s3://'):
            path_parts = filename[5:].split('/', 1)
            return path_parts[0], path_parts[1] if len(path_parts) > 1 else ''
        else:
            if self.sub_group_name:
                return self.bucket, f"{self.prefix}/{self.sub_group_name}/{filename}"
            else:
                return self.bucket, f"{self.prefix}/{filename}"
    
    def fileExists(self, filename):
        bucket, key = self.getFullPath(filename)
        try:
            self.client.head_object(Bucket=bucket, Key=key)
            return True
        except ClientError as e:
            return False if e.response['Error']['Code'] == '404' else (_ for _ in ()).throw(e)
    
    def readFile(self, filename):
        bucket, key = self.getFullPath(filename)
        response = self.client.get_object(Bucket=bucket, Key=key)
        content = response['Body'].read().decode('utf-8')
        logging.info(f"Read file from S3: s3://{bucket}/{key} ({len(content)} bytes)")
        return content
    
    def readFileBinary(self, bucket, key):
        """Read file in binary mode"""
        response = self.client.get_object(Bucket=bucket, Key=key)
        return response['Body'].read()
    
    def writeFileBinary(self, bucket, key, content_bytes):
        """Write file in binary mode"""
        self.client.put_object(Bucket=bucket, Key=key, Body=content_bytes)
        logging.info(f"Wrote file to S3: s3://{bucket}/{key} ({len(content_bytes)} bytes)")
    
    def listObjects(self, bucket, prefix, continuation_token=None):
        """List objects with pagination support"""
        params = {'Bucket': bucket, 'Prefix': prefix}
        if continuation_token:
            params['ContinuationToken'] = continuation_token
        return self.client.list_objects_v2(**params)
    
    def getLatestFolder(self, bucket, prefix):
        """Get the latest timestamped folder in S3 path"""
        import boto3
        s3_resource = boto3.resource('s3')
        objects = list(s3_resource.Bucket(bucket).objects.filter(Prefix=prefix))
        
        if not objects:
            raise ValueError(f"No objects found in s3://{bucket}/{prefix}")
        
        objects.sort(key=lambda o: o.last_modified)
        latest_key = objects[-1].key
        latest_date_str = latest_key.replace(prefix, '').split('/', 1)[0]
        final_prefix = prefix + latest_date_str + "/"
        
        logging.info(f"Latest folder: s3://{bucket}/{final_prefix}")
        return final_prefix


class Gatekeeping:
    
    def __init__(self, snowflake, s3):
        self.snowflake = snowflake
        self.s3 = s3
        self.masterConfig = None
        self.runConfig = None
        self.genAiSaId = None
    
    def validateS3File(self, sql_filename):
        self.masterConfig = self.snowflake.getMasterConfig(sql_filename)
        
        if not self.masterConfig:
            error_msg = f"SQL file '{sql_filename}' not found in GENAISA_MASTER_CONFIG"
            logging.error(error_msg)
            self.sendNotification("FAILED", error_msg)
            raise ValueError(error_msg)
        
        self.genAiSaId = self.masterConfig.get('GEN_AI_SA_ID')
        executable_sql_file = self.masterConfig.get('EXECUTABLE_SQL_FILE')
        sub_group_name = self.masterConfig.get('SUB_GROUP_NAME')
        
        # Update S3Service with sub_group_name from master config
        self.s3.sub_group_name = sub_group_name
        logging.info(f"S3 sub-group path set to: {sub_group_name}")
        
        s3_bucket = os.getenv('S3_BUCKET', 'crln-raa-uat-codez-nogbd-phi-useast1')
        s3_prefix = os.getenv('S3_PREFIX', 'raa/genaisa/sql')
        #self.s3Path = f"s3://{s3_bucket}/{s3_prefix}/{executable_sql_file}"
        self.s3Path = executable_sql_file
                
        if not self.s3.fileExists(self.s3Path):
            error_msg = f"SQL file not found in S3: {self.s3Path}"
            logging.error(error_msg)
            self.sendNotification("FAILED", error_msg)
            raise FileNotFoundError(error_msg)
        
        logging.info(f"SQL file validated: {self.s3Path}")
    
    def validateRunConfig(self):
        self.runConfig = self.snowflake.getConfig('GENAISA_RUN_CONFIG', self.genAiSaId)
        
        if not self.runConfig:
            error_msg = f"RUN_CONFIG not found for GEN_AI_SA_ID: {self.genAiSaId}"
            logging.error(error_msg)
            self.sendNotification("FAILED", error_msg)
            raise ValueError(error_msg)
        
        if not self.runConfig.get('ACTIVE'):
            error_msg = f"Job disabled for GEN_AI_SA_ID: {self.genAiSaId}"
            logging.warning("Job is disabled in RUN_CONFIG")
            self.sendNotification("DISABLED", error_msg)
            raise ValueError("Job is disabled in RUN_CONFIG")
        
        logging.info(f"RUN_CONFIG validated: ACTIVE=True, "
                   f"EXECUTION_FLG={self.runConfig.get('EXECUTION_FLG')}, "
                   f"STITCHING_FLG={self.runConfig.get('STITCHING_FLG')}, "
                   f"DISPATCH_FLG={self.runConfig.get('DISPATCH_FLG')}")
    
    def validateDependentConfigs(self):
        for flag, table in [('STITCHING_FLG', 'GENAISA_STITCHING_CONFIG'), ('DISPATCH_FLG', 'GENAISA_LAMBDA_CONFIG')]:
            if self.runConfig.get(flag):
                if not self.snowflake.getConfig(table, self.genAiSaId):
                    error_msg = f"{table} not found for GEN_AI_SA_ID: {self.genAiSaId}"
                    logging.error(error_msg)
                    self.sendNotification("FAILED", error_msg)
                    raise ValueError(error_msg)
    
    def sendNotification(self, status, error=""):
