get isAutoPreApproval(): boolean {
  const testCheckInfo = this.pr?.testCheckInformation as any;

  if (testCheckInfo?.isOtherAdminActivity) {
    return true;
  }

  const isInsideDistrict = !this.pr?.activityLocation?.isOutsideOfficeDistrict;
  if (!isInsideDistrict) {
    return false;
  }

  const designeeTypeId = this.pr?.designeeInfo?.typeId;

  if (designeeTypeId === DesigneeTypeEnum.ADMINPEGEN || designeeTypeId === 31) {
    const requestedAuthorizations = testCheckInfo?.requestedAuthorizations ?? [];

    // Extract code labels that the AO/MS explicitly set for auto-preapproval
    const autoApprovedCodes = requestedAuthorizations
      .filter((a: any) => a.isAutoPreApproval || a.isAutomaticPreapproval)
      .map((a: any) => (a.functionCode || a.name || '').toUpperCase());

    // Mapping UI checkboxes to code labels
    const adminPeGenCheckboxMap = [
      { isSelected: !!(testCheckInfo?.isAdminPeGenFpe || testCheckInfo?.isAdminPeGenFPE), code: 'FPE' },
      { isSelected: !!(testCheckInfo?.isAdminPeGenMce || testCheckInfo?.isAdminPeGenMCE), code: 'MCE' },
      { isSelected: !!(testCheckInfo?.isAdminPeGenGie || testCheckInfo?.isAdminPeGenGIE), code: 'GIE' },
      { isSelected: !!(testCheckInfo?.isAdminPeGenFire || testCheckInfo?.isAdminPeGenFIRE), code: 'FIRE' },
      { isSelected: !!(testCheckInfo?.isAdminPeGenBae || testCheckInfo?.isAdminPeGenBAE), code: 'BAE' }
    ];

    // Filter to selected codes
    const selectedCodes = adminPeGenCheckboxMap
      .filter(item => item.isSelected)
      .map(item => item.code);

    if (selectedCodes.length === 0) {
      return false;
    }

        // CHECK: At least one selected code matches an AO/MS auto-approved code
    const hasAutoApprovedSelection = selectedCodes.some(selectedCode =>
      autoApprovedCodes.some((approvedCode: string) => approvedCode.includes(selectedCode))
    );

    return hasAutoApprovedSelection;
  
  }

  // Standard Admin-PE fallback logic
  const selectedAuthorizations = testCheckInfo?.selectedRequestAuthorizations ?? [];
  const selectedFcs = selectedAuthorizations.map((item: any) => item.id);
  const requestedAuthorizations = testCheckInfo?.requestedAuthorizations ?? [];

  return (
    isInsideDistrict &&
    super.canAutoApprove(selectedFcs, requestedAuthorizations)
  );
}
}


