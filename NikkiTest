class Constants:
    def __init__(EMNF):
        pass

    def get_snowpark_session(EMNF,env):
        print("<< get_snowpark_session >>")
        try:
            region = boto3.Session().region_name
            client = boto3.client('secretsmanager', region_name=region)
            secretsConfig = client.get_secret_value(SecretId=f'{env}/snowflake/raa')
            if env == 'uat' :
                db_part = 'U01'
            elif env == 'prod' :
                db_part = 'P01'
            elif env == 'dev':
                db_part = 'D01'
            elif env == 'sit':
                db_part = 'T01'

            use_database = f"{db_part}_RAA"
            connection_parameters = {
                "account": "{0}".format(eval(secretsConfig['SecretString']).get('account').replace("\"", "")),
                "user": eval(secretsConfig['SecretString']).get('raa_user'),
                "password": eval(secretsConfig['SecretString']).get('raa_password'),
                "role": eval(secretsConfig['SecretString']).get('raa_role'),
                "warehouse": f"{db_part}_RAA_LOAD_WH_XL",
                "database": use_database,
                "schema": 'RAA_RAWZ'
            }
            session = Session.builder.configs(connection_parameters).create()
            return session
        except Exception as err:
            raise err

def email_handler(env,table):
    print("<< Running Email Handler >>>>")
    try:
        constant_obj = Constants()
        spark = constant_obj.get_snowpark_session(env)
        file_date = datetime.datetime.now().strftime("%Y-%m-%d")

        fromaddr = "raa-do-not-reply@anthem.com"
