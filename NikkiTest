@if (isLoaded && form) {
  <div [formGroup]="$any(form)" id="preApprovalApplicationInfo"class="mb-3">
    <p-panel id="preApprovalApplicationInfoPanel" [toggleable]="true" header="Application Information">
      @if (!isAfsGroup2 && !isDpre) {
        <dms-dropdown [filter]="false" (clickEvent)="onDataChange()" [options]="certificationRatingTypes"
          formControlName="certificateRatingTypeId" identity="id_appinfo_pdd_certificateRatingTypeId"
          placeholder="Select an Rating"  layout="grid" controlSize="medium" [validationMessages]="certificationRatingTypeValidationMessage"
          label="Certificate or Rating applied for on the basis of">
        </dms-dropdown>
      }
      @if (isAfsGroup2) {
        <dms-check-box-group identity="id_appinfo_chk_certificateRatingTypeId" layout="flex"
          [formControl]="$any(form.get('certificateRatingTypeId'))" [checkBoxValues]="certificationRatingTypesLabelValuePair"
          label="Certificate or Rating applied for on the basis of" [validationMessages]="certificationRatingTypeCheckboxErrorMessage"
          [doSpotLight]="markAsModified(modifiedControls, 'certificateRatingTypeId').borderRed">
        </dms-check-box-group>
      }
      @if ((!isAfsGroup2 && !isDpre && form.get('certificateRatingTypeId')?.value === 1) || (isAfsGroup2 && showFollowUp(3))) {
        <dms-auto-complete
          label="Name and designation number of FAA-approved school in which the applicant enrolled" (completeMethod)="filterSchools($event)"
          (clearEvent)="clearSchool()" (focusEvent)="onDataChange()" [forceSelection]="true" [minLength]="2" formControlName="schoolId"
          [doSpotLight]="markAsModified(modifiedControls, 'schoolId').borderRed"  identity="id_applicationinfo_pac_schoolid"
          [suggestions]="schools" field="name" ariaLabel="Search with School Name" [validationMessages]="schoolIdValidationMessage"
          controlSize="large">
        </dms-auto-complete>
      }
      @if (!isAfsGroup2 && !isDpre && form.get('certificateRatingTypeId')?.value === 1) {
        <dms-radio-button
          (clickEvent)="onDataChange()" [radioValues]="isCfrSectionTest" identity="id_appinfo_radio_isCfrSectionTest"
          formControlName="isCfrSectionTest"  label="14 CFR Section 65.80 test?"
          layout="grid" [doSpotLight]="markAsModified(modifiedControls, 'facilityonRecord').borderRed"
          [validationMessages]="isCfrSectionTestValidationMessage">
        </dms-radio-button>
      }
      @if ((!isAfsGroup2 && !isDpre && form.get('certificateRatingTypeId')?.value === 1) && form.get('isCfrSectionTest')?.value === true) {
        <dms-auto-complete
          label="Name and designation number of FAA-approved school in which the applicant enrolled" (completeMethod)="filterCfrSchools($event)"
          (clearEvent)="clearCfrSectionSchool()" (focusEvent)="onDataChange()" [forceSelection]="true" [minLength]="2" formControlName="cfrSectionSchoolId"
          [doSpotLight]="markAsModified(modifiedControls, 'cfrSectionSchoolId').borderRed"  identity="id_applicationinfo_pac_cfrSectionSchoolId_"
          [suggestions]="cfrSchools" field="name" ariaLabel="Search with School Name" [validationMessages]="schoolIdValidationMessage"
          controlSize="large">
        </dms-auto-complete>
      }
      @if ((!isAfsGroup2 && !isDpre && form.get('certificateRatingTypeId')?.value === 2) || isDpre) {
        <div class="grid col-12 p-0">
          <div class="col-12 c-label md:col-4 lg:col-4 xl:col-3 md:pt-3">
            <label for=""><span class="c-label-required">*</span>Type of Experience</label>
          </div>
          <div class="grid col-12 c-control gap-2 md:col-5 lg:col-5 xl:col-4">
            <dms-check-box-binary identity="id_appinfo_chk_isCivilExperience"
              [hideValidationPlaceHolder]="true" [value]="true" formControlName="isCivilExperience"
              label="Civil Experience" (clickEvent)="onDataChange()" layout="grid"
              [doSpotLight]="markAsModified(modifiedControls, 'isCivilExperience').borderRed">
            </dms-check-box-binary>
            <dms-check-box-binary identity="id_appinfo_chk_isMilitaryExperience"
              [hideValidationPlaceHolder]="true" [value]="true" formControlName="isMilitaryExperience"
              label="Military Experience" (clickEvent)="onDataChange()" layout="grid"
              [doSpotLight]="markAsModified(modifiedControls, 'isMilitaryExperience').borderRed">
            </dms-check-box-binary>
          </div>
          <div class="col-12 c-error-message md:col-3 lg:col-3 xl:col-5 md:pt-3">
            @if (form.hasError('experience') && (form.get('isCivilExperience')?.touched
              || form.get('isCivilExperience')?.dirty
              || form.get('isMilitaryExperience')?.touched
              || form.get('isMilitaryExperience')?.dirty)) {
              <span
                class="message-error-sm">
                Please select an option.
              </span>
            }
          </div>
        </div>
      }
      @if ((!isAfsGroup2 && !isDpre && form.get('certificateRatingTypeId')?.value === 2) || isDpre) {
        <dms-dropdown
          formControlName="authorizedTestOfficeId" [options]="offices"
          [disabled]="isDisabled || isEditPostActivity" [filter]="true" identity="id_appinfo_pdd_authorizedTestOfficeId"
          placeholder="Select a school"  layout="grid" controlSize="medium"
          [validationMessages]="authorizedTestOfficeIdValidationMessage"
          label="Office that authorized the test for this applicant"
          [doSpotLight]="markAsModified(modifiedControls, 'authorizedTestOfficeId').borderRed">
        </dms-dropdown>
      }
      @if (isAfsGroup2 && showFollowUp(4)) {
        <dms-dropdown [filter]="false" (clickEvent)="onDataChange()" [disabled]="isDisabled"
          [options]="countries" formControlName="pilotCountryId" identity="id_appinfo_pdd_pilotCountryId"
          placeholder="Select a country" layout="grid" controlSize="medium" [validationMessages]="pilotCountryIdValidationMessage"
          label="Country that Issued the foreign pilot license">
        </dms-dropdown>
      }
      @if (isAfsGroup2 && showFollowUp(5)) {
        <dms-auto-complete label="Name of Air Carrier" (completeMethod)="filterCarriers($event)"
          (clearEvent)="clearAirCarrierId()" [forceSelection]="true" [minLength]="3" [virtualScrollItemSize]="100" [suggestions]="carriers"
          ariaLabel="Search with air carrier" ield="name" formControlName="airCarrierId" field="name"
          identity="id_applicationinfo_pac_airCarrierId" [validationMessages]="airCarrierIdValidationMessage">
        </dms-auto-complete>
      }
    </p-panel>
  </div>
}
