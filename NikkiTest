  isTemporaryFunctionCodeRadioButtonValues: LabelValueModel[] = [
    { label: "Select Authorization", value: true },
    { label: "Temporary Authorization", value: false }
  ];
  isMultipleApplicantsRadioButtonValues: LabelValueModel[] = [
    { label: "Yes", value: true },
    { label: "No", value: false }
  ];

  private static atLeastOneAdminPeGenAuthRequired(): (control: AbstractControl) => { [key: string]: boolean } | null {
  return (group: AbstractControl) => {
    const codes = ['isAdminPeGenFPE', 'isAdminPeGenMCE', 'isAdminPeGenGIE', 'isAdminPeGenFIRE', 'isAdminPeGenBAE'];
    const anyChecked = codes.some((code) => group.get(code)?.value === true);
    return anyChecked ? null : { adminPeGenAuthRequired: true };
  };
}

  constructor(
    private fb: FormBuilder,
    private lookupService: LookupService,
    public util: UtilityService,
    private route: ActivatedRoute,
  ) { super(); }

  get showTypeofPractical() {
    let showThisField = true;

    showThisField = (!this.isPostActivity || (this.isPostActivity && this.isAdminPreapprovals));

    if(this.isDpeSaeSMFT()){
      showThisField = false;
      if(this.isPracticalOralTestIdRequired){
        this.form!.get('practicalOralTestId')?.clearValidators();
        this.form!.get('practicalOralTestId')?.updateValueAndValidity();
      }      
    }else if(this.isPracticalOralTestIdRequired && !this.util.hasRequiredField(this.form,'practicalOralTestId')){
      this.form!.get('practicalOralTestId')?.setValidators(Validators.required);
      this.form!.get('practicalOralTestId')?.updateValueAndValidity();
    }

    return showThisField;
  }

  get showGradeofCertificate() {
    let showThisField = true;

    showThisField = (
      !this.isRenewalofCFI &&
      !this.isProficiencyCheck &&
      !this.hideFlightInfo &&
      (!this.isPostActivity ||
        (this.isPostActivity && this.isAdminPreapprovals))
    );

    if(this.isDpeSaeSMFT()){
      showThisField = false;
    }

    return showThisField;
  }

  get showAircraftCategory() {
    const gradeCertificateId = this.getControlValue('gradeCertificateId');
    return (
      gradeCertificateId &&
      gradeCertificateId !== 0 &&
      this.aircraftCategories &&
      this.aircraftCategories.length > 0 &&
      gradeCertificateId !== this.gradeOfCertificateTypeEnum.NADpe &&
      gradeCertificateId !== this.gradeOfCertificateTypeEnum.NASae &&
      gradeCertificateId !== this.gradeOfCertificateTypeEnum.NAAdminPe &&
      !this.isRenewalofCFI &&
      !this.isProficiencyCheck &&
      (!this.isPostActivity ||
        (this.isPostActivity && this.isAdminPreapprovals))
    );
  }

  get showAircraftClass() {
    const gradeCertificateId = this.getControlValue('gradeCertificateId');
    const aircraftCategoryId = this.getControlValue('aircraftCategoryId');

    return (
      aircraftCategoryId &&
      gradeCertificateId !== this.gradeOfCertificateTypeEnum.NADpe &&
      gradeCertificateId !== this.gradeOfCertificateTypeEnum.NASae &&
      gradeCertificateId !== this.gradeOfCertificateTypeEnum.NAAdminPe &&
      aircraftCategoryId !== 0 &&
      this.aircraftClass &&
      this.aircraftClass.length > 0 &&
      !this.isRenewalofCFI &&
      !this.isProficiencyCheck &&
      (!this.isPostActivity ||
        (this.isPostActivity && this.isAdminPreapprovals))
    );
  }

  get showAirCraft(){
    let showThisField = true;

    showThisField  = ((this.getControlValue('isAircraftNotRequired') == null ||
    (this.getControlValue('isAircraftNotRequired') != null &&
      !this.getControlValue('isAircraftNotRequired'))) &&
      !this.hideFlightInfo);

      if(this.isAdminPreapprovals && this.isDpeSaeSMFT()){
        showThisField = false;
      }

      if (this.isAdminPeGen) {
        showThisField = false;
      }

    return showThisField;
  }
  private static normalizeOptions(options: any): any {
    const result = { ...(options ?? {}) };
    if (result.categoryId === undefined) result.categoryId = 0;
    if (result.isPostActivity === undefined) result.isPostActivity = false;
    if (result.isDisabled === undefined) result.isDisabled = false;
    return result;
  }

  private static computeFlags(model: PreApprovalTestCheckInformation, options: any) {
    const flags: any = {};
    flags.isAdminPreapprovals = options.categoryId !== 0 || options.designeeTypeId === DesigneeTypeEnum.ADMINPE || options.designeeTypeId === DesigneeTypeEnum.ADMINPEGEN;
    flags.isAdminPeGen = options.designeeTypeId === DesigneeTypeEnum.ADMINPEGEN;
    flags.isGroup2PostActivity = options.isPostActivity && (options.designeeTypeId === DesigneeTypeEnum.DPE || options.designeeTypeId === DesigneeTypeEnum.SAE || options.designeeTypeId === DesigneeTypeEnum.ADMINPE || options.designeeTypeId === DesigneeTypeEnum.ADMINPEGEN);
    flags.isDpeSae = options.designeeTypeId === DesigneeTypeEnum.DPE || options.designeeTypeId === DesigneeTypeEnum.SAE;
    flags.isApplicantCertificateRequired = options.isPostActivity && !flags.isDpeSae && !flags.isAdminPreapprovals;
    flags.aircraftMakeModelId = model.isAircraftNotRequired ? null : model.aircraftMakeModelId;
    flags.isTemporaryFunctionCode = DmsTestCheckInformationComponent.setTemporaryFunctionCode(
                                                model, options.designeeTypeId, options.categoryId);
    return flags;
  }
  public static buildForm(
    model: PreApprovalTestCheckInformation,
    testInformation: PreApprovalTestInformation,
    applicantInformation: PreApprovalApplicantInformation,
    options: any
  ): FormGroup {
    options = DmsTestCheckInformationComponent.normalizeOptions(options);
    const flags = DmsTestCheckInformationComponent.computeFlags(model, options);
    const fb = new FormBuilder();
    let controls: Record<string, any> = {};

    const tempAuthRequired = (!flags.isAdminPreapprovals && model.temporaryAuthorizations!.length !== 0) ? [Validators.required] : [];
    controls = addFormControl(controls, 'reasonforAuthorization', model.reasonforAuthorization, options.isDisabled, tempAuthRequired);
    controls = addFormControl(controls, 'practicalOralTestId', testInformation.practicalOralTestId, options.isDisabled, 
                              options.isPostActivity && flags.isAdminPreapprovals ? [Validators.required] : []);
    if (flags.isAdminPeGen && !flags.isPostActivity) {
    controls = addFormControl(controls, 'isAdminPeGenFPE', model.isAdminPeGenFPE ?? false, options.isDisabled, []);
    controls = addFormControl(controls, 'isAdminPeGenMCE', model.isAdminPeGenMCE ?? false, options.isDisabled, []);
    controls = addFormControl(controls, 'isAdminPeGenGIE', model.isAdminPeGenGIE ?? false, options.isDisabled, []);
    controls = addFormControl(controls, 'isAdminPeGenFIRE', model.isAdminPeGenFIRE ?? false, options.isDisabled, []);
    controls = addFormControl(controls, 'isAdminPeGenBAE', model.isAdminPeGenBAE ?? false, options.isDisabled, []);
    }                         
    controls = addFormControl(controls, 'gradeCertificateId', model.gradeCertificateId, options.isDisabled, []);
    controls = addFormControl(controls, 'aircraftCategoryId', model.aircraftCategoryId, options.isDisabled, []);
    controls = addFormControl(controls, 'aircraftClassId', model.aircraftClassId, options.isDisabled, []);
    controls = addFormControl(controls, 'aircraftMakeModelId', flags.aircraftMakeModelId, options.isDisabled, 
                              !flags.isAdminPreapprovals ? [Validators.required] : []);

    controls = addFormControl(controls, 'name', applicantInformation.name, flags.isGroup2PostActivity ? true : options.isDisabled,
      options.categoryId === 0 && !model.isMultipleApplicants && options.isPostActivity && !flags.isGroup2PostActivity
        ? [Validators.required] : []);
    if(flags.isApplicantCertificateRequired ) {
      controls = addFormControl(controls, 'certificateNumber', applicantInformation.certificateNumber, options.isDisabled, [Validators.required] );
    } else {
      controls = addFormControl(controls, 'certificateNumber', applicantInformation.certificateNumber, flags.isGroup2PostActivity ? true : options.isDisabled, [] );
    }
    controls = addFormControl(controls, 'isTemporaryFunctionCode', flags.isTemporaryFunctionCode, options.isDisabled,
      !flags.isAdminPreapprovals && model.isTemporaryFunctionCode == null ? [Validators.required] : []);
    controls = addFormControl(controls, 'isAircraftNotRequired', model.isAircraftNotRequired, options.isDisabled, []);
    const disabledMA = options.isDisabled || options.isPostActivity;
    controls = addFormControl(controls, 'isMultipleApplicants', model.isMultipleApplicants, disabledMA, disabledMA ? [] : []);
    controls = addFormControl(controls, 'isRecommendingInstructorNotAvailable', model.isRecommendingInstructorNotAvailable, options.isDisabled, []);
    controls = addFormControl(controls, 'recommendingInstructor', model.recommendingInstructor, options.isDisabled, []);
    controls = addFormControl(controls, 'recommendingInstructorCertificateNumber', model.recommendingInstructorCertificateNumber, options.isDisabled, []);
    
    return this.buildFormAndAudit(fb, flags, model, testInformation, controls, options);
  }
  private static buildFormAndAudit(fb: FormBuilder, flags: any, model: PreApprovalTestCheckInformation, 
    testInformation: PreApprovalTestInformation, controls: Record<string, FormControl>, options: any) {
    const form = fb.group(controls);

    if (flags.isAdminPreapprovals) {
      (form as any).addControl(
        'isOtherAdminActivity',
        new FormControl({ value: model.isOtherAdminActivity, disabled: options.isDisabled }, [])
      );
    }

    if (!options.isPostActivity) {
      (form as any).addControl(
        'testInformation',
        DmsTestInformationComponent.buildForm(testInformation, {
          designeeTypeId: options.designeeTypeId,
          isReadOnly: options.isDisabled,
        })
      );
    }

    let hideFlightInfo = flags.isAdminPreapprovals ? model.isOtherAdminActivity : false;
    if (
      (options.categoryId === CategoryEnum.AdminSae || options.categoryId === CategoryEnum.AdminDpe) &&
      (model.adminDpeSaeFunctionCodes?.length ?? 0) === 0
    ) {
      (form as any).get('isOtherAdminActivity')?.setValue(true as never);
      hideFlightInfo = true;
    }

    const functionCodeSelection = DmsTestCheckInformationComponent.selectAuthorizations(
      model,
      options.designeeTypeId,
      options.categoryId,
      options.isDisabled
    );

    if (functionCodeSelection != null && functionCodeSelection.functionCodes != null && !hideFlightInfo) {
      (form as any).addControl(
        'functionCodeSelection',
        DmsFunctionCodeSelectionComponent.buildForm(
          functionCodeSelection,
          true,
          options.isDisabled,
          options.designeeTypeId
        )
      );
    }

    if (flags.isAdminPeGen && !flags.isPostActivity) {
      (form as any).addControl('isAdminPeGenFPE', new FormControl({ value: model.isAdminPeGenFPE ?? false, disabled: options.isDisabled }));
      (form as any).addControl('isAdminPeGenMCE', new FormControl({ value: model.isAdminPeGenMCE ?? false, disabled: options.isDisabled }));
      (form as any).addControl('isAdminPeGenGIE', new FormControl({ value: model.isAdminPeGenGIE ?? false, disabled: options.isDisabled }));
      (form as any).addControl('isAdminPeGenFIRE', new FormControl({ value: model.isAdminPeGenFIRE ?? false, disabled: options.isDisabled }));
      (form as any).addControl('isAdminPeGenBAE', new FormControl({ value: model.isAdminPeGenBAE ?? false, disabled: options.isDisabled }));

      form.setValidators([
        ...(form.validator ? [form.validator] : []),
        DmsTestCheckInformationComponent.atLeastOneAdminPeGenAuthRequired(),
      ]);
      form.updateValueAndValidity();
    }

    return form;
  }

  public static buildModel(
    form: FormGroup,
    model: PreApprovalTestCheckInformation,
    testInformation: PreApprovalTestInformation,
    applicantInformation: PreApprovalApplicantInformation,
    designeeTypeId: number,
    categoryId: number
  ) {
    const value = form.getRawValue();
    model.reasonforAuthorization = value.reasonforAuthorization;
    model.gradeCertificateId = value.gradeCertificateId;
    model.aircraftCategoryId = value.aircraftCategoryId;
    model.aircraftClassId = value.aircraftClassId;
    model.aircraftMakeModelId = value.aircraftMakeModelId;
    model.isTemporaryFunctionCode = value.isTemporaryFunctionCode;
    model.isAircraftNotRequired = value.isAircraftNotRequired;
    model.isMultipleApplicants = value.isMultipleApplicants;
    model.isAdminPeGenFPE = value.isAdminPeGenFPE;
    model.isAdminPeGenMCE = value.isAdminPeGenMCE;
    model.isAdminPeGenGIE = value.isAdminPeGenGIE;
    model.isAdminPeGenFIRE = value.isAdminPeGenFIRE;
    model.isAdminPeGenBAE = value.isAdminPeGenBAE;
    model.isRecommendingInstructorNotAvailable = value.isRecommendingInstructorNotAvailable;
    model.recommendingInstructor = value.recommendingInstructor;
    model.recommendingInstructorCertificateNumber = value.recommendingInstructorCertificateNumber;
    model.practicalOralTestId = value.practicalOralTestId;
    if (form.get('isOtherAdminActivity')) {
      model.isOtherAdminActivity = value.isOtherAdminActivity;
    }

    if (form.get('testInformation')) {
      const testInformationFormGroup = form.get('testInformation') as FormGroup;
      testInformationFormGroup.get('practicalOralTestId')?.setValue(value.practicalOralTestId);
      DmsTestInformationComponent.buildModel(testInformationFormGroup, testInformation);
    }

    applicantInformation.name = value.name;
    applicantInformation.certificateNumber = value.certificateNumber;

    if (form.get('functionCodeSelection') && !model.isOtherAdminActivity) {
      const functionCodeSelection = DmsTestCheckInformationComponent.selectAuthorizations(
        model,
        designeeTypeId,
        categoryId
      );
      DmsFunctionCodeSelectionComponent.buildModel(
        form.get('functionCodeSelection') as FormGroup,
        functionCodeSelection,
        true
      );

      // clear previous
      model.selectedTemporaryAuthorizations = [];
      model.selectedRequestAuthorizations = [];

      if (model.isTemporaryFunctionCode) {
        model.selectedRequestAuthorizations =
          functionCodeSelection.selectedFunctionCodes;
      } else {
        model.selectedTemporaryAuthorizations =
          functionCodeSelection.selectedFunctionCodes;
      }
    }
    if (model.isOtherAdminActivity) {
      model.selectedTemporaryAuthorizations = [];
      model.selectedRequestAuthorizations = [];
    }
  }

  public static selectAuthorizations(
    testCheckInformation: PreApprovalTestCheckInformation,
    designeeTypeId: number,
    categoryId: number,
    isDisabled?: boolean
  ): FunctionCodeSelectionViewModel {
    const isTemporaryFunctionCode = DmsTestCheckInformationComponent.setTemporaryFunctionCode(
      testCheckInformation,
      designeeTypeId,
      categoryId
    );

    const functionCodes = categoryId !== 0
      ? (isDisabled ? testCheckInformation.adminDpeSaeFunctionCodes : testCheckInformation.adminDpeSaeFunctionCodes?.filter(v => v.id != RPEFunctionCodeEnum.FunctionCodeDPERPE &&  v.id != RPEFunctionCodeEnum.FunctionCodeSAERPE))  
      : isTemporaryFunctionCode
        ? testCheckInformation.requestedAuthorizations
        : testCheckInformation.temporaryAuthorizations;

    const functionCodesSelection = new FunctionCodeSelectionViewModel();
    functionCodesSelection.functionCodes = functionCodes;
    functionCodesSelection.title = isTemporaryFunctionCode
      ? 'Authorizations'
      : 'Temporary Authorizations';
    functionCodesSelection.isRequired = true;
    const isNewPreapproval =
      testCheckInformation.selectedRequestAuthorizations == null &&
      testCheckInformation.selectedTemporaryAuthorizations == null;
    functionCodesSelection.selectedFunctionCodes = isNewPreapproval
      ? []
      : isTemporaryFunctionCode
        ? testCheckInformation.selectedRequestAuthorizations
        : testCheckInformation.selectedTemporaryAuthorizations;

    return functionCodesSelection;
  }

  public static setTemporaryFunctionCode(
    testCheckInformation: PreApprovalTestCheckInformation,
    designeeTypeId: number,
    categoryId: number
  ): boolean {
    if (
      testCheckInformation.temporaryAuthorizations?.length === 0 ||
      designeeTypeId === DesigneeTypeEnum.ADMINPE ||
      (categoryId || 0) !== 0
    ) {
      return true;
    }
    return testCheckInformation.isTemporaryFunctionCode as boolean;
  }

  async ngOnInit() {
    this.todayDate = new Date();
    await this.lookupService.populateLookupData();
    this.populateData();
    this.initializeTestComponent();
    this.isPracticalOralTestIdRequired = this.util.hasRequiredField(this.form,'practicalOralTestId');
    this.tempPracticalTypes = this.practicalTypes;
    if(this.isDpeSae && this.isAdminPreapprovals){      
      if(!(this.includeFunctionCode.some((f) => f === this.form!.get('functionCodeSelection.functionCode')?.value))){
        this.practicalTypes = this.tempPracticalTypes.filter(pt => {return pt.value != 70});
      }    
    }
  }

  checkTestControlHasChanged(name: string) {
    if (this.modifiedTestInfoControls != null && this.modifiedTestInfoControls.length > 0) {
      return this.modifiedTestInfoControls.findIndex((d) => d.control === name) > -1;
    }
    return false;
  }

  checkApplicantControlHasChanged(name: string) {
    if (this.modifiedApplicantInfoControls != null && this.modifiedApplicantInfoControls.length > 0) {
      return this.modifiedApplicantInfoControls.findIndex((d) => d.control === name) > -1;
    }
    return false;
  }

  public getControlValue(path: string) {
    return this.util.getControlValue(this.form, path);
  }

  public setControlValue(path: string, value: any) {
    this.util.setControlValue(this.form, path, value);
  }

  populateData(): any {
    const designeeTypeId =
      this.categoryId !== 0 ? DesigneeTypeEnum.ADMINPE : this.designeeTypeId;
    this.practicalTypes = this.lookupService.getPracticalTypesDesigneeTypeId(
      designeeTypeId!
    );
    // this logic is to cover all the admin preapproval functionalities
    this.gradeCertificates = this.lookupService.getGradeCertificateTypes(
      designeeTypeId!
    );
    this.isAdminPreapprovals =
      this.categoryId !== 0 || this.designeeTypeId === DesigneeTypeEnum.ADMINPE || this.designeeTypeId === DesigneeTypeEnum.ADMINPEGEN;
    this.isAdminPeGen = this.designeeTypeId === DesigneeTypeEnum.ADMINPEGEN;
    this.hideFlightInfo = this.isAdminPreapprovals
      ? this.getControlValue('isOtherAdminActivity')
      : false;
    // this.testCheckInformation?.aircraftMakeModelId = this.testCheckInformation?.isAircraftNotRequired ?
    //     null : this.testCheckInformation?.aircraftMakeModelId;
  }

  addEvent() {
    this.form!
      .get('isAircraftNotRequired')
      ?.valueChanges.pipe(
        takeUntil(this.destroying$),
        startWith(this.getControlValue('isAircraftNotRequired'))
      )
      .subscribe((aircraft?: boolean) => {
        if ((aircraft != null && aircraft) || this.isAdminPreapprovals) {
          this.form!.get('aircraftMakeModelId')?.setValidators([]);
        } else {
          this.form!
            .get('aircraftMakeModelId')
            ?.setValidators([Validators.required]);
        }
        this.form!.get('aircraftMakeModelId')?.updateValueAndValidity();
        if((this.designeeTypeId === DesigneeTypeEnum.DPE || this.designeeTypeId === DesigneeTypeEnum.SAE) && !this.isAdminPreapprovals){
          this.OnAircraftNotRequiredChange.emit(aircraft);
        }
      });

      this.form!
      .get('isTemporaryFunctionCode')
      ?.valueChanges.pipe(
        takeUntil(this.destroying$),
        startWith(this.getControlValue('isTemporaryFunctionCode'))
      )
      .subscribe((isTemporaryFunctionCode?: boolean) => {
        const isFunctionCodeTouched = this.form!.get('functionCodeSelection') && (this.form!.get('functionCodeSelection')?.touched == true);
        // remove functioncodeselection
        if (isTemporaryFunctionCode == null) {
          (this.form as any).removeControl('functionCodeSelected');
          this.form?.updateValueAndValidity();
          return;
        }
        this.isTempAuthorizations = isTemporaryFunctionCode;
        // build functioncodeselection
        const testCheckInformation = cloneDeep(this.testCheckInformation);
        const isDisabled =
        this.form?.get('functionCodeSelection') && this.form?.get('functionCodeSelection')?.status === 'DISABLED';
        testCheckInformation!.isTemporaryFunctionCode = isTemporaryFunctionCode;
        this.functionCodeSelection = DmsTestCheckInformationComponent.selectAuthorizations(
          testCheckInformation!,
          this.designeeTypeId!,
          this.categoryId,
          isDisabled!
        );       
          (this.form as any).removeControl('functionCodeSelection');
        if (this.util.getControlValue(this.form, 'isOtherAdminActivity') !== true) {
          (this.form as any).addControl(
            'functionCodeSelection',
            DmsFunctionCodeSelectionComponent.buildForm(
              this.functionCodeSelection,
              true,
              isDisabled!,
              this.designeeTypeId!
            )
          );
          this.form!.get('functionCodeSelection')?.updateValueAndValidity();
          if (isFunctionCodeTouched) {
            this.form!.get('functionCodeSelection')?.markAllAsTouched();
          }
        }
        if (isTemporaryFunctionCode) {
          this.form!.get('reasonforAuthorization')?.setValidators([]);
        } else {
          this.form!
            .get('reasonforAuthorization')
            ?.setValidators([Validators.required]);
        }
        
        if (this.form!.get('isTemporaryFunctionCode')?.touched) {
          this.form!.get('reasonforAuthorization')?.setValue(null);
        }

        this.form!.get('reasonforAuthorization')?.updateValueAndValidity();
      });

      this.form!
      .get('practicalOralTestId')
      ?.valueChanges.pipe(takeUntil(this.destroying$), startWith(this.getControlValue('practicalOralTestId')))
      .subscribe((practicalOralTestId?: any) => {
        this.isProficiencyCheck =
          practicalOralTestId === PracticalOralTestEnum.ProficiencyCheckDPE ||
          practicalOralTestId === PracticalOralTestEnum.ProficiencyCheckSAE;
        this.isRenewalofCFI =
          practicalOralTestId === PracticalOralTestEnum.RenewalofCFIDPE ||
          practicalOralTestId === PracticalOralTestEnum.RenewalofCFISAE ||
          practicalOralTestId === PracticalOralTestEnum.RenewalofCFIAdminPe;

        if (
          this.designeeTypeId === DesigneeTypeEnum.ADMINPE &&
          !practicalOralTestId
        ) {
          this.form!
            .get('gradeCertificateId')
            ?.setValue(GradeofCertificateEnum.NAAdminPe);
        }

        if (
          practicalOralTestId != null &&
          !this.isProficiencyCheck &&
          !this.isRenewalofCFI &&
          !this.hideFlightInfo &&
          !this.isDpeSae &&
          !this.isAdminPreapprovals &&
          this.isPostActivity
        ) {
          this.form!
            .get('gradeCertificateId')
            ?.setValidators([Validators.required]);
        } else {
          this.form!.get('gradeCertificateId')?.setValidators([]);
        }
        this.form!.get('gradeCertificateId')?.updateValueAndValidity();

        if (!this.isAdminPreapprovals) {
          this.emitProficienctCheckChange();
        }
      });

      this.form!
      .get('gradeCertificateId')
      ?.valueChanges.pipe(takeUntil(this.destroying$), startWith(this.getControlValue('gradeCertificateId')))
      .subscribe((gradeCertId?: any) => {
        this.gradeCertificateId = gradeCertId || 0;
        if (this.gradeCertificateId !== 0) {
          if (
            this.gradeCertificateId !== GradeofCertificateEnum.NADpe &&
            this.gradeCertificateId !== GradeofCertificateEnum.NASae &&
            this.gradeCertificateId !== GradeofCertificateEnum.NAAdminPe &&
            !this.isRenewalofCFI &&
            !this.isProficiencyCheck
          ) {
            this.populateCategories(this.gradeCertificateId!);
            if (
              this.aircraftCategories != null &&
              this.aircraftCategories.length !== 0 &&
              !this.isDpeSae &&
              !this.isAdminPreapprovals &&
              this.isPostActivity
            ) {
              this.form!
                .get('aircraftCategoryId')
                ?.setValidators([Validators.required]);
            } else {
              this.form!.get('aircraftCategoryId')?.setValidators([]);
            }
            this.form!.get('aircraftCategoryId')?.updateValueAndValidity();
          }
        }
      });

      this.form!
      .get('aircraftCategoryId')
      ?.valueChanges.pipe(takeUntil(this.destroying$), startWith(this.getControlValue('aircraftCategoryId')))
      .subscribe((aircraftCategoryId?: any) => {
        this.aircraftCategoryId = aircraftCategoryId || 0;
        if (
          this.aircraftCategoryId !== 0 &&
          !this.isRenewalofCFI &&
          !this.isProficiencyCheck
        ) {
          this.populateAircraftClass(
            this.gradeCertificateId!,
            this.aircraftCategoryId!
          );
          if (
            this.aircraftClass != null &&
            this.aircraftClass.length !== 0 &&
            !this.isDpeSae &&
            !this.isAdminPreapprovals &&
            this.isPostActivity
          ) {
            this.form!
              .get('aircraftClassId')
              ?.setValidators([Validators.required]);
          } else {
            this.form!.get('aircraftClassId')?.setValidators([]);
          }
          this.form!.get('aircraftClassId')?.updateValueAndValidity();
        }
      });

      this.form!
      .get('isRecommendingInstructorNotAvailable')
      ?.valueChanges.pipe(
        takeUntil(this.destroying$),
        startWith(this.getControlValue('isRecommendingInstructorNotAvailable'))
      )
      .subscribe((isRecommendingInstructorNotAvailable?: any) => {
        if (this.isPostActivity && !this.isAdminPreapprovals) {
          if (isRecommendingInstructorNotAvailable) {
            this.form!.get('recommendingInstructor')?.setValidators([]);
            this.form!
              .get('recommendingInstructorCertificateNumber')
              ?.setValidators([]);
          } else {
            this.form!
              .get('recommendingInstructor')
              ?.setValidators([Validators.required]);
            this.form!
              .get('recommendingInstructorCertificateNumber')
              ?.setValidators([Validators.required]);
          }

          this.form!.get('recommendingInstructor')?.updateValueAndValidity();
          this.form!
            .get('recommendingInstructorCertificateNumber')
            ?.updateValueAndValidity();
        }
      });
  }

  onDataChange(event: any) {
    DmsFunctionCodeSelectionComponent.buildModel(
      this.form!.get('functionCodeSelection') as FormGroup,
      this.functionCodeSelection!,
      true
    );
    if(!this.form!.get('aircraftMakeModelId')?.disabled){
      this.setControlValue('aircraftMakeModelId', null);
    }
    if (this.isDpeSae) {
      this.funcionCodeChangeEvent.emit(event);
      if(this.isAdminPreapprovals){
        if((this.includeFunctionCode.some((f) => f === this.form!.get('functionCodeSelection.functionCode')?.value))){
          this.practicalOralTestTypes!.options = this.tempPracticalTypes;
        } else {
          if(this.form!.get('practicalOralTestId')?.value === 70){
            this.form!.get('practicalOralTestId')?.setValue(null);
          }
          this.practicalOralTestTypes!.options = this.tempPracticalTypes.filter(pt => {return pt.value != 70});        
        }
      }
    }
    if (this.triggerFieldChangeEvent) {
      this.onAuthorizationChange();
      this.emitFieldChange();
      event.preventDefault();
      if (navigator.userAgent.indexOf('Chrome') !== -1) {
        return false;
      }
    }
    return true;
  }

  onTextDataChange(event:any) {
    if (this.triggerFieldChangeEvent) {
      this.emitFieldChange();
    }
  }

  populateCategories(gradeCertificateId: number) {
    this.aircraftCategories = [];
    if (
      gradeCertificateId != null &&
      gradeCertificateId !== 0 &&
      gradeCertificateId !== GradeofCertificateEnum.NADpe &&
      gradeCertificateId !== GradeofCertificateEnum.NASae &&
      gradeCertificateId !== GradeofCertificateEnum.NAAdminPe
    ) {
      this.aircraftCategories = this.lookupService.getAircraftCategoryTypes(
        gradeCertificateId
      );
    }
  }

  populateAircraftClass(
    gradeCertificateId: number,
    aircraftCategoryId: number
  ) {
    this.aircraftClass = [];
    if (
      gradeCertificateId != null &&
      gradeCertificateId !== 0 &&
      gradeCertificateId !== GradeofCertificateEnum.NADpe &&
      gradeCertificateId !== GradeofCertificateEnum.NASae &&
      gradeCertificateId !== GradeofCertificateEnum.NAAdminPe &&
      this.form!.get('aircraftCategoryId')?.value != null &&
      this.form!.get('aircraftCategoryId')?.value !== 0
    ) {
      this.aircraftClass = this.lookupService.getAircraftClassTypes(
        gradeCertificateId,
        aircraftCategoryId
      );
    }
    // Resetting the model property when we refresh the category values and there are no classes for the category
    if (this.aircraftClass.length === 0) {
      this.setControlValue('aircraftClassId', null);
    }
  }

  onFunctionCodeChanged() {
    this.setControlValue('aircraftMakeModelId', null);
  }

  onFunctionCodeSelected(event: any) {
    // this.testCheckInformation?.selectedRequestAuthorizations = event.selectedFunctionCodes;
    // this.testCheckInformation?.selectedTemporaryAuthorizations = [];
  }

  onTempFunctionCodeSelected(event: any) {
    // this.testCheckInformation?.selectedTemporaryAuthorizations = event.selectedFunctionCodes;
    // this.testCheckInformation?.selectedRequestAuthorizations = [];
  }

  filterMakeModel(event:any) {
    this.lookupService.getMakeModelSeries(event.query).pipe(takeUntil(this.destroying$)).subscribe((d) => {
      this.makeModels = d;
        if (this.makeModels.length > 0) {
          this.populateAircraftCategoryClass();
          this.isLoaded = true;
        }
    });
  }

  makeModelChange(event:any) {
    if (event.currentTarget.value === '') {
      this.setControlValue('aircraftMakeModelId', null);
    }
  }

  onChange(event:any) {
    if (this.getControlValue('isMultipleApplicants') || !this.isPostActivity) {
      this.form!.get('name')?.setValidators([]);
      this.form!.get('name')?.setValue('');
      this.form!.get('certificateNumber')?.setValue('');
    } else {
      if (this.categoryId === 0) {
        this.form!.get('name')?.setValidators([Validators.required]);
      } else {
        this.form!.get('name')?.setValidators([]);
        this.form!.get('name')?.setValue('');
        this.form!.get('certificateNumber')?.setValue('');
      }
    }
    this.form!.get('name')?.updateValueAndValidity();
  }

  onChangeOfOtherAdminActivity(event:any) {
    if (this.isDpeSae) {
      this.funcionCodeChangeEvent.emit(event);
      this.practicalOralTestTypes!.options = this.practicalTypes.filter(pt => {return pt.value != 70});
    }   
    if (this.triggerFieldChangeEvent && event) {
      this.emitFieldChange();
      this.form!.get('isOtherAdminActivity')?.patchValue(this.testCheckInformation?.isOtherAdminActivity);
      return;
    }
    
    const isOther = this.getControlValue('isOtherAdminActivity') === true;
    if (!isOther) {
      this.applyHideFlightInfo();
    } else {
      this.applyShowFlightInfo();
    }
  }
  applyHideFlightInfo() {
      this.hideFlightInfo = true;
      // this.functionCodesSelection.selectedFunctionCodes = [];
      // this.testCheckInformation?.selectedRequestAuthorizations = [];
      // this.testCheckInformation?.selectedTemporaryAuthorizations = [];
      if (this.form!.get('functionCodeSelection')) {
        (this.form as any).removeControl('functionCodeSelection');
      }

      this.aircraftCategories = [];
      this.aircraftClass = [];
      this.aircraftCategoryId = 0;

      if(this.designeeTypeId === DesigneeTypeEnum.ADMINPE) {
        this.form!.get('gradeCertificateId')?.setValue(GradeofCertificateEnum.NAAdminPe);
        this.gradeCertificateId = this.gradeOfCertificateTypeEnum.NAAdminPe;
      } else {
        this.gradeCertificateId = 0;
        this.setControlValue('gradeCertificateId', null);
      }
      
      this.setControlValue('aircraftClassId', null);
      this.setControlValue('aircraftCategoryId', null);
      this.setControlValue('aircraftMakeModelId', null);

      if (this.practicalOralTestTypes) {
        this.practicalOralTestTypes.options = this.tempPracticalTypes?.filter(pt => pt.value !== 70) ?? [];
      }

    const currentPractical = this.form?.get('practicalOralTestId')?.value;
    this.form?.get('practicalOralTestId')?.setValue(currentPractical === 70 ? null : currentPractical);
  }

  private applyShowFlightInfo(): void {
    this.hideFlightInfo = false;

    if (!this.form?.get('functionCodeSelection')) {
      const functionCodeSelection = DmsTestCheckInformationComponent.selectAuthorizations(
        this.testCheckInformation!,
        this.designeeTypeId!,
        this.categoryId,
        this.formSubmitted
      );

      if (functionCodeSelection?.functionCodes && !this.hideFlightInfo) {
        (this.form as any).addControl(
          'functionCodeSelection',
          DmsFunctionCodeSelectionComponent.buildForm(
            functionCodeSelection,
            true,
            this.formSubmitted,
            this.designeeTypeId!
          )
        );

        if (this.practicalOralTestTypes) {
          const selectedFuncCode = this.form?.get('functionCodeSelection.functionCode')?.value;
          const hasInclude = this.includeFunctionCode.some(f => f === selectedFuncCode);
          this.practicalOralTestTypes.options = hasInclude ? this.tempPracticalTypes : (this.tempPracticalTypes?.filter(pt => pt.value !== 70) ?? []);
        }
      }
    }
  }

  onAuthorizationChange() {
    if (this.triggerFieldChangeEvent) {
      this.emitFieldChange();
      this.isTempAuthorizations = this.testCheckInformation?.isTemporaryFunctionCode!;
      this.form!.get('isTemporaryFunctionCode')?.patchValue(this.testCheckInformation?.isTemporaryFunctionCode);
      return;
    }
  }

  private initializeTestComponent() {
    if (
      this.categoryId !== 0 ||
      this.designeeTypeId === DesigneeTypeEnum.ADMINPE ||
      this.designeeTypeId === DesigneeTypeEnum.ADMINPEGEN
    ) {
      this.testCheckInformation!.temporaryAuthorizations = [];
      this.isAdminPreapprovals = true;
      this.isAdminPeGen = this.designeeTypeId === DesigneeTypeEnum.ADMINPEGEN;
    }
    this.isDpeSae =
      this.designeeTypeId === DesigneeTypeEnum.DPE ||
      this.designeeTypeId === DesigneeTypeEnum.SAE;
    this.isGroup2PostActivity =
      this.isPostActivity &&
      (this.designeeTypeId === DesigneeTypeEnum.DPE ||
        this.designeeTypeId === DesigneeTypeEnum.SAE ||
        this.designeeTypeId === DesigneeTypeEnum.ADMINPE ||
        this.designeeTypeId === DesigneeTypeEnum.ADMINPEGEN);

    this.isApplicantCertificateRequired =
      this.isPostActivity && !this.isDpeSae && !this.isAdminPreapprovals;
    this.isTempAuthorizations = this.getControlValue('isTemporaryFunctionCode');
    this.addEvent();
  }

  private populateAircraftCategoryClass() {
    const gradeCertificateId = this.getControlValue('gradeCertificateId');
    if (this.gradeCertificateId != null && this.gradeCertificateId !== 0) {
      this.aircraftCategories = this.lookupService.getAircraftCategoryTypes(
        this.gradeCertificateId
      );
      if (this.aircraftCategoryId != null && this.aircraftCategoryId !== 0) {
        this.aircraftClass = this.lookupService.getAircraftClassTypes(
          gradeCertificateId,
          this.aircraftCategoryId
        );
      }
    }
  }

  private emitFieldChange() {
    this.OnTriggerFieldChange.emit(this.triggerFieldChangeEvent);
  }

  private emitProficienctCheckChange() {
    this.OnProficiencyCheckSelected.emit(this.isProficiencyCheck);
  }

  private isDpeSaeSMFT(){
    let returnValue = false;

    if(this.functionCodeSelection && this.functionCodeSelection.functionCodes){
      let selectedFunctionCode: any;
      const smftFunctionCodes = this.functionCodeSelection.functionCodes.filter(x=> x.functionCode!.endsWith('-SMFT'));

      if(this.form!.get('functionCodeSelection'))
        selectedFunctionCode = this.form!.get('functionCodeSelection')?.value;
  
      returnValue  = (this.isDpeSae && selectedFunctionCode && smftFunctionCodes && smftFunctionCodes.some(x=>x.id === selectedFunctionCode.functionCode));

    }
 
    return returnValue;
  }
}
