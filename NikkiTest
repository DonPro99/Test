SELECT column_name, ordinal_position
FROM U01_RAA.INFORMATION_SCHEMA.COLUMNS
WHERE table_schema='RAA_RAWZ' AND table_name='RAD_CHARTS_MRA' AND ordinal_position >= 445
ORDER BY ordinal_position;

SELECT filedatetime, COUNT(*), COUNT(RNDRG_PROV_TAXID) AS taxid, COUNT(OOS_FLG) AS oos
FROM U01_RAA.RAA_RAWZ.RAD_CHARTS_MRA GROUP BY 1;
