                                    : _lookupService.LookupValues("typeRatings").Result.TypeRatings.Select(a => new BaseLookup { Id = a.Id, Name = a.Name }).ToArray();
            return collection.FirstOrDefault(c => c.Id == id)?.Name ?? string.Empty;
        }


