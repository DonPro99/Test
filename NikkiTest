-- 1) Does the 09/10 batch exist in prod?
SELECT recordid, filedatetime, COUNT(*)
FROM P01_RAA.RAA_RAWZ.RAD_MASTER_CHARTS_ALL_LOB
WHERE TRIM(recordid) IN ('949879444','613170689')
  AND filedatetime = '20260910135555'
GROUP BY 1,2;

-- 2) Do the deploy's chart IDs exist in UAT under any batch?
SELECT chartid, filedatetime
FROM U01_RAA.RAA_RAWZ.RAD_MASTER_CHARTS_ALL_LOB
WHERE TRIM(chartid) IN ('R2C26_949879444_1790177814_2','R2C26_613170689_1275119182_1');
