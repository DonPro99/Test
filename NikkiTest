import { Component, OnInit } from '@angular/core';
import { FormGroup } from '@angular/forms';
import { SelectItem } from 'primeng/api';
import {
  ActivityRequestStatusEnum,
  DesigneeTypeEnum,
  DmsApplicationInformationComponent,
  DmsTestCheckInformationComponent,
  LookupService,
  PreApprovalRequestInfoModel,
  PreApprovalTabEnum,
} from 'dms-web-shared';
import { PreApprovalBaseComponent } from './pre-approval-base.component';

@Component({
    selector: 'dms-pr-adminpe-index',
    templateUrl: './adminpe-index.component.html',
    standalone: false
})
export class AdminpeIndexComponent
  extends PreApprovalBaseComponent
  implements OnInit {
  activityRequestStatusEnum = ActivityRequestStatusEnum;
  practicalTypes: SelectItem[] = [];

  constructor(public override lookupService: LookupService) {
    super(lookupService);
    this.props = {
      title: 'Administrative Activity Pre-Approval Request',
      userguideComponent: 'PreAppvAdmin',
      headers: [
        PreApprovalTabEnum.preApprovalTab,
        PreApprovalTabEnum.testCheckTab,
        PreApprovalTabEnum.locationTab,
        PreApprovalTabEnum.applicantTab,
        PreApprovalTabEnum.uploadTab,
        PreApprovalTabEnum.summaryTab,
      ],
      uploadRefMessage: [],
      formGroupMap: {
        1: ['testCheckInformation'],
        2: ['activityLocation'],
        3: ['applicationInformation'],
        4: ['comments', 'uploadId'],
      },
    };
    this.practicalTypes = [];
  }

  public static override buildForm(
    model: PreApprovalRequestInfoModel,
    options: any
  ): FormGroup {
    options.categoryId = 0;
    const form = PreApprovalBaseComponent.buildForm(model, options);
    // Using the application's actual designee type (e.g. Admin-PE-GEN, id 31) rather than hardcoding Admin-PE, 
    // so this shared component correctly reflects which designee type is being processed.
    const designeeTypeId = model.designeeInfo?.typeId ?? DesigneeTypeEnum.ADMINPE;

    form.addControl(
      'testCheckInformation',
      DmsTestCheckInformationComponent.buildForm(
        model.testCheckInformation!,
        model.testInformation!,
        model.applicantInformation!,
        {
          designeeTypeId,
          categoryId: options.categoryId,
          isDisabled: options.isDisabled,
        }
      )
    );

    form.addControl(
      'applicationInformation',
      DmsApplicationInformationComponent.buildForm(
        model.applicationInformation!,
        {
          designeeTypeId,
          categoryId: options.categoryId,
          isDisabled: options.isDisabled,
        }
      )
    );

    return form;
  }

  public static override buildModel(
    form: FormGroup,
    model: PreApprovalRequestInfoModel
  ) {
    PreApprovalBaseComponent.buildModel(form, model);
    DmsApplicationInformationComponent.buildModel(
      form.get('applicationInformation') as FormGroup,
      model.applicationInformation!
    );
    DmsTestCheckInformationComponent.buildModel(
      form.get('testCheckInformation') as FormGroup,
      model.testCheckInformation!,
      model.testInformation!,
      model.applicantInformation!,
      model.designeeTypeId!,
      model.categoryId || 0
    );
  }

  async ngOnInit() {
    await super.setBaseConfig(this.pr!);
    this.props.tabCount = this.props.headers.length - 1;
    this.getConfig.emit(this.props);

    this.form = AdminpeIndexComponent.buildForm(this.pr!, {
      isDisabled: this.isDisabled,
    });
  }

  override onTabChange($event: any) {
    AdminpeIndexComponent.buildModel(this.form!, this.pr!);
    super.onTabChange($event);
  }

    getModel() {
    AdminpeIndexComponent.buildModel(this.form!, this.pr!);
    return this.pr;
  }

  get isAutoPreApproval() {
    if (this.pr!.testCheckInformation?.isOtherAdminActivity) {
      return true;
    }
    const selectedFcs = this.pr!.testCheckInformation!.selectedRequestAuthorizations!.map(
      (item) => item.id
    );
    return (
      !this.pr!.activityLocation?.isOutsideOfficeDistrict &&
      super.canAutoApprove(
        selectedFcs,
        this.pr!.testCheckInformation?.requestedAuthorizations!
      )
    );
  }
}
