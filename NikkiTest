                p.DesigneeTypeId == cloa.DesigneeTypeId.GetValueOrDefault() && p.RolePermission.RoleId == roleId &&
                p.IsActive);
            var managementLinks = rolePermissionDesigneeTypes
                .Where(p => p.LinkTypeId == (int)LinkTypeEnum.ManagementActionLinks).OrderBy(p => p.SortOrder)
                .Select(item => new LinkViewModel
                {
                    Id = item.RolePermission.Permission.Id,
                    Code = item.RolePermission.Permission.Code,
                    DisplayName = item.RolePermission.Permission.Id == (int)PermissionEnum.PreApprovalSetting ? $"Manage {item.RolePermission.Permission.Name}" : item.RolePermission.Permission.Name,
                    ModuleId = item.ModuleId,
                    Url = item.RolePermission.Permission.UrlRouter,
                    HasNavigation = true
                }).ToList();

            if (cloa.DesigneeTypeId == (int)DesigneeTypeEnum.DCTOE)
            {
                managementLinks = managementLinks.Where(m => m.Code != "IDT").ToList();
            }
            var moduleIds = managementLinks.Where(it => it.ModuleId.HasValue).Select(itd => itd.ModuleId).ToList();

            if (moduleIds.Contains((int)ProcessTypeEnum.ManageCloa))
            {
                moduleIds.Add((int)ProcessTypeEnum.ChangeDesignationLocation);
                moduleIds.Add((int)ProcessTypeEnum.Expansion);
            }
            if (!moduleIds.Contains((int)ProcessTypeEnum.Expansion) && (cloa.DesigneeTypeId == (int)DesigneeTypeEnum.DME ||
                cloa.DesigneeTypeId == (int)DesigneeTypeEnum.DART || cloa.DesigneeTypeId == (int)DesigneeTypeEnum.DPRE))
            {
                moduleIds.Add((int)ProcessTypeEnum.Expansion);
            }

            var activityStatusIds = new List<int>()
            {
                (int) ActivityStatusEnum.Saved, (int) ActivityStatusEnum.Pending, (int) ActivityStatusEnum.Initiated,
                (int) ActivityStatusEnum.Submitted, (int) ActivityStatusEnum.Returned
            };
            var activities = _context.Activities.Where(ita => moduleIds.Contains(ita.ModuleId)
                                                              && ita.CloaId.HasValue &&
                                                              cloaIds.Contains(ita.CloaId.Value)
                                                              && activityStatusIds.Contains(ita.StatusId))
                .Select(a => new ActivityEntity.Activity
                {
                    ModuleId = a.ModuleId,
                    StatusId = a.StatusId
                }).ToArray();

            var informationLinks = rolePermissionDesigneeTypes
                .Where(p => p.LinkTypeId == (int)LinkTypeEnum.InformationLinks).OrderBy(p => p.SortOrder)
                .Select(item => new LinkViewModel
                {
                    Id = item.RolePermission.Permission.Id,
                    Code = item.RolePermission.Permission.Code,
                    DisplayName = item.RolePermission.Permission.Id == (int)PermissionEnum.PreApprovalSetting ? $"View {item.RolePermission.Permission.Name}" : item.RolePermission.Permission.Name,
                    HasNavigation = true,
                    Url = item.RolePermission.Permission.UrlRouter
                }).ToList();

            SetManagementActionLinksUrl(managementLinks, cloa, roleId, isMyDesignee);
            SetInformationLinksUrl(informationLinks, cloa);
            var cloaVersionLinks = SetCloaVersionsLinksUrl(applicationId);

            EnableManagementLinksForOtherDesignees(managementLinks, cloa, isMyDesignee, roleId);
            RemoveHyperlinksByRules(cloa, managementLinks, informationLinks, CheckTerminationType(cloaIds), roleId, officeId, userOfficeRoleId);
            DisableLinksByActivityStatus(cloa, managementLinks, activities, isMyDesignee);

            if (_context.Activities.Any(ita => ita.CloaId.HasValue && ita.Cloa.Application.UserId == cloa.UserId && ita.ModuleId == (int)ProcessTypeEnum.Termination && activityStatusIds.Contains(ita.StatusId)))
            {
                managementLinks = managementLinks.Select(m =>
                {
                    if (m.ModuleId == (int)ProcessTypeEnum.Termination)
                    {
                        m.HasNavigation = false;
                    }
                    return m;
                }).ToList();
            }

            return new ManagementInformationLinksViewModel()
            {
                ManagementLinks = managementLinks,
                InformationLinks = informationLinks,
                CloaVersionLinks = cloaVersionLinks
            };
        }

        private bool CheckTerminationType(IList<int> cloaIds)
        {
            var terminationActivity = _context.Activities.Include(a => a.Responses).Where(ita =>
                    (ita.ModuleId == (int)ProcessTypeEnum.Termination || ita.ModuleId == (int)ProcessTypeEnum.VoluntarySurrenderRequest)
                    && ita.CloaId.HasValue && cloaIds.Contains(ita.CloaId.Value)
                    && ita.StatusId == (int)ActivityStatusEnum.Completed)
                .OrderByDescending(a => a.Id).FirstOrDefault();

            if (terminationActivity == null || terminationActivity?.ModuleId == (int)ProcessTypeEnum.VoluntarySurrenderRequest) return false;

            var decision = JsonConvert.DeserializeObject<TerminationViewModel>(terminationActivity.FormData);
            var systemVariables = _lookupService.GetSystemVariables().Result;
            bool isForCause = terminationActivity.Responses.Any(r =>
                             r.AnswerId == Convert.ToInt32(systemVariables["TerminationForCauseQuestionAnswerId"]))
                         && (decision?.AoTerminationDecisionId == 4 || !_context.Activities.Any(ita =>
                             ita.CloaId == terminationActivity.CloaId &&
                             ita.ModuleId == (int)ProcessTypeEnum.AppealForTermination &&
                             ita.StatusId == (int)ActivityStatusEnum.Completed));
            return isForCause;
        }

        private void EnableManagementLinksForOtherDesignees(IList<LinkViewModel> managementLinks, CloaViewModel cloa, bool isMyDesignee, int roleId)
        {
            var isOnlyMs = roleId == (int)RoleEnum.ManagingSpecialist && !isMyDesignee;
            if (!isOnlyMs) return;

            bool isDer = (cloa.DesigneeTypeId == (int)DesigneeTypeEnum.DERT || cloa.DesigneeTypeId == (int)DesigneeTypeEnum.DERY);
            managementLinks = managementLinks.Select(it => { it.HasNavigation = (it.Code == "RF" && isDer); return it; }).ToArray();
            switch (cloa.DesigneeGroupId)
            {
                case (int)DesigneeGroupEnum.AFS:
                case (int)DesigneeGroupEnum.AME:
                    EnableManagementLinks(managementLinks, new List<string>() { "CSG", "RF" });
                    break;
                case (int)DesigneeGroupEnum.Manufacturing:
                    EnableManagementLinks(managementLinks, new List<string>() { "CSG", "RF", "DO" });
                    break;
            }
        }

        private void EnableManagementLinks(IList<LinkViewModel> managementLinks, List<string> codes)
        {
            codes.ForEach(code =>
            {
                if (managementLinks.Any(it => it.Code == code))
                {
                    managementLinks.First(it => it.Code == code).HasNavigation = true;
                }
            });
        }

        private static void RemoveHyperlinksByRules(CloaViewModel cloa, List<LinkViewModel> managementLinks, List<LinkViewModel> informationLinks, Boolean isForCauseTermination, int roleId, int officeId, int? userOfficeRoleId = null)
        {
            if ((cloa.IsDeployed || (cloa.ApplicationIsActive.HasValue && !cloa.ApplicationIsActive.Value)) && informationLinks.Any(it => it.Code == "OA"))
            {
                informationLinks.Remove(informationLinks.First(it => it.Code == "OA"));
            }

            if (cloa.DesigneeTypeId == (int)DesigneeTypeEnum.AME)
            {
                if (
                    ((cloa.CloaStatus != (int)CloaStatusEnum.Terminated && !(!isForCauseTermination && cloa.CloaStatus == (int)CloaStatusEnum.Expired))
                       || (cloa.CloaStatus == (int)CloaStatusEnum.Terminated && isForCauseTermination)
                       || (cloa.TerminationDate.HasValue && cloa.TerminationDate.Value.AddYears(1) < DateTime.Now))
                 && managementLinks.Any(it => it.Code == "RI"))
                {
                    managementLinks.Remove(managementLinks.First(it => it.Code == "RI"));
                }
                if (roleId == (int)RoleEnum.AppointingOfficial && userOfficeRoleId != null && cloa.AppointingOfficialId != userOfficeRoleId && managementLinks.Any(it => it.Code == "SEF"))
                {
                    managementLinks.Remove(managementLinks.First(it => it.Code == "SEF"));
                }
            }

            if ((cloa.DesigneeTypeId == (int)DesigneeTypeEnum.DPE || cloa.DesigneeTypeId == (int)DesigneeTypeEnum.SAE ||
                 cloa.DesigneeTypeId == (int)DesigneeTypeEnum.ADMINPE) && (managementLinks.Any(it => it.Code == "MCL"))) 
            {
                    managementLinks.Remove(managementLinks.First(it => it.Code == "MCL"));
            }
            //If the applicant is coming through normal onbaording (ie, not through workflow deployment),
            //then dont bother showing the Manage Cloa link. In other words, the Manage Cloa link is only for
            //those coming through deployment workflow channel.
            if (cloa.DesigneeTypeId == (int)DesigneeTypeEnum.APD || cloa.DesigneeTypeId == (int)DesigneeTypeEnum.TCE || cloa.DesigneeTypeId == (int)DesigneeTypeEnum.DADE)
            {
                if (cloa.IsDeployed == false && managementLinks.Any(it => it.Code == "MCL"))
                {
                    managementLinks.RemoveAll(item => item.Code == "MCL");
                }
                else if (cloa.IsDeployed && managementLinks.Any(it => it.Code == "MCL"))
                {
                    managementLinks.Remove(managementLinks.First(it => it.Code == "MCL"));
                }
            }

            if (roleId == (int)RoleEnum.OfficeAdministrator && officeId != cloa.OfficeId)
            {
                managementLinks.RemoveAll(item => item.Code != "RF");
            }
        }

        private void DisableLinksByActivityStatus(CloaViewModel cloa, List<LinkViewModel> managementLinks, IList<ActivityEntity.Activity> activities, bool isMyDesignee)
        {
            var isSuspensionPending = activities.Any(ita => ita.ModuleId == (int)ProcessTypeEnum.Suspension);
            var isSuspensionProcess = activities.Any(ita => ita.ModuleId == (int)ProcessTypeEnum.Suspension && (ita.StatusId == (int)ActivityStatusEnum.Pending || ita.StatusId == (int)ActivityStatusEnum.Submitted));
            var isTerminationPending = activities.Any(ita => ita.ModuleId == (int)ProcessTypeEnum.Termination);
            var isTerminationProcess = activities.Any(ita => ita.ModuleId == (int)ProcessTypeEnum.Termination && (ita.StatusId == (int)ActivityStatusEnum.Pending || ita.StatusId == (int)ActivityStatusEnum.Submitted));
            var isMalPending = activities.Any(ita => ita.ModuleId == (int)ProcessTypeEnum.ReduceAuthorizationsRequest);
            var isMalProcess = activities.Any(ita => ita.ModuleId == (int)ProcessTypeEnum.ReduceAuthorizationsRequest && (ita.StatusId == (int)ActivityStatusEnum.Pending || ita.StatusId == (int)ActivityStatusEnum.Submitted));
            var isCorrectiveActionPending = activities.Any(ita => ita.ModuleId == (int)ProcessTypeEnum.CorrectiveAction && (ita.StatusId == (int)ActivityStatusEnum.Pending || ita.StatusId == (int)ActivityStatusEnum.Submitted));
            var cloaExpired = cloa.CloaStatus == (int)CloaStatusEnum.Expired;
            var isChangeDesigneeLocationPending = activities.Any(ita => ita.ModuleId == (int)ProcessTypeEnum.ChangeDesignationLocation);
            var isExpansionPending = activities.Any(ita => ita.ModuleId == (int)ProcessTypeEnum.Expansion && ita.StatusId != (int)ActivityStatusEnum.Saved);
            var isExpansionProcess = activities.Any(ita => ita.ModuleId == (int)ProcessTypeEnum.Expansion && (ita.StatusId == (int)ActivityStatusEnum.Pending || ita.StatusId == (int)ActivityStatusEnum.Submitted));
            var isCloaOnSuspensionSave = cloa.CloaStatus == (int)CloaStatusEnum.Suspended || isSuspensionPending;
            var isCloaOnSuspension = cloa.CloaStatus == (int)CloaStatusEnum.Suspended || isSuspensionProcess;
            var isCloaOnTerminationSave = cloa.CloaStatus == (int)CloaStatusEnum.Terminated || isTerminationPending;
            var isCloaOnTermination = cloa.CloaStatus == (int)CloaStatusEnum.Terminated || isTerminationProcess;
            var isMclPending = activities.Any(ita => ita.ModuleId == (int)ProcessTypeEnum.ManageCloa);
            var isMclTasksPending = IsManageCloaTasksPending(cloa);
            var isMalTasksPending = IsManageAuthorizationTasksPending(cloa);
            var isOpePending = activities.Any(ope =>
                ope.ModuleId == (int)ProcessTypeEnum.OverallPerformanceEvaluation &&
                !new[] { (int)ActivityStatusEnum.Cancelled, (int)ActivityStatusEnum.Completed }.Contains(ope.StatusId)
            );

            DisableLinksByActivityStatus(cloa, managementLinks, activities, isCloaOnSuspensionSave, isCloaOnTerminationSave, isTerminationProcess, isMalPending, isMalProcess,
                                        isCorrectiveActionPending, cloaExpired, isChangeDesigneeLocationPending, isExpansionPending, isExpansionProcess,
                                        isCloaOnSuspension, isCloaOnTermination, isMclPending, isMclTasksPending, isMalTasksPending, isMyDesignee, isOpePending);
        }

        private static void DisableLinksByActivityStatus(CloaViewModel cloa, List<LinkViewModel> managementLinks, IList<ActivityEntity.Activity> activities, bool isCloaOnSuspensionSave, bool isCloaOnTerminationSave,
        bool isTerminationProcess, bool isMalPending, bool isMalProcess, bool isCorrectiveActionPending, bool cloaExpired, bool isChangeDesigneeLocationPending, bool isExpansionPending,
            bool isExpansionProcess, bool isCloaOnSuspension, bool isCloaOnTermination, bool isMclPending, bool isMclTasksPending, bool isMalTasksPending, bool isMyDesignee, bool isOpePending)
        {
            if (managementLinks.Any(l => l.Code == "CRA" && isMyDesignee))
            {
                managementLinks.First(l => l.Code == "CRA").HasNavigation = !(isCloaOnTermination || cloaExpired);
            }

            foreach (var link in managementLinks.Where(l => l.HasNavigation))
            {
                switch (link.Code)
                {
                    case "OPE":
                        link.HasNavigation = !(activities.Any(ita => ita.ModuleId == link.ModuleId) || isCloaOnTermination);
                        break;
                    case "IDT":
                        var isIdtPending = activities.Any(ita => ita.ModuleId == link.ModuleId);
                        link.HasNavigation =
                                !(
                                  (cloa.CloaStatus == (int)CloaStatusEnum.Terminated || isTerminationProcess)
                                  || isMalProcess || isMalTasksPending || isIdtPending
                                  || isCorrectiveActionPending || isOpePending
                                  || (cloa.DesigneeGroupId == (int)DesigneeGroupEnum.Manufacturing
                                      && isExpansionProcess)
                                  || activities.Any(a => a.ModuleId == (int)ProcessTypeEnum.Expansion && a.StatusId == (int)ActivityStatusEnum.Initiated)
                                );
                        break;
                    case "MAL":
                        link.HasNavigation = !(isCloaOnSuspension || isCloaOnTermination || isMalPending || isMalTasksPending || isExpansionProcess || isMclPending);
                        break;
                    case "SD":
                        link.HasNavigation = !(isCloaOnSuspensionSave || isCloaOnSuspension || isCloaOnTermination || cloaExpired);
                        break;
                    case "TD":
                        link.HasNavigation = !(isCloaOnTerminationSave || isCloaOnTermination);
                        break;
                    case "MCL":
                        link.HasNavigation = !(isCloaOnSuspension || isCloaOnTermination || cloaExpired || isChangeDesigneeLocationPending || isExpansionPending || isMclPending || isMclTasksPending || isMalPending);
                        break;
                    case "CVSR":
                        var isCompanyVsRequestPending = activities.Any(ita => ita.ModuleId == link.ModuleId);
                        link.HasNavigation = !(isCloaOnTermination || (cloaExpired && cloa.DesigneeTypeId == (int)DesigneeTypeEnum.DMIR) || isCompanyVsRequestPending);
                        break;
                    case "DO":
                    case "RI":
                        var isActvityPending = activities.Any(ita => ita.ModuleId == link.ModuleId);
                        link.HasNavigation = !isActvityPending;
                        break;
                    case "INV":
                        link.HasNavigation = !activities.Any(ita => ita.ModuleId == link.ModuleId);
                        break;
                }
            }
        }

        private bool IsManageCloaTasksPending(CloaViewModel cloa)
        {
            return (_context.Tasks
                            .Join(
                                _context.TaskSubTypes,
                                t => t.SubTypeId,
                                tst => tst.Id,
                                (t, tst) =>
                                    new
                                    {
                                        t = t,
                                        tst = tst
                                    }
                            )
                            .Join(
                                _context.TaskTypes,
                                temp0 => temp0.tst.TaskTypeId,
                                tt => tt.Id,
                                (temp0, tt) =>
                                    new
                                    {
                                        temp0 = temp0,
                                        tt = tt
                                    }
                            )
                            .Where(
                                temp1 =>
                                    (((temp1.tt.Id == (int)TaskTypeEnum.ManageCloa) && (temp1.temp0.t.StatusId != (int)TaskStatusEnum.Completed)) &&
                                        (temp1.temp0.t.ActionId == cloa.Id)
                                    )
                            )
                        .Select(temp1 => temp1.temp0.t)).Any();
        }

        private bool IsManageAuthorizationTasksPending(CloaViewModel cloa)
        {
            return (_context.Tasks
                        .Join(
                            _context.TaskSubTypes,
                            t => t.SubTypeId,
                            tst => tst.Id,
                            (t, tst) =>
                                new
                                {
                                    t = t,
                                    tst = tst
                                }
                        )
                        .Join(
                            _context.TaskTypes,
                            temp0 => temp0.tst.TaskTypeId,
                            tt => tt.Id,
                            (temp0, tt) =>
                                new
                                {
                                    temp0 = temp0,
                                    tt = tt
                                }
                        )
                        .Where(
                            temp1 =>
                                (((temp1.tt.Id == (int)TaskTypeEnum.ManageAuthorizationAndLimitation) && (temp1.temp0.t.StatusId != (int)TaskStatusEnum.Completed)) &&
                                    (temp1.temp0.t.ActionId == cloa.Id)
                                )
                        )
                .Select(temp1 => temp1.temp0.t)).Any();
        }

        private IList<LinkViewModel> SetCloaVersionsLinksUrl(int applicationId)
        {
            var cloaVersionsLinks = new List<LinkViewModel>();
            var cloaVeriosUrls = _context.Cloas.Where(it => it.ApplicationId == applicationId).Select(v => new
            {
                v.Id,
                v.CreatedDate
            }).OrderByDescending(itc => itc.Id).ToArray();
            int verionNumber = cloaVeriosUrls.Count();
            foreach (var item in cloaVeriosUrls)
            {
                cloaVersionsLinks.Add(new LinkViewModel
                {
                    DisplayName = $"Version {verionNumber} - {item.CreatedDate:MM/dd/yyyy}",
                    Url = $"/cloainformation/{item.Id}/{false}",
                });
                verionNumber--;
            }

            return cloaVersionsLinks;
        }

        private void SetInformationLinksUrl(IList<LinkViewModel> informationLinks, CloaViewModel cloa)
        {
            foreach (var link in informationLinks)
