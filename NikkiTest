< # =============================================================================
< # Date       : Dec 2025
< # Author     : Naseer
< # Change     : Batch execution support when INTERVENTION=ALL.
< # Description: Reads BATCH_INTERVENTIONS_<LOB> from deploy.properties and executes
< #              the existing single intervention logic for each intervention.
< # Usage      : start_sas_deploy_copy_hdfs.sh ALL MCAID
< # =============================================================================
< run_one_intervention() {
<   local one_intervention="$1"
< 
<   # Check if this is RADV LOB - use specialized processing
<   if [[ "${LOB}" == "RADV" ]]; then
<     run_radv_intervention "$one_intervention"
<     return $?
<   fi
< 
<   # Set intervention for this iteration
<   INTERVENTION="$one_intervention"
< 
<   # Preserve existing special mapping (same behavior)
<   if [ "${INTERVENTION}" == "ALTEGSMAS" ]; then
<      INTERVENTION="CHCSMAS"
<   fi
< 
<   intervention=`echo $INTERVENTION | tr [:upper:] [:lower:]`
<   lob=`echo $LOB | tr [:upper:] [:lower:]`
< 
<   LOG_MESG "------------------------------------------------------------"
<   LOG_MESG "Starting deploy run for INTERVENTION=${INTERVENTION}; LOB=${LOB}"
< 
<   #Special handling for retro mcaid dataset since market will be part of the sas filename.
<   if [ ${LOB} == "MCAID" ]
<   then
<      if [ ${INTERVENTION} == "INVRTSP" ] || [ ${INTERVENTION} == "EPISRCRT" ] || [ ${INTERVENTION} == "ALTEGRT" ] || \
<         [ ${INTERVENTION} == "CHISMAS" ] || [ ${INTERVENTION} == "CIOXRT" ] || [ ${INTERVENTION} == "CIOXPMRT" ] || \
<         [ $INTERVENTION = BCBSMNRT ] || [ $INTERVENTION = OPTUMRT ]
<      then
<         export DEPLOY_FILE="deply_${intervention}_*${lob}"
<      else
<         export DEPLOY_FILE="deply_${intervention}_${lob}"
<      fi
<   else
<      export DEPLOY_FILE="deply_${intervention}_${lob}"
<   fi
< 
<   echo "Deploy File Name pattern: ${DEPLOY_FILE}"
< 
<   COUNT=`ls ${SAS_DEPLOY_LOC}/${DEPLOY_FILE}*.${DEPLOY_FILE_EXT} 2>/dev/null | wc -l`
< 
<   if [ ${COUNT} -gt 0 ]; then
<      LOG_MESG "Deploy file for intervention $INTERVENTION and line of business ${LOB} present at deploy location ${SAS_DEPLOY_LOC}"
<      LOG_MESG "Copying SAS Deploy dataset for intervention $INTERVENTION and line of business ${LOB} to Hadoop"
< 
<      LATEST_DEPLOY_FILE=`ls -rt ${SAS_DEPLOY_LOC}/${DEPLOY_FILE}*.${DEPLOY_FILE_EXT} | tail -1`
<      LOG_MESG "Latest Deploy file available is ${LATEST_DEPLOY_FILE}"
< 
<      #call sas program to copy.
<      ${SAS_HOME}/copyDeploySASDatasetsToHDFS.sh $LOB $INTERVENTION ${SAS_CONFIG_FILE} ${ENV}
< 
<      if [ $? -ne 0 ]
<      then
<        LOG_MESG "Failure while running SAS script for deploy dataset - $INTERVENTION and $LOB"
<        return 1
<      fi
< 
<      LOG_MESG "Starting SFTP for ${DEPLOY_FILE}"
< 
<      if [[ "${DEPLOY_FILE}" == "deply_optmrt_mra" ]]; then
<          LOG_MESG "Special case: Running raa_inbound_pgp_sftp_notify.sh"
<          ${SAS_HOME}/raa_inbound_pgp_sftp_notify.sh "/hcaaapck/backup/IT/${SAS_ENV}/work/${DEPLOY_FILE}.txt"
<          if [ $? -ne 0 ]; then
<            LOG_MESG "WARNING: raa_inbound_pgp_sftp_notify.sh failed for $INTERVENTION and $LOB"
<            LOG_MESG "Continuing execution despite failure."
<          fi
<      else
<          ${SAS_HOME}/common-sftp-sas-mgft-task.sh "/hcaaapck/backup/IT/${SAS_ENV}/work/${DEPLOY_FILE}.txt"
<          if [ $? -ne 0 ]; then
<            LOG_MESG "ERROR: MGFT script failed for $INTERVENTION and $LOB"
<            return 1
<          fi
<      fi
< 
<      #move the file to deploy out location.
<      mv -f ${LATEST_DEPLOY_FILE} ${SAS_OUT_LOC}
< 
<      if [ $? -ne 0 ]
<      then
<         LOG_MESG "Error encountered while moving the deploy file to deploy out location"
<         return 1
<      else
<         LOG_MESG "Deploy file moved to deploy out location - ${SAS_OUT_LOC}"
<      fi
< 
<      return 0
<   else
<      LOG_MESG "Deploy file for intervention $INTERVENTION and line of business ${LOB} does not exist at deploy location ${SAS_DEPLOY_LOC}"
<      LOG_MESG "No SAS Deploy dataset with intervention $INTERVENTION and line of business ${LOB} available for copy to HDFS.."
<      return 0
<   fi
< }
