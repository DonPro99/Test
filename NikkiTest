import { Inject, Injectable } from '@angular/core';
import { DMS_SECRET_KEY } from '../models/exportparams.model';
import { LookupService } from './lookup.service';

@Injectable({
  providedIn: 'root'
})
export class CryptoService {

  private suffix = 'ENC|';
  constructor(@Inject(DMS_SECRET_KEY) private key: string, private lookupService: LookupService) { }
  /**
   * Encrypts data using AES-GCM.
   * @param plaintext The plaintext to encrypt.
   * @returns An base 64 string containing ciphertext, IV, and tag.
   */
  async encrypt(
    plaintext?: any
  ): Promise<string> {

    if (plaintext === undefined || plaintext === null) {
      return plaintext;
    }
    
    if (!this.lookupService.hasAnonymousLookupDataCached) {
      await this.lookupService.populateAnonymousLookupData();
    }

    if (this.lookupService.anonymousSystemVariables?.enableEncryption?.toLowerCase() !== 'true') {
      return plaintext;
    }

    const encoder = new TextEncoder();
    const plaintextBytes = encoder.encode(plaintext);
    const key = await this.stringToCryptoKey(this.key);
    const iv = crypto.getRandomValues(new Uint8Array(12));

    const encryptedBuffer  = await crypto.subtle.encrypt(
      {
        name: 'AES-GCM',
        iv: iv,
        tagLength: 128,
      },
      key,
      plaintextBytes
    );

    const encryptedBytes = new Uint8Array(encryptedBuffer);
    const combinedBuffer = new Uint8Array(encryptedBytes.length + iv.length);
    combinedBuffer.set(encryptedBytes);
    combinedBuffer.set(iv, encryptedBytes.length);
    return `${this.suffix}${this.base64UrlEncode(this.uint8ArrayToBase64(combinedBuffer))}`;
  }

   /**
   * Decrypts data using AES-GCM.
   * @param encryptedText Base 64 encrypted string.
   * @returns The decrypted plaintext string.
   */
   async decrypt(
    encryptedText?: any,
  ): Promise<string> {
    if (encryptedText === undefined || encryptedText === null) {
      return encryptedText;
    }
    
    if (!this.lookupService.hasAnonymousLookupDataCached) {
      await this.lookupService.populateAnonymousLookupData();
    }

    if (this.lookupService.anonymousSystemVariables?.enableEncryption?.toLowerCase() !== 'true') {
      return encryptedText;
    }

    if (!encryptedText.startsWith(this.suffix)) {
      return encryptedText;
    }

    encryptedText = encryptedText.substring(this.suffix.length);
    const key = await this.stringToCryptoKey(this.key);
    const encryptedBytes = this.base64ToUint8Array(this.base64UrlDecode(encryptedText));
    const ciphertext = encryptedBytes.slice(0, encryptedBytes.length - 12);
    const iv = encryptedBytes.slice(ciphertext.length);

    const plaintextBytes = await crypto.subtle.decrypt(
      {
        name: 'AES-GCM',
        iv: iv,
        tagLength: 128,
      },
      key,
      ciphertext
    );

    const decoder = new TextDecoder('utf-8');
    return decoder.decode(plaintextBytes);
  }

  /**
   * Converts a string into a CryptoKey.
   * @param str The string (e.g., password) to convert.
   * @returns A Promise that resolves with a CryptoKey.
   */
  stringToCryptoKey(str: string): Promise<CryptoKey> {
    const encoder = new TextEncoder();
    const data = encoder.encode(str); 
  
    return crypto.subtle.importKey(
      'raw',        
      data,         
      { name: 'AES-GCM' }, 
      false,        
      ['encrypt', 'decrypt'] 
    );
  }

  uint8ArrayToBase64(uint8Array: Uint8Array): string {
    let binaryString = '';
    for (let i = 0; i < uint8Array.length; i++) {
      binaryString += String.fromCharCode(uint8Array[i]);
    }
    
    return btoa(binaryString);
  }

  base64ToUint8Array(base64String: string): Uint8Array {
    const binaryString = atob(base64String);
    const uint8Array = new Uint8Array(binaryString.length);
    for (let i = 0; i < binaryString.length; i++) {
      uint8Array[i] = binaryString.charCodeAt(i);
    }
  
    return uint8Array;
  }

  base64UrlEncode(str: string) {
    return str.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }

  base64UrlDecode(str: string) {
      str = str.replace(/-/g, '+').replace(/_/g, '/');
      while (str.length % 4) {
          str += '=';
      }
      return str;
  }
}
