#!/usr/bin/env python3
"""
virtix_chase_transform.py

RBICA-14060 - MCaid Virtix Chase Files: _S (54-col) -> 22-col standard layout

Purpose:
    Reshape the _S "Standard" Virtix chase file down to the same 22-column
    structure already used by _C / _M, so all three file types can flow
    through the EXISTING merge_virtix_chase_files.sh and land in
    the same target table: RAA_RAWZ.RAD_VIRTIX_CHASE_MCAID_LOAD

Where this runs in the pipeline:
    1. merge_virtix_chase_files.sh, for each state, finds that state's files
       as it always has. For any file matching *_Chase_S_*, it calls this
       script before its merge loop runs. This reshapes that one _S file down to
       the 22-column layout, in place, keeping the same filename.
    2. The merge loop then continues completely unchanged by this point
       the _S file already looks like a _C/_M file, so it merges in
       correctly using the exact same logic. STATE derivation continues to
       work unchanged too, since it comes from the FILENAME (both before and
       after merge), never from file contents.
    3. rad_mcaid_chase_all_lob_s3_to_snflk_load.py runs last, also unchanged
       it only ever sees the final merged, uniformly shaped file.
"""

import csv
import os
import sys

# Confirmed: Virtix chase files (all types) are pipe-delimited, matching the
# "delimiter" value in rad_mcaid_chase_all_lob_s3_to_snflk_load.properties
# for the Virtix schema section.
DELIMITER = "|"

# Target 22-column layout, in order. Matches the _C/_M layout BEFORE
# merge_virtix_chase_files.sh's header sed step 
TARGET_COLUMNS = [
    "FileName",
    "MemberId",
    "MemberFirstName",
    "MemberLastName",
    "MemberDOB",
    "EnrollmentDate",
    "EnrollmentEndDate",
    "ESRDIndicator",
    "ProjectName",
    "ClientRequestId",
    "RecordTypeId",
    "OnshoreIndicator",
    "Gender",
    "ProviderLastName",
    "ProviderFirstName",
    "ProviderNPI",
    "MemberMiddle",
    "ProviderId",
    "UserDefinedText1",
    "UserDefinedText2",
    "UserDefinedText3",
    "UserDefinedText4",
]

# Confirmed direct-match source column names in the _S (54-col) layout

SOURCE_COLUMN_MAP = {
    "FileName": "ReturnFileName",          
    "MemberId": "MemberId",
    "MemberFirstName": "MemberFirstName",
    "MemberLastName": "MemberLastName",
    "MemberDOB": "MemberDOB",
    "ProjectName": "ProjectName",
    "ClientRequestId": "ClientRequestid",  
    "OnshoreIndicator": "OnshoreIndicator",  
    "Gender": "Gender",                      
    "ProviderLastName": "ProviderLastName",
    "ProviderFirstName": "ProviderFirstName",
    "ProviderNPI": "ProviderNPI",
    "MemberMiddle": "MemberMI",
    "ProviderId": "ProviderId",
    "UserDefinedText1": "UserDefinedText1",
    "UserDefinedText2": "UserDefinedText2",
    "UserDefinedText3": "UserDefinedText3",
}

# Confirmed blank fields, no match in _S layout, or business placeholder never populated
BLANK_COLUMNS = {
    "EnrollmentDate",    
    "EnrollmentEndDate", 
    "ESRDIndicator",     
    "RecordTypeId",  
    "UserDefinedText4",
}


def transform_file(source_path: str, dest_path: str) -> tuple[int, int]:
    """Reshape one _S file from 54 columns down to the 22-column target layout.
    Returns (input_record_count, output_record_count) for validation, matching
    the record-count check merge_virtix_chase_files.sh already does for its
    own merge step.
    """
    with open(source_path, newline="", encoding="utf-8") as src:
        reader = csv.DictReader(src, delimiter=DELIMITER)
        input_header = reader.fieldnames or []

        missing = [
            src_col
            for src_col in SOURCE_COLUMN_MAP.values()
            if src_col not in input_header
        ]
        if missing:
            raise ValueError(
                f"{source_path}: expected _S source column(s) not found in header: {missing}"
            )

        rows_out = []
        input_count = 0
        for row in reader:
            input_count += 1
            new_row = {}
            for target_col in TARGET_COLUMNS:
                if target_col in BLANK_COLUMNS:
                    new_row[target_col] = ""
                else:
                    source_col = SOURCE_COLUMN_MAP[target_col]
                    new_row[target_col] = row.get(source_col, "")
            rows_out.append(new_row)

    with open(dest_path, "w", newline="", encoding="utf-8") as dst:
        writer = csv.DictWriter(dst, fieldnames=TARGET_COLUMNS, delimiter=DELIMITER)
        writer.writeheader()
        writer.writerows(rows_out)

    return input_count, len(rows_out)


def transform_one(source_path: str) -> int:
    """Reshape a single raw _S file in place.
    Returns 0 on success, 1 on failure (mirrors shell exit-code conventions
    so merge_virtix_chase_files.sh can check $? directly).
    """
    if not os.path.isfile(source_path):
        print(f"ERROR: file not found: {source_path}", file=sys.stderr)
        return 1

    # Overwrite in place so merge_virtix_chase_files.sh's existing glob picks
    # it up unchanged, with the same filename (state/timestamp already
    # embedded in it).
    # <<< confirm whether in-place overwrite is acceptable, or whether you'd
    #     rather write to a temp file then move, to avoid partial writes if
    #     this step is interrupted mid-run
    tmp_path = source_path + ".transformed"
    try:
        in_count, out_count = transform_file(source_path, tmp_path)
    except ValueError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 1

    if in_count != out_count:
        print(
            f"ERROR: record count mismatch for {source_path}: "
            f"input={in_count} output={out_count}",
            file=sys.stderr,
        )
        return 1

    os.replace(tmp_path, source_path)
    print(f"Transformed {source_path}: {in_count} records, 54-col -> 22-col.")
    return 0


if __name__ == "__main__":
    # Invoked from merge_virtix_chase_files.sh, per _S file, as:
    #   python3 virtix_chase_transform.py "${FILE}"
    # right before that state's merge loop runs (see the *_Chase_S_* case
    # block added to merge_virtix_chase_files.sh for RBICA-14060).
    if len(sys.argv) != 2:
        print("Usage: virtix_chase_transform.py <path_to_S_file>", file=sys.stderr)
        sys.exit(1)

    sys.exit(transform_one(sys.argv[1]))








