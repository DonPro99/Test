def is_already_transformed(header: list) -> bool:
    """True if this file's header already matches the TARGET layout rather
    than the raw _S layout..."""
    return "FileName" in header and "ReturnFileName" not in header


def backup_original(file_path: str) -> None:
    """Copy the untouched _S file to a backup subfolder before transforming,
    for audit/UAT-validation purposes (the original is otherwise lost once
    the in-place transform runs)."""
    source = Path(file_path)
    backup_dir = source.parent / "pre_transform_backup"
    backup_dir.mkdir(exist_ok=True)
    backup_path = backup_dir / source.name
    shutil.copy2(file_path, backup_path)
    print(f"Backed up original to {backup_path}")

