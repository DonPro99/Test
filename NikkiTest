-- Find the User table and its columns
SELECT c.name AS ColumnName, ty.name AS DataType
FROM sys.columns c
JOIN sys.types ty ON c.user_type_id = ty.user_type_id
WHERE c.object_id = OBJECT_ID('dbo.[User]')
ORDER BY c.column_id;

SELECT u.*, app.Id AS ApplicationId, app.DesigneeTypeId, app.StatusId AS AppStatusId
FROM [DMS_Mimic].[dbo].[User] u
JOIN [DMS_Mimic].[dbo].[Application] app ON app.UserId = u.Id
WHERE u.FirstName LIKE '%Anorga%' OR u.LastName LIKE '%Anorga%'  -- adjust column names once confirmed

SELECT t.name AS TableName, c.name AS ColumnName
FROM sys.columns c
JOIN sys.tables t ON c.object_id = t.object_id
WHERE c.name LIKE '%FirstName%' 
   OR c.name LIKE '%LastName%'
   OR c.name LIKE '%DesigneeNumber%'
ORDER BY t.name;
