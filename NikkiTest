                preApprovalRequest.AfsPreApprovalRequest.IsCivilExperience = model.ApplicationInformation.CertificateRatingTypeId == (int)CertificateRatingTypeEnum.Experience
                                                ? model.ApplicationInformation.IsCivilExperience : null;
