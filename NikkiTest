using Dms.Core.EntityFramework.Data;
using Dms.Core.Utils;
using Dms.Services.Interface.Activity;
using Dms.Services.Interface.Lookup;
using Dms.Services.Interface.Message;
using Dms.Services.Interface.Security;
using Dms.Services.Interface.Shared;
using Dms.Services.Interface.Task;
using Dms.Services.ViewModel.Activity;
using Dms.Services.ViewModel.Lookup;
using Microsoft.EntityFrameworkCore;
using System.Collections.Generic;
using System.Linq;

namespace Dms.Services.Implementation.Activity
{
    // Admin-PE-GEN reuses the same Pre-Approval / Post Activity process as Admin-PE 
    // This class only overrides the designee type; all other behavior(Save, Get, SaveAfsPostActivity, etc.) is inherited unchanged.
    public class AdminPeGenPreApprovalRequestService : AdminPePreApprovalRequestService
    {
        public AdminPeGenPreApprovalRequestService(DmsContext context, ITaskService taskService,
            IDocumentService documentService, IActivityService activityService, IMessageService messageService,
            ISharedService sharedService, ILookupService lookupService, IUserService userService)
            : base(context, taskService, documentService, activityService, messageService, sharedService, lookupService,
                userService)
        {
            _designeeType = (int)DesigneeTypeEnum.ADMINPEGEN;
        }

        protected override bool IsAutoPreApproval(PreApprovalRequestViewModel model)
        {
            var cloaAutoPreApproval = _context.PreApprovalRequests
                .Where(par => par.Id == model.Id)
                .Select(par => par.Cloa.IsAutoPreApproval)
                .FirstOrDefault();

            if (cloaAutoPreApproval)
            {
                return true;
            }

            if (model.TestCheckInformation.IsOtherAdminActivity.GetValueOrDefault())
            {
                return false;
            }

            var preApprovalRequest = _context.PreApprovalRequests
                .Include(par => par.PreApprovalRequestFunctionCodes)
                .ThenInclude(pt => pt.PreApprovalRequestFunctionCodeTypeRatings)
                .Include(par => par.PreApprovalRequestFunctionCodes)
                .ThenInclude(pt => pt.PreApprovalRequestFunctionCodeMakeModels)
                .Include(par => par.PreApprovalRequestFunctionCodes)
                .ThenInclude(fc => fc.FunctionCode)
                .Where(par => par.Id == model.Id).FirstOrDefault();

            if (preApprovalRequest == null) return false;

            var cloaFunctionCodes = _context.CloaFunctionCodes
                .Where(c => c.Cloa.ApplicationId == preApprovalRequest.ApplicationId && c.Cloa.CloaStatusId == (int)CloaStatusEnum.Active)
                .Include(c => c.FunctionCode)
                .Include(c => c.CloaFunctionCodeTypeRatings)
                .Include(c => c.CloaFunctionCodeMakeModels)
                .ToArray();

            // Flatten CLOA function codes the same way base does, keeping IsAutoPreApproval per entry
            var flatCloaFunctionCodes = cloaFunctionCodes
                .SelectMany(c => c.FunctionCode.HasTypeRating
                    ? c.CloaFunctionCodeTypeRatings != null && c.CloaFunctionCodeTypeRatings.Any()
                        ? c.CloaFunctionCodeTypeRatings.Select(t => new FunctionCodeViewModel
                        {
                            FunctionCodeId = c.FunctionCodeId,
                            HasTypeRating = c.FunctionCode.HasTypeRating,
                            SelectedTypeRatings = new List<int> { t.TypeRatingId },
                            IsAutomaticPreapproval = t.IsAutoPreApproval
                        }).ToArray()
                        : new List<FunctionCodeViewModel>().ToArray()
                    : new List<FunctionCodeViewModel>
                    {
                new FunctionCodeViewModel
                {
                    FunctionCodeId = c.FunctionCodeId,
                    HasTypeRating = false,
                    IsAutomaticPreapproval = c.IsAutoPreApproval
                }
                    }.ToArray()
                ).ToArray();

            var preApprovalFunctionCodes = preApprovalRequest.PreApprovalRequestFunctionCodes
                .SelectMany(p => p.FunctionCode.HasTypeRating
                    ? p.PreApprovalRequestFunctionCodeTypeRatings != null && p.PreApprovalRequestFunctionCodeTypeRatings.Any()
                        ? p.PreApprovalRequestFunctionCodeTypeRatings.Select(pt => new FunctionCodeViewModel
                        {
                            FunctionCodeId = p.FunctionCodeId,
                            HasTypeRating = p.FunctionCode.HasTypeRating,
                            SelectedTypeRatings = new List<int> { pt.TypeRatingId }
                        }).ToArray()
                        : new List<FunctionCodeViewModel>().ToArray()
                    : new List<FunctionCodeViewModel>
                    {
                new FunctionCodeViewModel
                {
                    FunctionCodeId = p.FunctionCodeId,
                    HasTypeRating = false
                }
                    }.ToArray()
                ).ToArray();

            // Every submitted function code must positively match a CLOA function code flagged auto-preapproval
            bool allSubmittedAreAutoApproved = preApprovalFunctionCodes.All(p =>
                flatCloaFunctionCodes.Any(c => c.FunctionCodeId == p.FunctionCodeId
                    && c.IsAutomaticPreapproval.GetValueOrDefault()
                    && (!c.HasTypeRating || !p.HasTypeRating || p.SelectedTypeRatings.All(pt => c.SelectedTypeRatings.Contains(pt)))));

            return allSubmittedAreAutoApproved;
        }
    }
}
