                                        : p.Application.DesigneeType.Name,
                            IsOtherAdminActivity = p.AfsPreApprovalRequest.IsOtherAdminActivity.GetValueOrDefault(false),
                            ProposedStartDate = p.ProposeStartDate,
                            IsPossibleObservation = p.IsPossibleDirectObservation ?? false,
                            DesigneeCategoryId = p.Application.DesigneeType.DesigneeCategoryId,
                            IsGroup3AdminPreApproval = p.AfsPreApprovalRequest.CategoryId == (int)CategoryEnum.AdminApd || p.AfsPreApprovalRequest.CategoryId == (int)CategoryEnum.AdminTce,
                            ApproverComments = p.ApproverComments,
                            CreatedBy = p.CreatedBy,
                            ModifiedBy = p.ModifiedBy,
                            DesigneeTypeId = model.IsInternal ? null : p.Application.DesigneeTypeId,
                            HasPostActivity = model.IsInternal || p.PostActivities.Count != 0,
                            PostActivityStatusId = model.IsInternal ? null : p.PostActivities.OrderByDescending(p1 => p1.Id).Select(p1 => p1.StatusId).FirstOrDefault()
                        }).PrimengTableFilter(model.PageModel, out int totalRecords)
                        .ToArray();

            var preApprovalRequestIds = data.Select(p => p.Id).ToArray();

            var preApprovalFunctionCodes = _context.PreApprovalRequestFunctionCodes
                                            .Where(p => preApprovalRequestIds.Contains(p.PreApprovalRequestId))
                                            .Select(p => new 
                                            {
                                                MainId = p.PreApprovalRequestId,
                                                p.FunctionCode.Name,
                                                p.FunctionCodeId,
                                                TypeRatings = p.PreApprovalRequestFunctionCodeTypeRatings.Count != 0
                                                ? p.PreApprovalRequestFunctionCodeTypeRatings.Select(p1 => new 
                                                    {
                                                        p1.TypeRating.Name,
                                                        Id = p1.TypeRatingId
                                                    })
                                                : p.PreApprovalRequestFunctionCodeMakeModels.Select(p1 => new 
                                                    {
                                                        Name = p1.MakeModel.Code,
                                                        Id = p1.MakeModelId
                                                    })
                                            }).AsEnumerable()
                                            .GroupBy(p => p.MainId)
                                            .Select(p =>
                                            new
                                            {
                                                PreApprovalRequestId = p.Key,
                                                Type = string.Join(", ", p.SelectMany(p1 => p1.TypeRatings.Any() ? p1.TypeRatings.Select(p2 => p1.Name.Replace("XXXX", p2.Name).Replace("M/M/S", p2.Name)) : new List<string> { p1.Name }))
                                            }).ToArray();

            data = data.Select(d =>
                            {
                                var route = SetPreApprovalUrl(d.Id, d.StatusId.Value, d.DesigneeCategoryId.Value, d.ApproverComments, d.CreatedBy, d.ModifiedBy, d.IsGroup3AdminPreApproval, model.IsInternal);
                                var preApprovalType = preApprovalFunctionCodes.FirstOrDefault(f => f.PreApprovalRequestId == d.Id)?.Type;
                                if (string.IsNullOrWhiteSpace(preApprovalType)) 
                                {
                                    preApprovalType = !d.IsOtherAdminActivity.GetValueOrDefault(false) ? string.Empty : "Other Activity";
                                }
                                d.PreApprovalType = preApprovalType;
                                d.Url = route.Url;
                                d.IsNewWindow = route.IsNewWindow;
                                d.HasNavigation = !string.IsNullOrWhiteSpace(route.Url);
                                if (!model.IsInternal) 
                                {
                                    d.Cancel = (d.StatusId == (int)PreApprovalRequestStatusEnum.Approved && d.HasPostActivity && d.PostActivityStatusId == (int)PreApprovalRequestStatusEnum.Completed)
                                        || d.StatusId == (int)PreApprovalRequestStatusEnum.Canceled
                                        || d.StatusId == (int)PreApprovalRequestStatusEnum.Completed
                                        || d.StatusId == (int)PreApprovalRequestStatusEnum.Rejected
                                        || (d.IsApproved.HasValue && !d.IsApproved.Value)
                                            ? null
                                            : d.Id.ToString();
                                }
                                return d;
                            }).ToArray();

            return new PaginationViewModel<IList<ActivityPaperWorkViewModel>>(totalRecords, data);
        }


