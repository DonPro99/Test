package com.anthem.hca.chaselist.automation

import java.io.File
import scala.util.control.NonFatal
import org.joda.time.DateTime
import org.slf4j.LoggerFactory
import com.anthem.hca.availity.email.Email
import com.anthem.hca.availity.log.LoadLogKey
import com.anthem.hca.availity.log.LogInfo
import com.typesafe.config.ConfigFactory

/**
 *
 * @author Dikshith Shetty
 * @version 1.0 tes
 *
 *          A class for loading persistent deploy table in Hive based on the intervention and line of business.
 */

class DeployLoader(propFilePath: String, configFolder:String, configFile:String, var runId:String) extends Utilities {

  def loadDeployData(interventionName: String, lobName: String) {

    val log = LoggerFactory.getLogger("DeployLoader")
    log.info(s"Starting Deploy loader for line of business:$lobName and intervention :$interventionName")
    log.info(s"Application properties file path:$propFilePath")

    val cfg = ConfigFactory.parseFile(new File(propFilePath))
    val environment = cfg.getString("environment")
    val release = cfg.getString("release")

    var hiveDBName: String = ""
    var deployMasterTable: String = ""
    val interventionValue = Set("PCMS","COBCPRSP","AVAILPRSP")

    val loadLogKeyTable : String = cfg.getString("intervention.master.hive.table.loadlog")

    if (lobName.equalsIgnoreCase("ACA") && !interventionValue.contains(interventionName)){

      hiveDBName = cfg.getString("intervention.hive.nogbddatabase")
      deployMasterTable = cfg.getString("intervention.master.hive.table.deploy")
    }
    else {
      hiveDBName = cfg.getString("intervention.hive.database")
      deployMasterTable = cfg.getString("intervention.master.hive.table.deploy")
    }


    val stageDb = hiveDBName.substring(0,7)

    //determines the temporary deploy table to be used
    log.info(s"DeployLoader - Determine hive tables for line of business:$lobName")
    var intervention: String = interventionName.trim().toLowerCase()
    var lob: String = lobName.trim().toLowerCase()
    log.info(s"lob is  : $lob")

    val deployTempTable = s"deply_${intervention}_${lob}_stg"

    val processname: String = cfg.getString(s"${intervention}.${lob}.processname")
    val processid: Int = cfg.getInt(s"${intervention}.${lob}.processid")

    //Notification & Batchid Config
    val email = new Email()
    val emailFrom = cfg.getString("emailFrom")
    val emailTo = cfg.getString("emailTo")
    var batchId = 0L
    var carprspBatchId = 0L
    val source = interventionName.trim().toUpperCase()
    val ts = DateTime.now().toString()
    //val ds = ts.subSequence(0, 10).toString()
    var insertDatatoHive = true
    val step = cfg.getString("step")
    val stepID = cfg.getInt("stepID")
    val status1 = cfg.getString("status1")
    val status2 = cfg.getString("status2")
    val urlPath = cfg.getString("urlPath")

    lob = if (lob.startsWith("radv_")) lob.replaceFirst("radv_", "") else lob

    //Details for Carillion Process
    var carillionProcessId = 0;
    var carillionProcessName = "";
    val carillionStep = "Inserting batchId for Carillion process"
    val carillionUrlPath = "No Path:Inserting batchId for Carillion process"
    val carillionSource = "CARPRSP"

    log.info(s"Temp Deploy Table Name:$deployTempTable")

    val spark = this.getSession(configFolder, configFile)
    val appId = "" //this.getSparkContext().applicationId

    try {
      runId = spark.sql("select md5(current_timestamp)").first().get.getString(0)

      spark.sql(s"use schema $hiveDBName ").count()
      //Capture the error record from temporary deploy table into error table.

      var res = spark.sql(s"""SELECT MAX(batchid) from RAA_RAWZ.${loadLogKeyTable} where processid = $processid """).first().get

      if (!res.isNullAt(0)) {
        batchId = res.getLong(0)
      }
      batchId = batchId + 1;

      //Carillion specific logic
      if (intervention == "carprsp") {

        carillionProcessId = cfg.getInt(s"carprsp.${lob}.processid")
        carillionProcessName = cfg.getString(s"carprsp.${lob}.processname")

        var carprspres = spark.sql(s"""SELECT MAX(batchid) from RAA_RAWZ.${loadLogKeyTable} where processid = $carillionProcessId """).first().get
        if (!carprspres.isNullAt(0)) {
          carprspBatchId = carprspres.getLong(0)
        }
        carprspBatchId = carprspBatchId + 1
      }

      //Check for transient table row count
      var row_count_check = spark.sql(s"select count(*) from $stageDb.RAA_RAWZ_STG.${deployTempTable}").first().get
      var row_count = 0L
      if (!row_count_check.isNullAt(0)) {
        row_count = row_count_check.getLong(0)
      }


      //Insert to Load Log Key table
      if (row_count == 0) {
        log.info(s"Inserting the data into ${deployMasterTable} failed as there are no records in ${deployTempTable}")
        email.sendMail(emailFrom, emailTo, s"AppId : $appId Failed", s"- Batch $batchId :Inserting transient data to persistent table Failed as ${deployTempTable} table is empty")
        val li = new LogInfo(runId, batchId, source, urlPath, row_count, processname, processid, step, stepID, status2, ts, DateTime.now().toString())
        LoadLogKey.log(spark, li)
        insertDatatoHive = false;
      }

      if (insertDatatoHive) {
        /**
         * Need to check the data for INVPRSP with Type_of_Intervention in add_col1 and for all other intervention load directly to master deploy table
         */
        if (interventionName.equalsIgnoreCase("INVPRSP")) {

          //Load the temporary deploy table into persistent deploy table rad_deploy_all_lob.

          log.info(s"Master Deploy Table Name: ${deployMasterTable} ${deployTempTable}")
          spark.sql(s"""delete from ${deployMasterTable} where upper(intervention)=upper('${intervention}')
                       |and upper(LOB)=upper('${lob}') and  INSERT_DT=current_date() and batch_id='${batchId}' """.stripMargin).count();
          spark.sql(
            s""" INSERT into ${deployMasterTable}
                       select
                       current_timestamp() as edl_load_dtm,
                       '$runId' as edl_run_id,
                       'NA' as EDL_SCRTY_LVL_CD,
                       '$lob' as EDL_LOB_CD,
                       'NA' as EDL_EXTRNL_LOAD_CD,
                       CASE
                          WHEN '$lob' LIKE 'MEDICAID%' THEN '1104'
                          WHEN '$lob' LIKE 'MCR%' THEN '1104'
                          WHEN '$lob' LIKE 'MRA%' THEN '1104'
                          WHEN '$lob' LIKE 'MCAID%' THEN '1104'
                       ELSE '9' end as EDL_SOR_CD,
                       recordid,filedatetime,add_val1,add_col1,add_val2,add_col2,add_val3,add_col3,
                       rundatetime,outbound_date,userid,add_val4,add_col4,add_val5,add_col5,add_val6,add_col6,add_val7,
                       add_col7,add_val8,add_col8,add_val9,add_col9,add_val10,add_col10,add_val11,add_col11,add_val12,
                       add_col12,add_val13,add_col13,add_val14,add_col14,add_val15,add_col15,gapdatetime,intervention,lob,
                       current_date as insert_dt,
                       '${batchId}' as batch_id
                       from $stageDb.RAA_RAWZ_STG.${deployTempTable}
                       where trim(add_col1)='Type_of_Intervention' """).count()


          log.info(s"Inserting the data into ${deployMasterTable} completed successfully ")
          val li = new LogInfo(runId, batchId, source, urlPath, row_count, processname, processid, step, stepID, status1, ts, DateTime.now().toString())
          LoadLogKey.log(spark, li)

          //Log a batchid for carillion process too.
          val carprspli = new LogInfo(runId, carprspBatchId, carillionSource, carillionUrlPath, 0, carillionProcessName, carillionProcessId, carillionStep, stepID, status1, ts, DateTime.now().toString())
          LoadLogKey.log(spark, carprspli)
        } else {


          log.info(s"Master Deploy Table Name: ${deployMasterTable} ${deployTempTable}")
          spark.sql(
            s"""delete from ${deployMasterTable} where upper(intervention)=upper('${intervention}')
               |and upper(LOB)=upper('${lob}') and INSERT_DT=current_date() and batch_id='${batchId}' """.stripMargin).count();
          spark.sql(
            s""" INSERT into ${deployMasterTable}
                       select
                       current_timestamp() as edl_load_dtm,
                       '$runId' as edl_run_id,
                       'NA' as EDL_SCRTY_LVL_CD,
                       case when upper('$lob') = 'MRA' THEN 'MCR' else '$lob' end as EDL_LOB_CD,
                       'NA' as EDL_EXTRNL_LOAD_CD,
                       CASE
                          WHEN '$lob' LIKE 'MEDICAID%' THEN '1104'
                          WHEN '$lob' LIKE 'MCR%' THEN '1104'
                          WHEN '$lob' LIKE 'MRA%' THEN '1104'
                          WHEN '$lob' LIKE 'MCAID%' THEN '1104'
                       ELSE '9' end as EDL_SOR_CD,
                       recordid,filedatetime,add_val1,add_col1,add_val2,add_col2,add_val3,add_col3,
                       rundatetime,outbound_date,userid,add_val4,add_col4,add_val5,add_col5,add_val6,add_col6,add_val7,
                       add_col7,add_val8,add_col8,add_val9,add_col9,add_val10,add_col10,add_val11,add_col11,add_val12,
                       add_col12,add_val13,add_col13,add_val14,add_col14,add_val15,add_col15,gapdatetime,intervention,lob,
                       current_date as insert_dt,
                       '${batchId}' as batch_id
                      from $stageDb.RAA_RAWZ_STG.${deployTempTable} """).count()
          log.info(s"Inserting the data into ${deployMasterTable} completed successfully ")

          //Create the archive directory for deploy files  in hdfs.
          log.info(s"*****Successfully finished DeployLoader job for intervention : ${intervention} , LOB : ${lob}******")
          val li = new LogInfo(runId, batchId, source, urlPath, row_count, processname, processid, step, stepID, status1, ts, DateTime.now().toString())
          LoadLogKey.log(spark, li)
        }
      }


    } catch {
      case NonFatal(exception) => {
        exception match {
          case exception: Exception => {
            val errMsg = exception.getLocalizedMessage
            exception.printStackTrace
            email.sendMail(emailFrom, emailTo, s"AppId : $appId Failed", s"Batch $batchId :Inserting ${deployTempTable} data to persistent table Failed : ${errMsg}")
            val li = new LogInfo(runId, batchId, source, urlPath, 0, processname, processid, step, stepID, status2, ts, DateTime.now().toString())
            LoadLogKey.log(spark, li)
            throw new RuntimeException(s"Error encountered during Deploy loader job for intervention ${intervention} and lob ${lob}", exception)
          }
          case _ => {
            val errMsg = exception.getLocalizedMessage
            exception.printStackTrace
            email.sendMail(emailFrom, emailTo, s"AppId : $appId Failed", s"Batch $batchId :Inserting ${deployTempTable} data to persistent table Failed : ${errMsg}")
            val li = new LogInfo(runId, batchId, source, urlPath, 0, processname, processid, step, stepID, status2, ts, DateTime.now().toString())
            LoadLogKey.log(spark, li)
            throw new RuntimeException(s"Error encountered during Deploy loader job for intervention ${intervention} and lob ${lob}", exception)
          }
        }
      }
    }
  }
}
