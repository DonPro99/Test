@if (data != null && data.designeeInfo != null && form) {
  <div id="preApprovalRequestDiv">
    <pagetitle title="Administrative Post Activity Report" userGuideCompTypeCode="PostActAdmin"
    [designeeTypeId]="designeeTypeId"></pagetitle>
    <form [formGroup]="form" id="id_afspostact_form">
      <div id="id_afspostact_div_dpesae">
        <designeesummary-page [designeeInformation]="data.designeeInfo" [showPersonPerformed]="false">
        </designeesummary-page>
        <requestinfo-page [requestInfo]="data.requestInfo" [displayPreApprovalLink]="true" [preApprovalUrl]="preApprovalUrl">
        </requestinfo-page>
        @if (iacraDisplay) {
          <afsgroup2iacra [form]="form" [designeeTypeId]="designeeTypeEnum.ADMINPE"
            [preApprovalRequestData]="$any(data.preApprovalRequest)" [postActivityId]="$any(data.id)" (iacraDocs)="addIacraDocs($event)"
            [isDisabled]="!isDisabled && !isEditPostActivity" [afsGrp2IacraFormGroup]="form.get('afsGrp2IacraFormGroup')">
          </afsgroup2iacra>
        }
        <dms-test-check-information #testcheckinfoComponent
          [testCheckInformation]="data.preApprovalRequest?.testCheckInformation" [designeeTypeId]="designeeTypeId"
          [form]="form.get('testCheckInformation')" [categoryId]="categoryId" [isPostActivity]=true
          [triggerFieldChangeEvent]=false
        [isIacra]="showIacra" [modifiedControls]="
                                        isRedirectionFromCorrectiveAction === true  &&
                                        data.preApprovalRequest?.modifiedPreapprovalControls
                                        ? data.preApprovalRequest?.modifiedPreapprovalControls
                                            .testCheckInformation
                                        : []" [modifiedTestInfoControls]="
                                        isRedirectionFromCorrectiveAction === true  &&
                                        data.preApprovalRequest?.modifiedPreapprovalControls
                                        ? data.preApprovalRequest?.modifiedPreapprovalControls.testInformation
                                        : []" [modifiedApplicantInfoControls]="
                                        isRedirectionFromCorrectiveAction === true  &&
                                        data.preApprovalRequest?.modifiedPreapprovalControls
                                        ? data.preApprovalRequest?.modifiedPreapprovalControls
                                            .applicantInformation
                                        : []">
        </dms-test-check-information>
        <dms-activity-location [location]="$any(data.preApprovalRequest?.activityLocation)" [designeeTypeId]="designeeTypeId"
          [form]="form.get('activityLocation')" [isPostActivity]=true [isDisabled]="isDisabled"
        [correctiveActionEditable]=true [triggerFieldChangeEvent]=false [categoryId]="categoryId" [modifiedControls]="
                                    isRedirectionFromCorrectiveAction === true  &&
                                    data.preApprovalRequest?.modifiedPreapprovalControls
                                    ? data.preApprovalRequest?.modifiedPreapprovalControls.activityLocation
                                    : []">
        </dms-activity-location>
      </div>
      <!-- Post Activity components -->
      @if (designeeTypeId != null && designeeTypeId > 0) {
        <div id="postActivityInfo">
          <p-panel id="postActivityInfoPanel1" [toggleable]="true">
            <p-header>Enter Post Activity information below</p-header>
            <group2postactivity-page #group2PostActivityComponent [afsPostActivityGroup2]="data.afsPostActivityGroup2"
              [preApprovalRequestData]="data.preApprovalRequest" [preApprovalRequestFormGroup]="form"
              [form]="form.get('afsGroup2PostActivityFormGroup')" [isExternal]="isExternal"
              [testCheckInformation]="data.preApprovalRequest?.testCheckInformation" [designeeTypeId]="designeeTypeId"
              [isProficiencyCheck]="isProficiencyCheck" [categoryId]="categoryId" [isDisabled]="isDisabled"
              [isEditPostActivity]="isEditPostActivity" [isActulDateDifference]="isActualDateDifference">
            </group2postactivity-page>
            <poapplicationinfo-page [applicationInformation]="data.preApprovalRequest?.applicationInformation"
              [designeeTypeId]="designeeTypeId" [preApprovalRequestFormGroup]="form" [triggerFieldChangeEvent]=false
              [isDisabled]="isDisabled" [form]="form.get('poapplicationInformationGroup')" [correctiveActionEditable]=true
              [categoryId]="categoryId" [isEditPostActivity]="isEditPostActivity">
            </poapplicationinfo-page>
            <!-- Comments -->
            <div id="postActivityCoomentsInfo">
              <p-panel id="postActivityCommentsInfoPanel" [toggleable]="true">
                <p-header><label for="id_postact_textarea_comments">Comments</label></p-header>
                <dms-input-text-area identity="id_postact_textarea_comments" formControlName="generalComments"></dms-input-text-area>
              </p-panel>
            </div>
            <dms-uploadcontrol #uploadControl [uploadFormGroup]="form" formControlName="uploadId"
              [documentReference]="data.documentReference" [isUploadDocumentEditing]="isEditPostActivity">
            </dms-uploadcontrol>
          </p-panel>
          @if (isCancel && data.preApprovalRequest?.cancellationTypeId != null) {
            <div [formGroup]="form" id="cancelInfo">
              <p-panel id="preApprovalCancelPanel" [toggleable]="true">
                <p-header>Reason for Cancellation</p-header>
                <dms-dropdown identity="id_preapproval_reason_drpdwn" [options]="cancelReasons"
                formControlName="reasonDropdown"></dms-dropdown>
                <br />
                @if (data.preApprovalRequest?.justificationForCancellation != '') {
                  <dms-input-text-area label="Reason"
                  identity="id_preapprqst_textarea_cancel_comments" formControlName="cancelComments"></dms-input-text-area>
                }
              </p-panel>
            </div>
          }
        </div>
      }
    </form>
  </div>
}
