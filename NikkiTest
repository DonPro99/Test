ngOnInit() {
  super.initialize();
  this.designeeTypeId = this.data?.preApprovalRequest?.designeeTypeId ?? DesigneeTypeEnum.ADMINPE;
  this.isRedirectionFromCorrectiveAction =
    this.route.snapshot.params['cAction'] === 'true';
  this.form = AdminpeIndexComponent.buildForm(this.data, {
    designeeTypeId: this.designeeTypeId,
    isDisabled: this.isDisabled,
    categoryId: this.categoryId,
    isEditPostActivity: this.isEditPostActivity,
    isAttachmentNotRequired: true,
    isAdmin: this.isAdministrativePreapproval
  });
}
