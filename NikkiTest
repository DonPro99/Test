        private static LinkViewModel SetPreApprovalUrl(int id, int statusId, int designeeCategoryId, string comments, int createdBy, int? modifiedBy, bool isGroup3AdminPreApproval, bool isInternal)
        {
            var url = string.Empty;
            var isNewWindow = false;
            if (!isInternal)
            {
                url = designeeCategoryId is (int)DesigneeCategoryEnum.FlightStandardsAirTransportationService
                                ? (new[] { (int)PreApprovalRequestStatusEnum.Completed, (int)PreApprovalRequestStatusEnum.Canceled, (int)PreApprovalRequestStatusEnum.Rejected }).Contains(statusId)
                                    ? $"/preapproval/afs/group3/summary/{CryptoExtensions.Encrypt(id)}/{isGroup3AdminPreApproval.Encrypt()}"
                                    : $"/preapproval/afs/group3?requestId={CryptoExtensions.Encrypt(id)}&isAdmin={isGroup3AdminPreApproval.Encrypt()}"
                                : $"/preapprovalrequest/afs/{CryptoExtensions.Encrypt(id)}";
                return new LinkViewModel
                {
                    Code = "PR",
                    Url = url,
                    IsNewWindow = isNewWindow
                };
            }

            if (statusId is not ((int)PreApprovalRequestStatusEnum.Saved) and
                not ((int)PreApprovalRequestStatusEnum.Initiated))
            {
                if (designeeCategoryId is (int)DesigneeCategoryEnum.FlightStandardsAirTransportationService)
                {
                    url = $"/preapprovalrequest/evaluate/{CryptoExtensions.Encrypt(id)}";
                }
                else if (statusId is ((int)PreApprovalRequestStatusEnum.Approved) && comments != null && comments.Equals("Auto Pre Approval") && createdBy == modifiedBy) 
                {
                    url = $"/preapprovalrequest/afs/evaluate/{CryptoExtensions.Encrypt(id)}";
                }
                else 
                {
                    url = $"/preapprovalrequest/afs/summary/{CryptoExtensions.Encrypt(id)}";
                    isNewWindow = true;
                }
            }       
             
            return new LinkViewModel
            {
                Code = "PR",
                Url = url,
                IsNewWindow = isNewWindow
            };
        }

        private static LinkViewModel SetPostActivityUrl(int id, int? statusId, int designeeCategoryId, bool isGroup3AdminPreApproval, bool isInternal)
        {
            var url = string.Empty;
            var isNewWindow = false;
            if (isInternal)
            {
                SetPostActivityUrlForInternal(id, statusId, designeeCategoryId, isGroup3AdminPreApproval, ref url, ref isNewWindow);
            }
            else
            {
                url = SetPostActivityUrlForExternal(id, statusId, designeeCategoryId, isGroup3AdminPreApproval);
            }

            return new LinkViewModel
            {
                Code = "PO",
                Url = url,
                IsNewWindow = isNewWindow
            };
        }

        private static string SetPostActivityUrlForExternal(int id, int? statusId, int designeeCategoryId, bool isGroup3AdminPreApproval)
        {
            string url;
            if (designeeCategoryId == (int)DesigneeCategoryEnum.FlightStandardsAirTransportationService)
            {
                if (statusId is ((int)PreApprovalRequestStatusEnum.Completed) or ((int)PreApprovalRequestStatusEnum.Canceled) or ((int)PreApprovalRequestStatusEnum.Rejected))
                {
                    url = $"/postactivity/afs/group3/summary/{id.Encrypt()}/{isGroup3AdminPreApproval.Encrypt()}?activityStatus={statusId.Encrypt()}";
                }
                else
                {
                    url = $"/postactivity/afs/group3/{id.Encrypt()}/{isGroup3AdminPreApproval.Encrypt()}?activityStatus={statusId.Encrypt()}";
                }
            }
            else
            {
                url = $"/postactivity/afsgroups/{id.Encrypt()}";
            }

            return url;
        }

        private static void SetPostActivityUrlForInternal(int id, int? statusId, int designeeCategoryId, bool isGroup3AdminPreApproval, ref string url, ref bool isNewWindow)
        {
            if (statusId is ((int)PreApprovalRequestStatusEnum.Completed) or ((int)PreApprovalRequestStatusEnum.Canceled)
                or ((int)PreApprovalRequestStatusEnum.Initiated) or ((int)PreApprovalRequestStatusEnum.Pending)
                or ((int)PreApprovalRequestStatusEnum.Submitted) or ((int)PreApprovalRequestStatusEnum.Returned))
            {
                url = designeeCategoryId == (int)DesigneeCategoryEnum.FlightStandardsAirTransportationService
                        ? $"/postactivity/group3/summary/{id}/{isGroup3AdminPreApproval}/false/false"
                        : $"/postactivity/afsgroups/{id}/{isGroup3AdminPreApproval}/false";
                isNewWindow = true;
            }
        }

        private string PostActivityType(int designeeTypeId, string formDataAuthFunctionCodes, string formDataSelectedFunctionCodes, string formDataSelectedRequestAuthorizations, IList<DesigneeTypeFunctionCodeViewModel> functionCodes, string formDataTestCheckInformation = null)
        {
            var selectedFunctionCodes = formDataSelectedFunctionCodes != null ? JsonConvert.DeserializeObject<IEnumerable<int>>(formDataSelectedFunctionCodes) : null;
            var authorizationFunctionCodes = formDataAuthFunctionCodes != null ? JsonConvert.DeserializeObject<IEnumerable<FunctionCodeViewModel>>(formDataAuthFunctionCodes) : null;
            var selectedRequestAuthorizations = formDataSelectedRequestAuthorizations != null ? JsonConvert.DeserializeObject<IEnumerable<FunctionCodeViewModel>>(formDataSelectedRequestAuthorizations) : null;
            authorizationFunctionCodes = CloaPreApprovalRequestViewModelMapper.FillFunctionCodes(authorizationFunctionCodes, functionCodes);
            selectedRequestAuthorizations = CloaPreApprovalRequestViewModelMapper.FillFunctionCodes(selectedRequestAuthorizations, functionCodes);
            switch (designeeTypeId)
            {
                case (int)DesigneeTypeEnum.APD:
                case (int)DesigneeTypeEnum.TCE:
                    return GetTceApdPostActivityType(designeeTypeId, selectedRequestAuthorizations);
                case (int)DesigneeTypeEnum.DADE:
                    if (selectedFunctionCodes == null) { return null; }
                    return authorizationFunctionCodes.Single(s => s.Id == selectedFunctionCodes.First()).FunctionCode;
                case (int)DesigneeTypeEnum.ADMINPEGEN:
                    return GetAdminPeGenPostActivityType(formDataTestCheckInformation);
                default:
                    return string.Empty;
            }
        }

        private static string GetAdminPeGenPostActivityType(string formDataTestCheckInformation)
        {
            if (string.IsNullOrWhiteSpace(formDataTestCheckInformation)) return string.Empty;

            JObject jObj;
            try
            {
                jObj = JObject.Parse(formDataTestCheckInformation);
            }
            catch
            {
                return string.Empty;
            }

            bool ReadFlag(string propertyName)
            {
                // case-insensitive lookup, handles PascalCase or camelCase JSON serialization
                var token = jObj.Properties().FirstOrDefault(p => string.Equals(p.Name, propertyName, StringComparison.OrdinalIgnoreCase))?.Value;
                return token != null && token.Type != JTokenType.Null && token.Value<bool>();
            }

            var codes = new (string Label, bool IsSelected)[]
            {
                ("FPE", ReadFlag("IsAdminPeGenFPE")),
                ("MCE", ReadFlag("IsAdminPeGenMCE")),
                ("GIE", ReadFlag("IsAdminPeGenGIE")),
                ("FIRE", ReadFlag("IsAdminPeGenFIRE")),
                ("BAE", ReadFlag("IsAdminPeGenBAE")),
            };

            return string.Join(", ", codes.Where(c => c.IsSelected).Select(c => c.Label));
        }

        private string GetTceApdPostActivityType(int designeeTypeId, IEnumerable<FunctionCodeViewModel> selectedRequestAuthorizations)
        {
            if (selectedRequestAuthorizations == null) { return string.Empty; }
            return string.Join(",", selectedRequestAuthorizations
                                        .SelectMany(p1 =>
                                            (p1.SelectedTypeRatings == null || !p1.SelectedTypeRatings.Any())
                                                ? new List<int> { 0 }
                                                : p1.SelectedTypeRatings,
                                                (parent, child) => new
                                                {
                                                    parent.FunctionCode,
                                                    parent.HasTypeRating,
                                                    label = GetTypeRatingMakeModelLabel(child, designeeTypeId)
                                                })
                                        .Select(p1 => p1.HasTypeRating
