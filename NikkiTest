
<menu-bar></menu-bar>
<pagetitle title="Activity Paperwork" iconClass="fa-list-alt"></pagetitle>
<form id="activityPaperWorkForm">
  <div>
    <p-panel>
      <ng-template pTemplate="header">
        <div class="flex align-items-center font-semibold">
          {{prLabel}}
        </div>
      </ng-template>
      <ng-template pTemplate="icons">
        <dms-radio-button class="font-semibold" name="oneYearData" identity="id_index_chk_load_data"
          [formControl]="oneYearData" layout="grid" controlSize="medium" (clickEvent)="loadData()" [hideValidationPlaceHolder]="true"
          [radioValues]="[{ label: 'Past one year data', value: true },{ label: 'All data', value: false }]">
        </dms-radio-button>
      </ng-template>
      <p-table role="presentation" #dtPreApproval  responsiveLayout="stack" breakpoint="50rem" emptymessage="No records found" id="preApprovalRequestActivities"
        [value]="preApprovals" [rows]="10" [paginator]="true" [pageLinks]="3" [totalRecords]="prTotalRecords" [lazy]="true"
        [loading]="prLoading" (onLazyLoad)="loadPreApprovals($event)" [showCurrentPageReport]="true" currentPageReportTemplate="{{prSummary}}"
        sortField="trackingNumber" [sortOrder]="-1">
        <ng-template pTemplate="header">
          <tr role="row">
            <th role="columnheader" pSortableColumn="trackingNumber" id="idTrackingNumber" style="min-width: 14rem;">DMS Tracking #<p-sortIcon field="trackingNumber">
            </p-sortIcon>
          </th>
          <th role="columnheader" pSortableColumn="typeOfRequest" id="idTypeOfRequest" style="min-width: 14rem;">Type of Request<p-sortIcon
          field="typeOfRequest"></p-sortIcon>
        </th>
        @if (!isAfsGroup) {
          <th role="columnheader" pSortableColumn="preApprovalType" id="idPreApprovalType" style="min-width: 10rem;">Pre-Approval Type<p-sortIcon
          field="preApprovalType"></p-sortIcon>
        </th>
      }
      @if (isAfsGroup) {
        <th role="columnheader" id="idPreApprovalType" style="min-width: 10rem;">Pre-Approval Type
        </th>
      }
      <th role="columnheader" pSortableColumn="activityStatus" id="idActivityStatus" style="min-width: 7rem;">Activity Status<p-sortIcon
      field="activityStatus"></p-sortIcon>
    </th>
    <th role="columnheader" pSortableColumn="modifiedDate" id="idModifiedDate" style="min-width: 8rem;">Modified Date<p-sortIcon
    field="modifiedDate"></p-sortIcon>
  </th>
  <th role="columnheader" pSortableColumn="applicantName" id="idApplicantName" style="min-width: 14rem;">Applicant Names<p-sortIcon
  field="applicantName"></p-sortIcon>
</th>
<th role="columnheader" id="idCancel" style="min-width: 12rem;">Cancel</th>
</tr>
</ng-template>
<ng-template pTemplate="body" let-originalPreApprovalRequest>
  <tr role="row">
    <td role="cell">
      <span class="p-column-title" role="columnheader">DMS Tracking #</span>
      <span><a href="javascript:void(0)" name="dmsTrackingNo"
      (click)="goToUrl(originalPreApprovalRequest.url)">{{originalPreApprovalRequest.trackingNumber}}</a></span>
    </td>
    <td role="cell">
      <span class="p-column-title" role="columnheader">Type of Request</span>
      <span>{{originalPreApprovalRequest.typeOfRequest}}</span>
    </td>
    <td role="cell" styleClass="colWidthAll" [style]="{ 'word-wrap': 'break-word' }">
      <span class="p-column-title" role="columnheader">Pre-Approval Typee</span>
      <span>{{originalPreApprovalRequest.preApprovalType}}</span>
    </td>
    <td role="cell">
      <span class="p-column-title" role="columnheader">Activity Status</span>
      <span>{{originalPreApprovalRequest.activityStatus}}</span>
    </td>
    <td role="cell">
      <span class="p-column-title" role="columnheader">Modified Date</span>
      <span>{{originalPreApprovalRequest.modifiedDate | date:'MM/dd/yyyy'}}</span>
    </td>
    <td role="cell">
      <span class="p-column-title" role="columnheader">Applicant Names</span>
      <span>{{originalPreApprovalRequest.applicantName}}</span>
    </td>
    <td role="cell">
      <span class="p-column-title" role="columnheader">Cancel</span>
      @if (originalPreApprovalRequest.cancel != null) {
        <a href="javascript:void(0)" id="cancelPreApprovalRequest"
        (click)="cancelPreApprovalRequest(originalPreApprovalRequest);">Cancel This Request</a>
      }
    </td>
  </tr>
</ng-template>
<ng-template pTemplate="emptymessage">
  <tr role="row">
    <td role="cell" class="norecord" colspan="7">
      No records found
    </td>
  </tr>
</ng-template>
</p-table>
</p-panel>
<p-panel header={{poLabel}}>
  <p-table role="presentation" #dtPostActivities  id="postActivities" tableStyleClass="table_postActivities" [value]="postActivities" [rows]="10" [paginator]="true"
    [pageLinks]="3" responsiveLayout="stack" breakpoint="50rem" [loading]="poLoading" [totalRecords]="poTotalRecords" [lazy]="true" (onLazyLoad)="loadPostActivities($event)"
    [showCurrentPageReport]="true" currentPageReportTemplate="{{poSummary}}" sortField="trackingNumber" [sortOrder]="-1">
    <ng-template pTemplate="header">
      <tr role="row">
        <th role="columnheader" pSortableColumn="trackingNumber" id="idTrackingNumber1" style="min-width: 14rem;">DMS Tracking #<p-sortIcon field="trackingNumber">
        </p-sortIcon>
      </th>
      <th role="columnheader" pSortableColumn="typeOfRequest" id="idTypeOfRequest1" style="min-width: 14rem;">Type of Request<p-sortIcon
      field="typeOfRequest"></p-sortIcon>
    </th>
    @if (isAfsGroup) {
      <th role="columnheader" id="idPreApprovalType" style="min-width: 14rem;">Pre-Approval Type
      </th>
    }
    @if (!isAfsGroup) {
      <th role="columnheader" pSortableColumn="preApprovalType" id="idPreApprovalType" style="min-width: 14rem;">Pre-Approval Type<p-sortIcon
      field="preApprovalType"></p-sortIcon>
    </th>
  }
  <th role="columnheader" pSortableColumn="activityStatus" id="idActivityStatus1" style="min-width: 8rem;">Activity Status<p-sortIcon
  field="activityStatus"></p-sortIcon>
</th>
<th role="columnheader" pSortableColumn="dueDate" id="idModifiedDate1" style="min-width: 8rem;">Post Activity Report Due Date<p-sortIcon
field="dueDate"></p-sortIcon>
</th>
<th role="columnheader" pSortableColumn="submissionDate" id="idSubmissionDate1" style="min-width: 8rem;">Submission Date<p-sortIcon
field="submissionDate"></p-sortIcon>
</th>
<th role="columnheader" pSortableColumn="applicantName" id="idApplicantName1" style="min-width: 14rem;">Applicant Names<p-sortIcon
field="applicantName"></p-sortIcon>
</th>
@if (!isManufacturingGroup) {
  <th role="columnheader" id="idVersion1" style="min-width: 7rem;">Version(s)</th>
}
</tr>
</ng-template>
<ng-template pTemplate="body" let-originalPostActivity>
  <tr role="row">
    <td role="cell">
      <span class="p-column-title" role="columnheader">DMS Tracking #</span>
      <span>
        <a href="javascript:void(0)" id="dmsTrackingNo"
        (click)="goToUrl(originalPostActivity.url)">{{originalPostActivity.trackingNumber}}</a>
      </span>
    </td>
    <td role="cell">
      <span class="p-column-title" role="columnheader">Type of Request</span>
      <span>{{originalPostActivity.typeOfRequest}}</span>
    </td>
    <td role="cell" styleClass="colWidthAll" [style]="{ 'word-wrap': 'break-word' }">
      <span class="p-column-title" role="columnheader">Pre-Approval Type</span>
      <span>{{originalPostActivity.preApprovalType}}</span>
    </td>
    <td role="cell">
      <span class="p-column-title" role="columnheader">Activity Status</span>
      <span>{{originalPostActivity.activityStatus}}</span>
    </td>
    <td role="cell">
      <span class="p-column-title" role="columnheader">Post Activity Report Due Date</span>
      <span>{{originalPostActivity.dueDate | date:'MM/dd/yyyy'}}</span>
    </td>
    <td role="cell">
      <span class="p-column-title" role="columnheader">Submission Date</span>
      <span>{{originalPostActivity.submissionDate | date:'MM/dd/yyyy'}}</span>
    </td>
    <td role="cell">
      <span class="p-column-title" role="columnheader">Applicant Name</span>
      <span>{{originalPostActivity.applicantName}}</span>
    </td>
    @if (!isManufacturingGroup) {
      <td role="cell">
        <span class="p-column-title" role="columnheader">Versions</span>
        @if (originalPostActivity.activityStatus === 'Completed') {
          <span>
            <a href="javascript:void(0)" id="selectVersion"
            (click)="selectVersion($event, originalPostActivity, versions);">Versions</a></span>
          }
        </td>
      }
    </tr>
  </ng-template>
  <ng-template pTemplate="emptymessage">
    <tr role="row">
      <td role="cell" class="norecord" colspan="8">
        No records found
      </td>
    </tr>
  </ng-template>
</p-table>
</p-panel>
<p-popover #versions>
  @if (activityPaperWork != null && activityPaperWork.postActivityVersions != null) {
    <p-table role="presentation"  tableStyleClass="table_postActivitiesversion_{{activityPaperWork.id}}"
      [value]="$any(activityPaperWork.postActivityVersions)">
      <ng-template pTemplate="header">
        @if (!isManufacturingGroup) {
          <tr>
            <th role="columnheader" id="id_version_overlay">Version(s)</th>
          </tr>
        }
      </ng-template>
      <ng-template pTemplate="body" let-postActivityVersion>
        <tr class="font-bold-mobile">
          @if (!isManufacturingGroup) {
            <td role="cell">
              <span class="p-column-title" role="columnheader">Version(s)</span>
              <a href="javascript:void(0)" id="postActivityVersion"
                (click)="getPostActivityVersion($any(activityPaperWork.preApprovalRequestId), postActivityVersion.id, $any(activityPaperWork.isAdminType))">
                {{postActivityVersion.name }}
              </a>
            </td>
          }
        </tr>
      </ng-template>
    </p-table>
  }
</p-popover>
</div>
<div class="text-right print-hide-force">
  <dms-button identity="btn_index_cmp_gotonext_1" (clickEvent)="back()" icon="fa fa-arrow-left" title="Back" label="Back"></dms-button>
  <dms-button identity="btn_index_cmp_gotohome_1" (clickEvent)="cancel()" icon="fa fa-home" title="Cancel" label="Cancel"></dms-button>
</div>
</form>
@if (preApprovalFormGroup) {
  <div [formGroup]="preApprovalFormGroup">
    <p-dialog id="id_preaprval_reason_dialog" header="Reason for Cancellation" [contentStyle]="{'overflow':'visible'}" [closable]="false"
      [closeOnEscape]="false" [(visible)]="displayDialogue" [modal]="true" [style]="{ width: '50vw' }">
      @if (isCancelSelectType === false) {
        <dms-input-text-area identity="id_pre_aprv_comments" formControlName="reasonText"
          layout="flex" controlSize="medium" [rows]="5" [cols]="100" placeholder="Enter Reason"
          [showLegendLength]="true" [validationMessages]="invalidMessages['invalidReason']" label="Reason:">
        </dms-input-text-area>
      }
      @if (isCancelSelectType === true) {
        <div>
          @if (cancelReasons) {
            <dms-dropdown identity="id_preapproval_reason_drpdwn" [options]="cancelReasons" formControlName="reasonDropdown"
              placeholder="- Select -" layout="flex" controlSize="small" [validationMessages]="invalidMessages['reasonDropdown']" label="Reason:">
            </dms-dropdown>
          }
          @if (preApprovalFormGroup.get('reasonDropdown')?.hasError('failed')) {
            <span class="message-error-sm">
              {{preApprovalFormGroup.get('reasonDropdown')?.getError('failed')?.message }}
            </span>
          }
          <br>
            @if (isOther) {
              <dms-input-text-area identity="id_pre_aprv_comments" formControlName="otherReason"
                layout="flex" controlSize="medium" [rows]="5" [cols]="100" placeholder="Enter the reason"
                [showLegendLength]="true" [validationMessages]="invalidMessages['invalidReason']" label="Reason:">
              </dms-input-text-area>
            }
            @if (preApprovalFormGroup.get('otherReason')?.hasError('failed')) {
              <span class="message-error-sm">
                {{preApprovalFormGroup.get('otherReason')?.getError('failed')?.message }}
              </span>
            }
          </div>
        }
        <ng-template pTemplate="footer">
          <dms-button identity="btn_preaprv_save" (clickEvent)="cancelRequest()" icon="fa fa-floppy-o" title="Save Information" label="Submit"></dms-button>
          <dms-button identity="btn_preaprv_cancel" (clickEvent)="closeDialog()" icon="fa fa-home" title="Cancel" label="Cancel"></dms-button>
        </ng-template>
      </p-dialog>
    </div>
  }
