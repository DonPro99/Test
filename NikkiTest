using System;
using System.Collections.Generic;
using System.ComponentModel.DataAnnotations.Schema;
using System.Linq;
using Dms.Core.EntityFramework.Model.Apply;
using Dms.Core.EntityFramework.Model.Audit;
using Dms.Core.EntityFramework.Model.Lookup;
using Dms.Core.EntityFramework.Model.Security;
using Microsoft.Linq.Translations;
using CloaEntity = Dms.Core.EntityFramework.Model.Cloa;

namespace Dms.Core.EntityFramework.Model.Activity
{
    [Table("PreApprovalRequest", Schema = "dbo")]
    public class PreApprovalRequest : AuditLog
    {
        public int Id { get; set; }
        [ForeignKey("Application")]
        public int ApplicationId { get; set; }
        public virtual Application Application { get; set; }
        [ForeignKey("Cloa")]
        public int CloaId { get; set; }
        public virtual CloaEntity.Cloa Cloa { get; set; }
        public string TrackingNumber { get; set; }
        public DateTime? SubmittedDate { get; set; }
        public DateTime? ProposeStartDate { get; set; }
        public DateTime? ProposeEndDate { get; set; }
        [ForeignKey("TimeZone")]
        public int? TimeZoneId { get; set; }
        public virtual Lookup.TimeZone TimeZone { get; set; }
        [Column("TimeStamp")]
        public DateTime? ProposedStartTime { get; set; }
        [ForeignKey("PreApprovalRequestStatus")]
        public int? StatusId { get; set; }
        public virtual PreApprovalRequestStatus PreApprovalRequestStatus { get; set; }
        public bool? IsApproved { get; set; }
        public string ApproverComments { get; set; }
        public bool? IsPossibleDirectObservation { get; set; }
        [ForeignKey("ApproverOfficeRole")]
        public int? ApproverOfficeRoleId { get; set; }
        public virtual UserOfficeRole ApproverOfficeRole { get; set; }
        public virtual AfsPreApprovalRequest AfsPreApprovalRequest { get; set; }
        public virtual OtherPreApprovalRequest OtherPreApprovalRequest { get; set; }
        public virtual AovPreApprovalRequest AovPreApprovalRequest { get; set; }
        public virtual ICollection<PreApprovalRequestFunctionCode> PreApprovalRequestFunctionCodes { get; set; }
        public virtual ICollection<PreApprovalRequestExperimental> PreApprovalRequestExperimentals { get; set; }
        public virtual ICollection<PostActivity> PostActivities { get; set; }
        public virtual ICollection<PreApprovalRequestProduct> PreApprovalRequestProducts { get; set; }
        public string ApproverJustification { get; set; }
        public virtual ICollection<PreApprovalRequestCertificateRating> PreApprovalRequestCertificateRatings { get; set; }
        [Column("GeoMsApprove")]
        public bool? GeoMsIsApproved { get; set; }
        public string GeoMsJustification { get; set; }
        [Column("GeoExpansionApproverId")]
        [ForeignKey("GeoExpansionSelectedApprover")]
        public int? GeoExpansionSelectedApproverId { get; set; }
        public virtual UserOfficeRole GeoExpansionSelectedApprover { get; set; }
        [Column("GeoExpansionOfficeId")]
        [ForeignKey("GeoExpansionSelectedOffice")]
        public int? GeoExpansionSelectedOfficeId { get; set; }
        public virtual Office GeoExpansionSelectedOffice { get; set; }
        public bool? GeoExpansionDecision { get; set; }
        public bool? IsPreApprovalOnHold { get; set; }
        public string GeoExpansionJustification { get; set; }
        public string Comments { get; set; }
        [NotMapped]
        public PostActivity LatestPostActivity { get; set; }
        public static readonly CompiledExpression<PreApprovalRequest, PostActivity> latestPostActivityExpression =
           DefaultTranslationOf<PreApprovalRequest>.Property(p => p.LatestPostActivity).Is(it => it.PostActivities.OrderByDescending(p => p.Id).FirstOrDefault());
    }
}
