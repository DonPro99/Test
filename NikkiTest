< # ----- Batch mode: run all interventions for the LOB -----
< if [ "${INTERVENTION}" == "ALL" ]; then
<   batch_var="BATCH_INTERVENTIONS_${LOB}"
<   batch_list=$(eval echo "\$$batch_var")
< 
<   if [ -z "${batch_list}" ]; then
<     LOG_MESG "ERROR: ${batch_var} is not defined in ${DEPLOY_CONFIG_FILE}"
<     exit 1
<   fi
< 
<   IFS=',' read -r -a interventions <<< "${batch_list}"
< 
<   failed_list=""
<   success_list=""
< 
<   for i in "${interventions[@]}"; do
<     i=$(echo "$i" | tr -d ' ')
<     if [ -z "$i" ]; then
<       continue
<     fi
< 
<     run_one_intervention "$i"
<     rc=$?
< 
<     if [ $rc -ne 0 ]; then
<       failed_list="${failed_list}${i},"
<     else
<       success_list="${success_list}${i},"
<     fi
<   done
< 
<   LOG_MESG "==================== Batch Summary for LOB=${LOB} ===================="
<   LOG_MESG "Succeeded: ${success_list%,}"
<   if [ -n "${failed_list}" ]; then
