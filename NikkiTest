get isAutoPreApproval() {
    if (this.pr!.designeeInfo?.isAutoPreApproval) {
      return true;
    }
    if (this.pr!.testCheckInformation?.isOtherAdminActivity) {
      return true;
    }
    const selectedAuthorizations = this.pr!.testCheckInformation?.selectedRequestAuthorizations ?? [];
    const selectedFcs = selectedAuthorizations.map((item) => item.id);
    const requestedAuthorizations = this.pr!.testCheckInformation?.requestedAuthorizations ?? [];
    return (
      !this.pr!.activityLocation?.isOutsideOfficeDistrict &&
      super.canAutoApprove(selectedFcs, requestedAuthorizations)
    );
}

