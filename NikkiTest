git fetch origin
for br in $(git branch -r | grep -i "AM45700-202610-JDBC"); do
  echo "########## $br"
  for env in develop sit uat preprod master; do
    n=$(git rev-list --count origin/$env..$br)
    echo "  into $env: $n commit(s)"
    git log --format='     %h | %an | %ad | %s' --date=short origin/$env..$br | head -5
  done
done
