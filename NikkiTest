        public bool SaveRecordNote(DesigneeInfoViewModel model)
        {
            var officeId = _context.Applications.Where(a => a.Id == model.ApplicationId).Select(s => s.OfficeId).FirstOrDefault();
            var msId = _context.Applications
                            .Where(a => a.Id == model.ApplicationId)
                            .Select(a => a.Cloas.Any(c => c.CloaStatusId == (int)CloaStatusEnum.Active || c.CloaStatusId == (int)CloaStatusEnum.Terminated)
                                    ? a.Cloas
                                        .Where(c => c.CloaStatusId == (int)CloaStatusEnum.Active || c.CloaStatusId == (int)CloaStatusEnum.Terminated)
                                        .OrderByDescending(c => c.Id)
                                        .Select(c => c.ManagingSpecialistId)
                                        .FirstOrDefault()
                                    : a.Cloas
                                        .OrderByDescending(c => c.Id)
                                        .Select(c => c.ManagingSpecialistId)
                                        .FirstOrDefault())
                            .First();

            var userIdOfMs = _context.UserOfficeRoles.Where(w => w.Id == msId).Select(s => s.UserId).FirstOrDefault();
            var note = _context.RecordNotes.SingleOrDefault(r => r.ApplicationId == model.ApplicationId);

            var authenticationInformation = GetAuthenticationInformation();

            if (note != null)
            {
                var currentUserId = userIdOfMs;
                var isCurrentUserProxyMs = false;

                var msProxies = _context.UserOfficeRoles.Where(u => u.FormData != null &&
                                                                    u.IsProxyRequestApproved.Value &&
                                                                    u.IsActive &&
                                                                    JsonExtensions.JsonIntValue(u.FormData, "$.UserOfficeRoleId") == msId).ToList();
                if (msProxies.Count > 0)
                {
                    foreach (var msProxy in msProxies)
                    {
                        isCurrentUserProxyMs = msProxy.UserId == authenticationInformation.AuthenticatedUserId || msProxy.UserId == authenticationInformation.ImpersonatedUserId;

                        if (isCurrentUserProxyMs)
                        {
                            currentUserId = msProxy.UserId;
                        }
                    }
                }

                if (!string.IsNullOrEmpty(note.Notes))
                {
                    var existingNotesByOtherUsers = JsonConvert.DeserializeObject<IEnumerable<RecordNoteViewModel>>(note.Notes).Where(w => w.CreatedBy != currentUserId).ToList();
                    model.RecordNotes = model.RecordNotes.Union(existingNotesByOtherUsers).ToList();
                }
                note.Notes = JsonConvert.SerializeObject(model.RecordNotes);
            }
            else
            {
                _context.RecordNotes.Add(new RecordNote
                {
                    ApplicationId = model.ApplicationId,
                    Notes = JsonConvert.SerializeObject(model.RecordNotes),
                });
            }

            _context.SaveChanges();
            return true;
        }

        private AuthenticationModel GetAuthenticationInformation()
        {
            var claim = _claimsPrincipal != null && _claimsPrincipal.FindFirst("user") != null ? _claimsPrincipal.FindFirst("user").Value : null;
            var authenticationInformation = claim != null ? JsonConvert.DeserializeObject<AuthenticationModel>(claim) : new AuthenticationModel() { AuthenticatedUserId = 1 };

            return authenticationInformation;
        }

