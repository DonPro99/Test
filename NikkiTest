-- 1. Does the source have SSN values for batch 9?
SELECT COUNT(*) AS total_rows,
       COUNT(NULLIF(TRIM(a.MBR_SSNLST4), '')) AS rows_with_ssn
FROM U01_RAA.RAA_RAWZ.RAD_DEPLOY_ALL_LOB b
JOIN U01_RAA.RAA_RAWZ.RAD_MASTER_CHARTS_ALL_LOB a
  ON TRIM(a.recordid) = TRIM(b.recordid)
 AND TRIM(a.filedatetime) = TRIM(b.filedatetime)
 AND TRIM(a.chartid) = TRIM(b.add_val1)
 AND TRIM(a.chartdatetime) = TRIM(b.add_val2)
 AND TRIM(a.lob) = TRIM(b.lob)
WHERE TRIM(b.intervention) = 'DTVNTRT' AND TRIM(b.lob) = 'MCR' AND b.batch_id = '9';

-- 2. Did the table insert (token, not detokenized) get values?
SELECT COUNT(*) AS total_rows,
       COUNT(NULLIF(TRIM(MemberSSN), '')) AS rows_with_ssn
FROM U01_RAA.RAA_RAWZ.RAD_CIOXRT_ALL_LOB
WHERE EDL_RUN_ID = 'f2ca1aed45fae4694493b1ae4af95fb1';
