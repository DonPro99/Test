--        <stage>/datavantprov-retro-etl/<yyyyMMdd_HHmmss>/
--          ELV_DTVNT_<R>_MRA_<ONOFFSHORE>_<n>_<yyyyMMddHHmmss>.txt
--          ELV_DTVNT_<R>_MRA_<ONOFFSHORE>_<n>_<yyyyMMddHHmmss>_CPL_<n>.txt
--      where <R> = SUBSTR(add_val4, 1, 2) of the deploy data.
