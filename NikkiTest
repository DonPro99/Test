                                    IsPostActivityCompleted = true
                                }
                            }).AsEnumerable()
                            .Select(e =>
                            {
                                if (e.Activity.CreatedById == e.DesigneeUserId)
                                    e.Activity.CreatedOrModifiedBy = e.DesigneeNameWithCloa;
