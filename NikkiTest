        [SuppressMessage("Major Code Smell", "S3776:Cognitive Complexity of methods should not be too high", Justification = "This method intentionally centralizes modified-data detection and corrective-action trigger rules across AFS designee types.")]
        protected void CheckForPreApprovalModifiedData(PreApprovalRequestViewModel model)
        {
            var afsPostActivityModifiedPreApprovalViewModel = new AfsPostActivityModifiedPreApprovalViewModel();
            var preApprovalRequest = _context.PreApprovalRequests.Include(p => p.PreApprovalRequestFunctionCodes)
                                                                    .ThenInclude(it => it.Type)
                                                                    .Include(p => p.PreApprovalRequestFunctionCodes).ThenInclude(p => p.PreApprovalRequestFunctionCodeTypeRatings)
                                                                     .Include(p => p.AfsPreApprovalRequest)
                                                                     .Include(p => p.AfsPreApprovalRequest).ThenInclude(p => p.Address)
                                                                      .Include(p => p.AfsPreApprovalRequest).ThenInclude(p => p.AircraftOwnerAddress)
                                                                      .Include(p => p.AfsPreApprovalRequest).ThenInclude(p => p.AircraftOperatorAddress)
                                                                     .First(p => p.Id == model.Id);


            var triggerCorrectiveActionTrigger = false;
            switch (model.DesigneeInfo.TypeId)
            {
                case (int)DesigneeTypeEnum.DME:
                    triggerCorrectiveActionTrigger = DmePreApprovalRequestService.FindModifiedDataForDme(model, preApprovalRequest, afsPostActivityModifiedPreApprovalViewModel, triggerCorrectiveActionTrigger);
                    break;
                case (int)DesigneeTypeEnum.DPRE:
                    triggerCorrectiveActionTrigger = DprePreApprovalRequestService.FindModifiedDataForDpre(model, preApprovalRequest, afsPostActivityModifiedPreApprovalViewModel, triggerCorrectiveActionTrigger);
                    triggerCorrectiveActionTrigger = DprePreApprovalRequestService.FindModifiedDpreFunctionCodes(model, preApprovalRequest, afsPostActivityModifiedPreApprovalViewModel, triggerCorrectiveActionTrigger) || triggerCorrectiveActionTrigger;
                    break;
                case (int)DesigneeTypeEnum.DART:
                    triggerCorrectiveActionTrigger = DartPreApprovalRequestService.FindModifiedDataForDart(model, preApprovalRequest, afsPostActivityModifiedPreApprovalViewModel, triggerCorrectiveActionTrigger);
                    var changedMakeModelDart = FindAnyChangeInMakeOrModel(model, preApprovalRequest);
                    if (changedMakeModelDart)
                    {
                        triggerCorrectiveActionTrigger = triggerCorrectiveActionTrigger || changedMakeModelDart;
                    }
                    break;
                case (int)DesigneeTypeEnum.DPE:
                case (int)DesigneeTypeEnum.SAE:
                case (int)DesigneeTypeEnum.ADMINPE:
                    if ((model.CategoryId != null && model.CategoryId > 0) || model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.ADMINPE)
                    {
                        triggerCorrectiveActionTrigger = AdminPePreApprovalRequestService.FindModifiedDataForAdminPe(model, preApprovalRequest, afsPostActivityModifiedPreApprovalViewModel, triggerCorrectiveActionTrigger);
                        var changedMakeModelAdminPe = FindAnyChangeInMakeOrModel(model, preApprovalRequest);
                        if (changedMakeModelAdminPe) {
                            triggerCorrectiveActionTrigger = triggerCorrectiveActionTrigger || changedMakeModelAdminPe;
                        }

                    }
                    else if (model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.DPE)
                    {
                        triggerCorrectiveActionTrigger = DpePreApprovalRequestService.FindModifiedDataForDpe(model, preApprovalRequest, afsPostActivityModifiedPreApprovalViewModel, triggerCorrectiveActionTrigger);
                        var changedMakeModelDpe = FindAnyChangeInMakeOrModel(model, preApprovalRequest);
                        if (changedMakeModelDpe)
                        {
                            triggerCorrectiveActionTrigger = triggerCorrectiveActionTrigger || changedMakeModelDpe;
                        }
                    }
                    else
                    {
                        triggerCorrectiveActionTrigger = SaePreApprovalRequestService.FindModifiedDataForSae(model, preApprovalRequest, afsPostActivityModifiedPreApprovalViewModel, triggerCorrectiveActionTrigger);
                        var changedMakeModelSae = FindAnyChangeInMakeOrModel(model, preApprovalRequest);
                        if (changedMakeModelSae)
                        {
                            triggerCorrectiveActionTrigger = triggerCorrectiveActionTrigger || changedMakeModelSae;
                        }

                    }
                    triggerCorrectiveActionTrigger = FindModifiedFunctionCodes(model, preApprovalRequest, afsPostActivityModifiedPreApprovalViewModel, triggerCorrectiveActionTrigger);
                    break;
                default:
                    break;
            }

            //Corrective action triggering for Post activity actual start date is difffrent than pre approval test date
            if (model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.DME || model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.DPRE ||
                model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.DPE || model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.SAE || model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.ADMINPE)
            {
                var dateTriggerCorrectiveActionTrigger = false;
                var proposedStartDate = preApprovalRequest.ProposeStartDate.Value;
                var proposedEndDate = preApprovalRequest.ProposeEndDate.Value;
                //Group one
                if ((model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.DME || model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.DPRE)
                  && model.AfsPostActivity.AfsPostActivityDmeDpre != null
                  && !string.IsNullOrEmpty(model.AfsPostActivity.AfsPostActivityDmeDpre.ActualStartDate))
                {
                    var actualStartDate = DateTime.Parse(model.AfsPostActivity.AfsPostActivityDmeDpre.ActualStartDate);
                    var actualEndDate = DateTime.Parse(model.AfsPostActivity.AfsPostActivityDmeDpre.ActualEndDate);

                    dateTriggerCorrectiveActionTrigger = !((actualStartDate.Date >= proposedStartDate.Date && actualStartDate.Date <= proposedEndDate) &&
                                                           (actualEndDate.Date >= proposedStartDate.Date && actualEndDate.Date <= proposedEndDate.Date));

                }
                //Group two
                else if (model.AfsPostActivity.AfsPostActivityGroup2 != null && !string.IsNullOrEmpty(model.AfsPostActivity.AfsPostActivityGroup2.ActualStartDate))
                {
                    if (model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.ADMINPE || (model.CategoryId != null && model.CategoryId > 0))
                    {
                        var actualStartDate = DateTime.Parse(model.AfsPostActivity.AfsPostActivityGroup2.ActualStartDate);
                        dateTriggerCorrectiveActionTrigger = !(actualStartDate.Date >= proposedStartDate.Date && actualStartDate.Date <= proposedEndDate);
                    }
                    else if ((model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.DPE || model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.SAE) && (model.CategoryId == 0 || model.CategoryId == null)) //For Non Administrative SAE/DPE
                    {
                        var actualStartDate = DateTime.Parse(model.AfsPostActivity.AfsPostActivityGroup2.ActualStartDate);
                        var actualEndDate = DateTime.Parse(model.AfsPostActivity.AfsPostActivityGroup2.ActualEndDate);

                        dateTriggerCorrectiveActionTrigger = !((actualStartDate.Date >= proposedStartDate.Date && actualStartDate.Date <= proposedEndDate) &&
                                                               (actualEndDate.Date >= proposedStartDate.Date && actualEndDate.Date <= proposedEndDate.Date));
                    }
                }

                triggerCorrectiveActionTrigger = dateTriggerCorrectiveActionTrigger || triggerCorrectiveActionTrigger;
            }
            if (model.DesigneeInfo.TypeId != (int)DesigneeTypeEnum.DPE && model.DesigneeInfo.TypeId != (int)DesigneeTypeEnum.SAE && model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.ADMINPE)
            {
                UpdatePreapprovalData(model, preApprovalRequest);
            }
            if ((model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.DPE || model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.SAE || model.DesigneeInfo.TypeId == (int)DesigneeTypeEnum.ADMINPE)
                && (model.TestInformation.PracticalOralTestId != preApprovalRequest.AfsPreApprovalRequest.PracticalOralTestId && preApprovalRequest.AfsPreApprovalRequest.PracticalOralTestId == null))
            {
                preApprovalRequest.AfsPreApprovalRequest.PracticalOralTestId = model.TestInformation.PracticalOralTestId;
            }
            //Create activity with format and save
            HandleModifiedData(model, afsPostActivityModifiedPreApprovalViewModel, triggerCorrectiveActionTrigger);
        }

