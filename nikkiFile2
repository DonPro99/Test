      </po-dme-index>
    }
    @case (designeeTypeEnum.DPRE) {
      <po-dpre-index #active [data]="data" [isDisabled]="isDisabled"
        [isCancel]="isCancel" [isEditPostActivity]="isEditPostActivity" [isExternal]="true">
      </po-dpre-index>
    }
    @case (designeeTypeEnum.DPE) {
      <po-dpe-index #active [data]="data" [isDisabled]="isDisabled"
        [isCancel]="isCancel" [isEditPostActivity]="isEditPostActivity" [iacraDisplay]="true" [isExternal]="true">
      </po-dpe-index>
