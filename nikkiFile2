    @case (designeeTypeEnum.SAE) {
      <po-sae-index #active [data]="data" [isDisabled]="isDisabled"
        [isCancel]="isCancel" [isEditPostActivity]="isEditPostActivity" [iacraDisplay]="true" [isExternal]="true">
      </po-sae-index>
    }
    @case (designeeTypeEnum.ADMINPE) {
      <po-adminpe-index #active [data]="data" [isDisabled]="isDisabled" [isExternal]="true"
        [isCancel]="isCancel" [isEditPostActivity]="isEditPostActivity" [iacraDisplay]="true">
      </po-adminpe-index>
    }

    @case (designeeTypeEnum.ADMINPEGEN) {
      <po-adminpe-index #active [data]="data" [isDisabled]="isDisabled" [isExternal]="true"
        [isCancel]="isCancel" [isEditPostActivity]="isEditPostActivity" [iacraDisplay]="true">
      </po-adminpe-index>
    }
  }
}

@if (actionButtons.length > 0) {
