\dms\dms_ui\dms_web_designee\src\app\annualprofile\index.component.html
<menu-bar></menu-bar>
<pagetitle title="Annual Profile" iconClass="fa-calendar-check-o"></pagetitle>
<div id="annualProfileDiv">
  @if (profileFormGroup) {
    <form [formGroup]="profileFormGroup">
      <p-tabs #tabView (valueChange)="onTabChange($event)" [value]="currentTab">
        <p-tablist>
          <p-tab [value]="annualprofileTabEnum.questionsTab" [disabled]="!annualProfile?.enableQuestionsTab">
            <i class="fa fa-history"></i>
            <span>{{annualprofileTabEnum.questionsTab}}</span>
          </p-tab>
          <p-tab [value]="annualprofileTabEnum.profileTab" [disabled]="!annualProfile?.enableProfileTab">
            <i class="fa fa-location-arrow"></i>
            <span>{{annualprofileTabEnum.profileTab}}</span>
          </p-tab>
          <p-tab [value]="annualprofileTabEnum.backgroundQuestionsTab" [disabled]="!annualProfile?.enableBackgroundTab">
            <i class="fa fa-history"></i>
            <span>{{annualprofileTabEnum.backgroundQuestionsTab}}</span>
          </p-tab>
          <p-tab [value]="annualprofileTabEnum.uploadId" [disabled]="!annualProfile?.enableUploadTab">
            <i class="fa fa-book"></i>
            <span>{{annualprofileTabEnum.uploadId}}</span>
          </p-tab>
          <p-tab [value]="annualprofileTabEnum.summaryTab" [disabled]="!annualProfile?.enableSummaryTab">
            <i class="fa fa-sticky-note"></i>
            <span>{{annualprofileTabEnum.summaryTab}}</span>
          </p-tab>
          <p-tab [value]="annualprofileTabEnum.submitTab" [disabled]="!annualProfile?.enableSubmitTab">
            <i class="fa fa-save"></i>
            <span>{{annualprofileTabEnum.submitTab}}</span>
          </p-tab>
        </p-tablist>
        <p-tabpanel [value]="annualprofileTabEnum.questionsTab">
          @if (profileFormGroup.get('questionsTab')) {
            <dms-section [section]="questionSection" [form]="profileFormGroup.get('questionsTab')"></dms-section>
          }
          <p-dialog header="Medical Certificate Message" icon="fa fa-info-circle" [(visible)]="displayDialogue" [closable]="true" [closeOnEscape]="false" [modal]="false" style="max-width:2em">
            Your Medical Certificate Date on record is expired. Please enter your Medical Certificate Date of Expiration.
          </p-dialog>
        </p-tabpanel>
        <p-tabpanel [value]="annualprofileTabEnum.profileTab">
          <dms-user-profile #userProfileTab [profile]="annualProfile?.profile" [form]="profileFormGroup.get('profileTab')"
            [profilePhoto]="annualProfile?.profile?.profilePhoto" [hasProfileReferenceId]="hasProfileReferenceId" [showSecurityQuestion]="false"
          [designeeTypeId]="annualProfile?.designeeInformation?.typeId!"></dms-user-profile>
        </p-tabpanel>
        <p-tabpanel [value]="annualprofileTabEnum.backgroundQuestionsTab">
          @if (profileFormGroup?.get('backgroundQuestionsTab')) {
            <dms-section [section]="backgroundSection" [form]="profileFormGroup?.get('backgroundQuestionsTab')">
            </dms-section>
          }
        </p-tabpanel>
        <p-tabpanel [value]="annualprofileTabEnum.uploadId">
          @if (designeeTypeId === designeeTypeEnum.DPE) {
            <div>
              <p>The Code of Conduct form must be downloaded, thoroughly reviewed, signed, and uploaded in the attachments section.</p>
              <p><a class="document" href="{{url}}{{getDocumentId(documentTemplateTypeEnum.CodeOfConductDPE)}}"
                title="Code of Conduct – DPE"  s3download target="_blank" rel="noopener noreferrer">Code of Conduct –
              DPE</a></p>
            </div>
          }
          @if (designeeTypeId === designeeTypeEnum.SAE) {
            <div>
              <p>The Code of Conduct form must be downloaded, thoroughly reviewed, signed, and uploaded in the attachments section.</p>
              <p><a class="document" href="{{url}}{{getDocumentId(documentTemplateTypeEnum.CodeOfConductSAE)}}"
                title="Code of Conduct – SAE"  s3download target="_blank" rel="noopener noreferrer">Code of Conduct –
              SAE</a></p>
            </div>
          }
          @if (designeeTypeId === designeeTypeEnum.ADMINPE) {
            <div>
              <p>The Code of Conduct form must be downloaded, thoroughly reviewed, signed, and uploaded in the attachments section.</p>
              <p><a class="document" href="{{url}}{{getDocumentId(documentTemplateTypeEnum.CodeOfConductADMINPE)}}"
                title="Code of Conduct – ADMINPE"  s3download target="_blank" rel="noopener noreferrer">Code of Conduct –
              ADMINPE</a></p>
            </div>
          }
             @if (designeeTypeId === designeeTypeEnum.ADMINPEGEN) {
            <div>
              <p>The Code of Conduct form must be downloaded, thoroughly reviewed, signed, and uploaded in the attachments section.</p>
              <p><a class="document" href="{{url}}{{getDocumentId(documentTemplateTypeEnum.CodeOfConductADMINPE)}}"
                title="Code of Conduct – ADMINPE"  s3download target="_blank" rel="noopener noreferrer">Code of Conduct –
              Admin-PE-GEN</a></p>
            </div>
          }
          <dms-uploadcontrol #uploadControl id="annual_upload" [uploadFormGroup]="profileFormGroup" formControlName="uploadId"
            [documentReference]="annualProfile?.documentReference" (getChosenFiles)="getChosenFiles($event)">
          </dms-uploadcontrol>
        </p-tabpanel>
        <p-tabpanel [value]="annualprofileTabEnum.summaryTab">
          @if (currentTab == annualprofileTabEnum.summaryTab) {
            <app-annual-request-summary [summaryForm]="summaryForm" [annualProfile]="annualProfile!"></app-annual-request-summary>
          }
        </p-tabpanel>
        <p-tabpanel [value]="annualprofileTabEnum.submitTab">
          @if (annualProfile?.signature) {
            <dms-signature #signature [signature]="annualProfile?.signature!"
              [isGroup2]="isGroup2"
            [form]="profileFormGroup?.get('submitTab')"></dms-signature>
          }
        </p-tabpanel>
      </p-tabs>
      @if (actionButtons.length > 0) {
        <actionbutton [buttons]="actionButtons" [displayBusy]="false" (actionButtonClickEvent)="actionButtonClick($event)"></actionbutton>
      }
    </form>
  }
</div>

