-- COMMENT: DO NOT CHANGE THESE VARIABLES - MANAGED BY PYTHON TEMPLATE ENGINE
-- ============================================================================
DECLARE
    -- Core process identifiers (from GENAISA_MASTER_CONFIG via Jinja2)
    process_id VARCHAR := '{{ PROCESS_ID }}';
    step_id VARCHAR := '{{ STEP_ID }}';
    step_id_mbr VARCHAR := '{{ STEP_ID_MBR }}';
    edl_run_id VARCHAR := '{{ EDL_RUN_ID }}';
    lob VARCHAR := '{{ LOB }}';
    
    -- S3/Stage configuration
    snowflake_stage VARCHAR := '{{ snow_flake_stage }}';
    
    -- Timestamp parameters for S3 export (generated by Python)
    timestamp_folder VARCHAR := '{{ TIMESTAMP_FOLDER }}';  -- Format: YYYYMMDD_HHMMSS
    timestamp_date VARCHAR := '{{ TIMESTAMP_DATE }}';      -- Format: YYYYMMDD
    
    -- Runtime variables for batch tracking
    batch_id INTEGER;
    batch_id_2 INTEGER;
    
    -- Add your custom variables here
    -- Example: custom_var VARCHAR;
    
BEGIN
    -- ========================================================================
    -- SECTION 2: BATCH ID INITIALIZATION
    -- ========================================================================
    
    -- Get previous batch_id for current step (default to 1 if no previous run)
    SELECT COALESCE(batchid, 1) INTO batch_id
    FROM {{ LOAD_LOG_KEY_TABLE }}
    WHERE processid = :process_id
      AND stepid = :step_id
      AND UPPER(status) = 'COMPLETED' 
    ORDER BY CREATEDATETIME DESC 
    LIMIT 1;
    
    -- Set default if no record found
    IF (batch_id IS NULL) THEN
        batch_id := 1;
    END IF;

    -- Get and increment batch_id for secondary step if needed
    SELECT COALESCE(batchid + 1, 1) INTO batch_id_2
    FROM {{ LOAD_LOG_KEY_TABLE }}
    WHERE processid = :process_id
      AND stepid = :step_id_mbr
      AND UPPER(status) = 'COMPLETED' 
    ORDER BY CREATEDATETIME DESC 
    LIMIT 1;
    
    -- Set default if no record found
    IF (batch_id_2 IS NULL) THEN
        batch_id_2 := 1;
    END IF;

    -- ========================================================================
    -- SECTION 3: TRANSACTION BEGIN
    -- ========================================================================
    BEGIN TRANSACTION;

    -- ========================================================================
    -- SECTION 4: SOURCE DATA EXTRACTION
    -- ========================================================================
    
    -- Step 1: Create source temp table
    -- NOTE: Use Jinja2 template parameters for table names: {{ sourceTable }}
    CREATE OR REPLACE TEMPORARY TABLE temp_db.temp_schema.source_data AS
    SELECT * 
    FROM {{ sourceTable }}
    WHERE LOB = :lob
      AND BATCH_ID = :batch_id;
    
    -- Step 2: Create additional source tables as needed
    -- CREATE OR REPLACE TEMPORARY TABLE temp_db.temp_schema.lookup_data AS
    -- SELECT * FROM {{ lookupTable }} WHERE ...;

    -- ========================================================================
    -- SECTION 5: DATA TRANSFORMATION
    -- ========================================================================
    
    -- Step 3: Apply business logic and transformations
    CREATE OR REPLACE TEMPORARY TABLE temp_db.temp_schema.transformed_data AS
    SELECT 
        -- Add your column transformations here
        CURRENT_TIMESTAMP() AS EDL_LOAD_DTM,
        :edl_run_id AS EDL_RUN_ID,
        :lob AS EDL_LOB_CD,
        -- ... other columns
        column1,
        column2
    FROM temp_db.temp_schema.source_data
    WHERE 1=1;  -- Add your filter conditions
    
    -- Step 4: Apply additional transformations (detokenization, formatting, etc.)
    -- UPDATE temp_db.temp_schema.transformed_data
    -- SET column1 = FUNCTION(column1);

    -- ========================================================================
    -- SECTION 6: DATA VALIDATION
    -- ========================================================================
    
    -- Step 5: Create validation counts table for Python to query
    CREATE OR REPLACE TEMPORARY TABLE temp_db.temp_schema.validation_counts AS
    SELECT 
        (SELECT COUNT(*) FROM temp_db.temp_schema.transformed_data) AS row_count,
        (SELECT COUNT(*) FROM {{ stageTable }}) AS stage_count,
        (SELECT COUNT(*) FROM {{ targetTable }} WHERE EDL_RUN_ID = :edl_run_id) AS duplicate_count;
    
    -- NOTE: Validation logic is handled in Python layer
    -- Python will query validation_counts table and raise errors if:
    --   - row_count > stage_count (data integrity issue)
    --   - duplicate_count > 0 (idempotency check)
    --   - row_count = 0 (no data to process)

    -- ========================================================================
    -- SECTION 7: DATA PERSISTENCE
    -- ========================================================================
    
    -- Step 6: Insert into target table
    INSERT INTO {{ targetTable }}
    SELECT DISTINCT
        CURRENT_TIMESTAMP() AS EDL_LOAD_DTM,
        :edl_run_id AS EDL_RUN_ID,
        'NA' AS EDL_SCRTY_LVL_CD,
        :lob AS EDL_LOB_CD,
        'NA' AS EDL_EXTRNL_LOAD_CD,
        '[SOURCE_SYSTEM_CODE]' AS EDL_SOR_CD,
        CURRENT_TIMESTAMP() AS KF_TMS,
        CURRENT_TIMESTAMP() AS EDL_CREAT_DTM,
        CURRENT_TIMESTAMP() AS EDL_INCRMNTL_LOAD_DTM,
        -- Add your business columns here
        column1,
        column2,
        :lob AS LOB,
        CURRENT_DATE() AS INSERT_DT,
        :batch_id AS BATCH_ID
    FROM temp_db.temp_schema.transformed_data;

    -- ========================================================================
    -- SECTION 8: S3 EXPORT (OPTIONAL)
    -- ========================================================================
    
    -- Step 7: Export to S3 if required
    -- NOTE: Uses timestamp parameters generated by Python for unique folder/filename
    -- COPY INTO '@{{ snow_flake_stage }}/[output-folder]/{{ TIMESTAMP_FOLDER }}/[filename_prefix]_{{ TIMESTAMP_DATE }}.txt'
    -- FROM (SELECT * FROM temp_db.temp_schema.transformed_data)
    -- FILE_FORMAT = (
    --     TYPE = CSV 
    --     FIELD_DELIMITER = '|' 
    --     COMPRESSION = 'NONE' 
    --     FILE_EXTENSION = 'txt' 
    --     EMPTY_FIELD_AS_NULL = false 
    --     NULL_IF = ''
    -- )
    -- HEADER = TRUE
    -- SINGLE = TRUE
    -- MAX_FILE_SIZE = 524288000
    -- OVERWRITE = TRUE;

    -- ========================================================================
    -- SECTION 9: TRANSACTION COMMIT
    -- ========================================================================
    
    -- Commit all changes
    COMMIT;

END;
$$;

